/// Calendar color label (Valant "appointment labels"; 20261018_appointment_labels).
/// Appointment."labelId" points here but is read/written with raw SQL (not in the Appointment model),
/// like location_id. Created only by an admin (Load Valant labels / add label), never auto-seeded.
model AppointmentLabel {
  id             String   @id @default(cuid())
  organizationId String
  /// Valant "Name" (Blue, Brown, ...) or a practice-defined name; unique per org
  name           String
  /// Valant "Display Name" e.g. "Blue (Tele)"
  displayName    String
  /// #RRGGBB; text color is picked by contrast (src/lib/scheduling/appointmentLabels.ts)
  color          String   @db.VarChar(7)
  /// free | busy | tentative: whether the label marks the provider's time; does not change the appointment itself
  availability   String   @default("free")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  /// valant | altrixs
  source         String   @default("altrixs")
  /// tele | rescheduled | reeval | cancelled | in_person | issue | new | not_confirmed | testing
  meaning        String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active, sortOrder])
}

