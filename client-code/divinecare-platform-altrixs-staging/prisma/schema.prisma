/// Per-client chart history digest (AI-generated from chart documents and signed notes; every fact
/// cites a source and a quote checked against the source text). Feeds the pre-visit brief.
/// Psychotherapy notes never; 42 CFR Part 2 sources only with a treatment / TPO Part 2 consent.
/// src/lib/ai/chartDigest/**. prisma/migrations/20261026_chart_history_digest.sql
model ClientChartDigest {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String
  version        Int      @default(1)
  /// ready | failed | partial
  status         String   @default("ready")
  digestJson     Json     @default("{}")
  /// "doc:<id>" / "note:<id>" keys of the sources used
  sourceDocIds   String[] @default([])
  /// sha256 of the source keys + versions + Part 2 inclusion + prompt version (stale when it changes)
  sourceHash     String
  model          String?
  promptVersion  String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costEstimateUsd Float   @default(0)
  generatedById  String?
  generatedAt    DateTime @default(now())
  /// error codes / counts only (never chart text)
  errors         Json     @default("[]")
  /// bh | medical (20261026_primary_care_digest): versions and staleness are per kind
  kind           String   @default("bh")

  @@unique([organizationId, clientId, kind, version])
  @@index([organizationId, clientId, generatedAt])
  @@index([organizationId, clientId, kind, generatedAt])
}

/// Click-through Business Associate Agreement acceptance (src/lib/legal/baa.ts text + version,
/// src/lib/legal/baaAcceptance.ts). One row per acceptance; never updated. textSha256 proves the
/// exact text accepted. source: registration | admin. prisma/migrations/20261026_baa_acceptance.sql
model BaaAcceptance {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  signerName     String
  signerTitle    String
  signerEmail    String
  baaVersion     String
  textSha256     String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  source         String   @default("registration")

  @@index([organizationId, acceptedAt])
  @@index([organizationId, baaVersion])
}

/// Unified, append-only integration call log (Admin > Integrations > Logs). Metadata only: no
/// request / response bodies (DrFirst bodies stay encrypted in drfirst_api_logs, referenced by
/// source_table / source_id). Written by src/lib/integrations/callLog/record.ts; metadata kept
/// 1 year (scripts/integration-logs-purge.ts).
model IntegrationCallLog {
  id             String    @id @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime  @map("finished_at") @db.Timestamptz(6)
  organizationId String?   @map("organization_id")
  /// drfirst | waystar | availity | sms | email | stripe | homebase | bedrock | textract | transcribe | chime | healthlake | cron
  integration    String    @db.VarChar(32)
  operation      String    @db.VarChar(80)
  /// outbound | inbound | webhook | job
  direction      String    @db.VarChar(16)
  /// success | error | throttled | skipped
  status         String    @db.VarChar(16)
  httpStatus     Int?      @map("http_status")
  vendorStatus   String?   @map("vendor_status") @db.VarChar(80)
  errorCode      String?   @map("error_code") @db.VarChar(80)
  /// Sanitized (secrets, emails, phone numbers removed)
  errorMessage   String?   @map("error_message")
  durationMs     Int?      @map("duration_ms")
  correlationId  String?   @map("correlation_id") @db.VarChar(120)
  actorUserId    String?   @map("actor_user_id")
  clientId       String?   @map("client_id")
  sourceTable    String?   @map("source_table") @db.VarChar(64)
  sourceId       String?   @map("source_id") @db.VarChar(120)
  /// Counts, ids, template ids, model ids, file names only (never bodies, prompts or outputs)
  metadata       Json?

  @@index([createdAt])
  @@index([integration, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([clientId])
  @@index([sourceTable, sourceId])
  @@map("integration_call_logs")
}

// ─── Planned billing codes at booking (migration 20261027_appointment_planned_codes.sql) ───
// src/lib/appointments/plannedCodes*.ts. Plain appointmentId (FK in SQL, no Prisma relation) so the
// Appointment model is unchanged. PLANNED only: they prefill the progress note; the signed note's
// codes bill. Claim building never reads these tables.
/// One planned line: sequence 0 = primary, 1-3 = add-ons. chargeCents null = no fee set.
model AppointmentPlannedCode {
  id             String   @id @default(cuid())
  organizationId String
  appointmentId  String
  sequence       Int
  code           String   @db.VarChar(12)
  units          Int      @default(1)
  modifiers      String[] @default([])
  chargeCents    Int?
  /// Billing roles only: why the charge differs from the fee schedule
  overrideReason String?
  isAddOn        Boolean  @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([appointmentId, sequence])
  @@index([organizationId, appointmentId])
  @@map("appointment_planned_codes")
}

/// Appointment-level billing plan: POS override (null = automatic), supervising provider, courtesy discount.
model AppointmentBillingPlan {
  appointmentId         String   @id
  organizationId        String
  placeOfService        String?  @db.VarChar(2)
  supervisingProviderId String?
  discountCents         Int?
  discountNote          String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId])
  @@map("appointment_billing_plans")
}
