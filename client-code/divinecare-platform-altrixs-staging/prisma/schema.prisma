  /// Crisis / community contact, as published by the source ("988", "1-800-662-4357")
  contactPhone        String?
  /// e.g. "Text HOME to 741741"
  contactText         String?
  /// Practice upload (private storage, audited download route only)
  fileStoredName      String?
  fileName            String?
  fileMime            String?
  fileSize            Int?
  topics              String[]  @default([])
  /// adult | teen | child | caregiver
  audiences           String[]  @default([])
  language            String    @default("en")
  readingLevel        String?
  publisher           String?
  licenseNote         String?
  /// Last time the link / phone was checked against the publisher's page
  linkCheckedAt       DateTime?
  /// Clinical review by the practice
  lastReviewedAt      DateTime?
  reviewedById        String?
  reviewerName        String?
  /// draft | active | retired
  status              String    @default("draft")
  /// Staff resources: policy | form | training | other
  staffCategory       String?
  /// Staff resources: roles that may see it (empty = all staff)
