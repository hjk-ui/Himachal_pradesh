  priority       String         @default("Routine")
  specimen       String?
  icd10Codes     String[]
  panels         String[]
  otherPanel     String?
  clinicalNotes  String?
  status         LabOrderStatus @default(ordered)
  orderedById    String?
  orderedByName  String?
  orderedAt      DateTime       @default(now())
  collectedAt    DateTime?
  resultedAt     DateTime?

  // Electronic Signature Audit Trail (Commit 819d6b2)
  isElectronicallySigned Boolean   @default(true)
  signedAt               DateTime? @default(now())
  signerName             String?
  signerNpi              String?
  facilityName           String?   @default("Divine Counseling LLC")
  facilityClia           String?   @default("21D2098412")
  signatureHash          String?

  // Ordering workflow (20261018_lab_catalog)
  /// Per-test lines: [{ key, name, icd10Codes[], loinc, cpt, fastingRequired, orderType }]
  testLines        Json?
  fastingRequired  Boolean   @default(false)
  /// in_office | patient_service_center
  collectionSite   String?
  /// insurance | patient | client (practice account)
  billTo           String?
  /// Medicare ABN given (manual; no automated LCD check)
  abnRequired      Boolean   @default(false)
  abnNote          String?
  standingOrderId  String?
  sentAt           DateTime?
  /// Lab that actually performed the tests, when it differs from `lab` or is outside
  performingLabName String?
  /// Filed DocumentIntake id of the scanned result report
  resultDocumentId String?
  hasCritical      Boolean   @default(false)
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedByName   String?
  reviewNote       String?
  /// Closed loop (20261022_primary_care_workflow.sql): patient told of the result by phone /
  /// letter / in person / portal message. Portal release (releasedAt) also counts as notified.
  patientNotifiedAt     DateTime?
  patientNotifiedMethod String?
  patientNotifiedById   String?
  patientNotifiedByName String?
  releasedAt       DateTime?
  releasedById     String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  results        LabResult[]

  @@index([organizationId, status, orderedAt])
  @@index([clientId])
  @@index([organizationId, orderedById, reviewedAt])
}

