/// Client active & historical medications (psychiatric + somatic)
model ClientMedication {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  medicationName  String
  dosage          String
  route           String?
  frequency       String?
  instructions    String?
  indication      String?
  startDate       DateTime  @default(now())
  endDate         DateTime?
  active          Boolean   @default(true)
  isAntipsychotic Boolean   @default(false)
  prescribedById  String?
  prescribedBy    User?     @relation("ClientMedicationPrescriber", fields: [prescribedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  externalMedId   String?
  rcopiaMedId     String?
  drugName        String?
  brandName       String?
  genericName     String?
  ndcCode         String?
  rxnormId        String?
  dosageText      String?
  action          String?
  dose            String?
  doseUnit        String?
  quantity        String?
  refills         String?
  asNeeded        Boolean   @default(false)
  prnReason       String?
  schedule        String?   @default("nonscheduled")
  source          String    @default("prescribed")
  status          String    @default("active")
  stopDate        DateTime?
  stopReason      String?
  prescriberName  String?

  // Drug codification (DrFirst MUM2-MUM4 / MUR1): RxNorm via NLM RxNav, chosen at entry or by
  // scripts/codify-meds-allergies.ts. null rxnormId = not coded (sent to DrFirst as free text).
  rxnormTty       String?
  rxnormName      String?
  doseForm        String?
  strength        String?
  ndcCodes        String[]  @default([])
  drugCodedAt     DateTime?
  drugCodeVersion String?

  @@index([clientId, active])
  @@index([clientId, rxnormId])
}

/// Dedicated Medical Primary Care Patient record
model MedicalPatient {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mrn                 String       @unique
  name                String
  firstName           String?
  lastName            String?
  dateOfBirth         DateTime
  dob                 DateTime?
  gender              String
  phone               String?
  email               String?
  address             String?
  emergencyContact    String?
  primaryPayer        String?
  primaryInsurance    String?
  secondaryPayer      String?
  assignedPcp         String       @default("")
  hba1cOverdue        Boolean      @default(false)
  egfrDeclining       Boolean      @default(false)
  nextAppointmentDate DateTime?
  bhClientId          String?
  crossReferencedBhId String?
  hasPart2Consent     Boolean      @default(false)
  consent42CfrPart2   Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId, mrn])
}

/// Somatic medical problem list (ICD-10 diagnoses)
model MedicalProblem {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patientId    String?
  /// null = needs coding (intake history entered as text); never guessed
  icd10Code    String?
  name         String
  description  String?
  category     String?
  status       String    @default("Active")
  isChronic    Boolean   @default(false)
  onsetDate    DateTime?
  resolvedDate DateTime?
  notes        String?
  /// null = recorded in Altrixs; 'drfirst' = downloaded from Rcopia (update_problem)
  source          String?
  /// Rcopia problem id (rows downloaded from DrFirst)
  rcopiaProblemId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId, status])
  @@index([patientId])
  @@index([clientId, rcopiaProblemId])
}

/// Somatic allergies & adverse reactions
model MedicalAllergy {
  id          String   @id @default(cuid())
  /// Medical patient id; null for rows downloaded from DrFirst for a client with no medical chart
  patientId   String?
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  allergen    String
  reaction    String?
  severity    String   @default("Moderate")
  status      String   @default("Active")
  /// null = recorded in Altrixs; 'drfirst' = downloaded from Rcopia (update_allergy)
  source          String?
  /// Rcopia allergy id (downloaded rows, and local rows Rcopia echoed back by external id)
  rcopiaAllergyId String?
  /// 'drug' | 'food' | 'environmental'; null = not classified yet (older rows). Only drug allergies need a code (AUM2).
  allergenType    String?
  /// Drug code (AUM2 / AUM3 / AUR1): RxNorm via NLM RxNav. null = not coded (sent to DrFirst as free text).
  rxnormId        String?
  rxnormTty       String?
  rxnormName      String?
  genericName     String?
  brandName       String?
  doseForm        String?
  strength        String?
  ndcCodes        String[]  @default([])
  drugCodedAt     DateTime?
  drugCodeVersion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@index([clientId])
  @@index([clientId, rcopiaAllergyId])
  @@index([clientId, rxnormId])
}

/// Somatic vital signs records
model MedicalVital {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patientId       String?
  systolic        Int?
  bpSystolic      Int?
  diastolic       Int?
  bpDiastolic     Int?
  heartRate       Int?
  respiratoryRate Int?
  respRate        Int?
  temperature     Float?
  spO2            Int?
  o2Sat           Int?
  weightLbs       Float?
  heightInches    Float?
  bmi             Float?
  recordedAt      DateTime @default(now())
  recordedById    String?
  recordedBy      User?    @relation("MedicalVitalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([clientId, recordedAt])
  @@index([patientId])
}

/// Somatic clinical encounters & SOAP notes
model MedicalVisit {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  providerId     String?
  provider       User?     @relation("MedicalVisitProvider", fields: [providerId], references: [id], onDelete: SetNull)
  providerName   String?
  visitDate      DateTime  @default(now())
  visitType      String
  chiefComplaint String?
  subjective     String?   @db.Text
  objective      String?   @db.Text
  assessment     String?   @db.Text
  plan           String?   @db.Text
  cptCode        String?
  cptModifiers   String[]  @default([])
  icd10Codes     String[]  @default([])
  signedAt       DateTime?
  status         String    @default("COMPLETED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId, visitDate])
  @@index([providerId, clientId])
  @@index([visitDate])
}

// ─── Primary care workflow (migration 20261022_primary_care_workflow.sql) ───────────────────
// Rules: src/lib/medical/primaryCareWorkflow.ts. Plain id columns; FKs live in SQL.

/// MA rooming for one primary care appointment: identity check, chief complaint, vitals (with the
/// BP recheck), allergy / medication / pharmacy review, screenings, point-of-care tests, then
/// "Ready for provider". The provider marks "In room" when the visit starts.
model MedicalRooming {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  appointmentId     String    @unique @map("appointment_id")
  clientId          String    @map("client_id")
  /// draft | ready | in_room
  status            String    @default("draft") @db.VarChar(20)
  identityConfirmed Boolean   @default(false) @map("identity_confirmed")
  /// Two identifiers confirmed, e.g. ["name", "dob"]
  identifiers       String[]  @default([])
  chiefComplaint    String?   @map("chief_complaint")
  /// RoomingVitals: systolic, diastolic, heartRate, respRate, temperatureF, spO2, heightIn, weightLbs, pain, takenAt, recheck
  vitals            Json?
  /// Reviews / screenings / POC results / patient-reported items (see roomingDb.ts)
  checks            Json?
  /// MedicalVital rows written at "Ready" (first set, BP recheck)
  vitalIds          String[]  @default([]) @map("vital_ids")
  roomedById        String?   @map("roomed_by_id")
  roomedByName      String?   @map("roomed_by_name")
  /// Ready for provider time
  roomedAt          DateTime? @map("roomed_at")
  inRoomAt          DateTime? @map("in_room_at")
  inRoomById        String?   @map("in_room_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([clientId])
  @@map("medical_roomings")
}

/// Care gap actions (append-only). Provider: completed | ordered | done_elsewhere | refused |
/// not_applicable | reopened. Medical Assistant: reported_elsewhere (patient-reported, never closes
/// a gap) | outreach (phone / portal / letter).
model MedicalCareGapAction {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  clientId        String    @map("client_id")
  gapKey          String    @map("gap_key") @db.VarChar(40)
  action          String    @db.VarChar(30)
  performedOn     DateTime? @map("performed_on") @db.Date
  /// Test type / modality (colonoscopy, fit, cytology, ...)
  kind            String?   @db.VarChar(40)
  source          String?
  reason          String?
  /// outreach: phone | portal | letter
  method          String?   @db.VarChar(20)
  appointmentId   String?   @map("appointment_id")
  patientReported Boolean   @default(false) @map("patient_reported")
  recordedById    String    @map("recorded_by_id")
  recordedByName  String?   @map("recorded_by_name")
  recordedByRole  String?   @map("recorded_by_role") @db.VarChar(40)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([organizationId, clientId, gapKey])
  @@index([appointmentId])
  @@map("medical_care_gap_actions")
}

/// Referral / imaging order tracking (closed loop) and the internal warm handoff to the practice
/// behavioral health team (kind internal_bh: status only, no BH content comes back).
model MedicalReferral {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  clientId         String    @map("client_id")
  /// specialist | imaging | internal_bh
  kind             String    @db.VarChar(20)
  /// Specialty, imaging study, or "Behavioral health team"
  target           String
  facility         String?
  reason           String
  /// routine | urgent | stat
  urgency          String    @default("routine") @db.VarChar(10)
  cpt              String?   @db.VarChar(10)
  icd10Codes       String[]  @default([]) @map("icd10_codes")
  /// sent | scheduled | seen | report_received | cancelled
  status           String    @default("sent") @db.VarChar(20)
  statusNote       String?   @map("status_note")
  scheduledFor     DateTime? @map("scheduled_for") @db.Date
  seenAt           DateTime? @map("seen_at") @db.Date
  reportReceivedAt DateTime? @map("report_received_at")
  appointmentId    String?   @map("appointment_id")
  orderedById      String    @map("ordered_by_id")
  orderedByName    String?   @map("ordered_by_name")
  updatedById      String?   @map("updated_by_id")
  sentAt           DateTime  @default(now()) @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, kind, status])
  @@index([clientId])
  @@map("medical_referrals")
}

/// Tasks a primary care provider routes to the Medical Assistants (or one MA).
model MedicalTask {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  clientId       String?   @map("client_id")
  title          String
  detail         String?
  /// null = any Medical Assistant who can open the patient (care team)
  assignedToId   String?   @map("assigned_to_id")
  dueOn          DateTime? @map("due_on") @db.Date
  /// open | done | cancelled
  status         String    @default("open") @db.VarChar(20)
  createdById    String    @map("created_by_id")
  createdByName  String?   @map("created_by_name")
  completedById  String?   @map("completed_by_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([clientId])
  @@map("medical_tasks")
}

/// Primary care practice settings (one row per org; missing row = defaults).
model PrimaryCareSettings {
  organizationId    String   @id @map("organization_id")
  /// Practice policy: notify the patient of results within N days (default 7)
  resultsNotifyDays Int      @default(7) @map("results_notify_days")
  /// Point-of-care tests the MA may perform under a signed standing order. Default EMPTY.
  pocStandingOrders Json     @default("[]") @map("poc_standing_orders")
  /// Care gap keys turned off for this practice (default: none, all shown)
  careGapsDisabled  String[] @default([]) @map("care_gaps_disabled")
  updatedById       String?  @map("updated_by_id")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("primary_care_settings")
}

/// Medical fee-for-service charges & claim worklist
model MedicalCharge {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patientId      String?
  dos            DateTime     @default(now())
  cptCode        String
  modifier       String?
  units          Int          @default(1)
  amountCents    Int
  chargedAmount  Float?
  primaryIcd     String
  secondaryIcd   String?
  providerName   String
  payerId        String?
  payerName      String?
  status         String       @default("Ready")
  denialCode     String?
  denialReason   String?
  submittedAt    DateTime?
  paidAt         DateTime?
  claimId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, dos])
  @@index([clientId])
  @@index([patientId])
}

/// Multi-disciplinary Behavioral Health Treatment Team Member
model ClientTreatmentTeamMember {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  providerId  String?
  name        String
  role        String
  credentials String?
  isPrimary   Boolean  @default(false)
  avatarColor String?  @default("#5C2D91")
  initials    String?
  assignedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([providerId])
  @@index([providerId, clientId])
}


/// Insurance Payer Registry & Clearinghouse Configuration
/// Billing payer master (Billing › Payers, src/lib/billing/payerMaster.ts). Every value is staff
/// entered or picked from the Valant import (a suggestion); nothing is defaulted from a guess.
/// Waystar claim rules live in WaystarPayerMapping (linked by name / alias / payer ID).
model PayerRegistry {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Waystar payer ID; null until staff confirm it on Waystar's payer list (migration 20261027_payer_master.sql)
  payerId             String?
  name                String
  clearinghouse       String       @default("Waystar")
  /// Legacy one-line claims address; kept in sync with the structured fields below
  claimsAddress       String?
  /// medicare | medicaid | medicare_advantage | commercial | mco_bh | self_pay | other
  payerType           String?
  claimsAddressLine1  String?
  claimsAddressLine2  String?
  claimsCity          String?
  claimsState         String?
  claimsZip           String?
  phone               String?
  fax                 String?
  portalUrl           String?
  /// Days from DOS; null = not entered (verify against the payer contract)
  timelyFilingDays    Int?
  /// unknown | not_started | submitted | enrolled | not_applicable (legacy rows may hold "Active")
  eraEnrollmentStatus String       @default("unknown")
  eftEnrollmentStatus String       @default("unknown")
  notes               String?
  updatedById         String?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, payerId])
  @@index([organizationId, active])
}

/// Billing rules engine for modifiers and supervisor NPI
model BillingRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  ruleType       String
  priority       Int          @default(1)
  active         Boolean      @default(true)
  configJson     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, priority])
}

/// Agile Project Tracker Kanban Tasks
model ProjectTask {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  title          String
  description    String           @db.Text
  status         String           @default("To Do")
  priority       String           @default("Medium")
  category       String           @default("Clinical")
  storyPoints    Int              @default(3)
  assigneeId     String?
  assigneeName   String
  assigneeRole   String
  assigneeColor  String           @default("#3B82F6")
  dueDate        DateTime?
  tags           String[]         @default([])
  blockedReason  String?
  subtasksJson   Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  subtasks       ProjectSubtask[]
  comments       ProjectComment[]

  @@unique([organizationId, taskId])
  @@index([organizationId, status])
}

model ProjectSubtask {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([taskId])
}

model ProjectComment {
  id          String      @id @default(cuid())
  taskId      String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorName  String
  authorRole  String
  avatarColor String      @default("#6B7280")
  content     String      @db.Text
  createdAt   DateTime    @default(now())

  @@index([taskId, createdAt])
}

/// Care Team Tagging & Team Alerts
model TeamAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetUserId   String
  targetUser     User         @relation("TeamAlertTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorUser     User         @relation("TeamAlertAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  senderId       String?
  senderName     String?
  recipientId    String?
  status         String?      @default("unread")
  urgency        String       @default("Routine")
  noteType       String
  message        String       @db.Text
  resolved       Boolean      @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("TeamAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, targetUserId, resolved])
  @@index([clientId])
}

/// Canonical Medical Payer Registry
model MedicalPayer {
  id                   String   @id @default(cuid())
  payerId              String   @unique
  name                 String
  shortName            String
  payerType            String   // "Medicare" | "Medicaid" | "Commercial" | "Self-Pay"
  address              String?  @default("")
  claimsPhone          String?  @default("")
  website              String?  @default("")
  timely               Int      @default(180)
  electronicSubmission Boolean  @default(true)
  clearinghouse        String   @default("Availity")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([payerId])
  @@index([payerType])
}

/// Canonical Priority-Driven Automated Billing Rules Engine
model MedicalBillingRule {
  id           String   @id @default(cuid())
  name         String
  description  String?  @default("")
  ruleType     String   // "supervisor_npi" | "telehealth_modifier" | "modifier_auto" | "payer_specific" | "custom"
  trigger      String
  action       String
  payers       String[] @default(["All"])
  active       Boolean  @default(true)
  priority     Int      @default(1)
  lastModified String   @default("")
  modifiedBy   String   @default("admin")
  createdAt    DateTime @default(now())
