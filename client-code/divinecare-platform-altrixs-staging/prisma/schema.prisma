  stage                    String    @default("referral") // referral, enrolled, assessed, irp
  referralData             Json?     @default("{}")
  enrollmentData           Json?     @default("{}")
  assessmentData           Json?     @default("{}")
  irpData                  Json?     @default("{}")
  qualifyingIcd10          String?
  recommendedDomains       String[]  @default([])
  medicalNecessityStrength String?
