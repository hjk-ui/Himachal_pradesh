  waitingRoom          Boolean            @default(true)
  /// { zoom: true, doxy: true, google: false, teams: false }
  platformsJson        Json               @default("{\"zoom\":true,\"doxy\":true,\"google\":false,\"teams\":false}")
  updatedAt            DateTime           @updatedAt
  createdAt            DateTime           @default(now())
}

model WaitlistEntry {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String?
  specialty            String
  urgency              WaitlistUrgency @default(ROUTINE)
  status               WaitlistStatus  @default(WAITING)
  insurancePayer       String?
  referralSource       String?
  notes                String?
  preferredClinician   String?
  clinicianId          String?
  clinician            User?           @relation("WaitlistClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  convertedClientId    String?
  convertedClient      Client?         @relation("WaitlistConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  matchedAt            DateTime?
  convertedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  intakeInvites        IntakeInvite[]
  // ── 20261028_waitlist_standard.sql (all nullable / defaulted; src/lib/waitlist/standard.ts) ──
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?       @db.Date
  /// phone | email | portal
  preferredContactMethod String?
  bestTimeToContact      String?
  guardianName           String?
  guardianPhone          String?
  guardianRelationship   String?
  /// child | adolescent | adult | older_adult
  ageGroup               String?
  /// Location ids (clinic sites) the person can attend
  preferredLocationIds   String[]        @default([])
  telehealthOk           Boolean?
  /// mon..sat
  availabilityDays       String[]        @default([])
  /// morning | afternoon | evening
  availabilityTimes      String[]        @default([])
  clinicianGenderPref    String?
  languagePref           String?
  payerRegistryId        String?
  insuranceMemberId      String?
  referringProvider      String?
  /// Brief reason / presenting concern (minimum necessary)
  presentingConcern      String?
  /// no | yes | not_asked — "yes" raises urgency to at least URGENT
  safetyScreen           String?
  safetyScreenAt         DateTime?
  safetyScreenById       String?
  /// NEW | CONTACTED | INTAKE_SENT | READY | SCHEDULED | CONVERTED | CLOSED (null = derived from status)
  stage                  String?
  /// no_response | went_elsewhere | not_eligible | declined | duplicate | other
  closeReason            String?
  nextFollowUpAt         DateTime?
  lastContactAt          DateTime?
  /// Consecutive outreach attempts without reaching the person (reset when reached)
  noResponseCount        Int             @default(0)
  convertedAppointmentId String?
  createdById            String?
  /// staff | clinician | web_form
  source                 String?
  marketingLeadId        String?
  contactAttempts        WaitlistContactAttempt[]

  @@index([organizationId, status, createdAt])
  @@index([clinicianId])
  @@index([urgency])
  @@index([organizationId, nextFollowUpAt])
