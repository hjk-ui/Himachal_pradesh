  rating                Float?
  notesSummary          String?
  clientConsentSigned Boolean                 @default(false)
  clientLocationState String?
  /// Patient's answer at check-in: home | other (POS 10 / 02). Null = not asked yet.
  patientLocationType String?
  /// Telehealth by phone only (no video)
  audioOnly           Boolean                 @default(false)
  patientPhone        String?
  patientEmail        String?
  inCallNotes         TelehealthInCallNote?
