  /// reached | left_voicemail | no_answer | email_sent | portal_sent | wrong_number | declined
  outcome          String
  note             String?
  nextFollowUpAt   DateTime?
  createdById      String?
  createdByName    String?
  createdAt        DateTime      @default(now())

  @@index([waitlistEntryId, createdAt])
  @@index([organizationId, createdAt])
}

model IntakeInvite {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token            String             @unique
  clientName       String
  clientEmail      String
  clientPhone      String?
  firstAppointment DateTime?
  /// Payer selected at Send Intake (Smart Match) — applied when client completes form if not overridden
  insurancePayer   String?
  /// In Office | Telehealth
  appointmentType  String?
  /// Client is homeless / no fixed address — waive street address on public form
  homeless         Boolean            @default(false)
  status           IntakeInviteStatus @default(PENDING)
  sentCount        Int                @default(1)
  expiresAt        DateTime
  completedAt      DateTime?
  /// Full public form submission (demographics, insurance, history, consents, signature)
  formData         Json?
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  waitlistEntryId  String?
  waitlistEntry    WaitlistEntry?     @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?              @relation("IntakeInviteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?              @relation("IntakeInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([clientEmail])
  @@index([waitlistEntryId])
  @@index([expiresAt])
