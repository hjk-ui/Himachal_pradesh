model Claim {
  availityClaimId String?
  clearinghouseClaimId String?
  clearinghouseProvider String? // waystar|availity|demo
  paidAmount Float?
  adjustmentAmount Float?
  patientResponsibility Float?
  eraProcessedAt DateTime?
  paidAt         DateTime?
  submittedBy    String?
  submittedAt    DateTime?
  submissionKey  String?
  submissionInProgress Boolean @default(false)
  submissionError String?
  clearinghouseDemo Boolean @default(false)
  submissionData Json?
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  progressNoteId String?
  progressNote   ProgressNote? @relation(fields: [progressNoteId], references: [id], onDelete: SetNull)
  cptCode        String
  units          Int         @default(1)
  amountCents    Int?
  payer          String?
  status         ClaimStatus @default(DRAFT)
  denialReason   String?
  icd10Codes     String[]    @default([])
  priorAuthNumber String?
  placeOfService String?     @default("11")
  renderingNpi   String?
  billingNpi     String?
  /// CLM01 sent to Waystar: <= 20 chars so payers never truncate it. The DB
  /// default assigns one on insert; numbers replaced by a corrected claim stay
  /// in ClaimControlNumber. Look claims up with claimByControlNumber().
  claimControlNumber String?  @unique @default(dbgenerated("('AX'::text || upper(substr(md5((random())::text || (clock_timestamp())::text), 1, 16)))"))
  /// SBR01 of the payer billed by this claim: P primary, S secondary, T tertiary
  payerResponsibility String  @default("P")
  /// CLM05-3: 1 original, 7 replacement (corrected), 8 void
  frequencyCode  String      @default("1")
  /// Payer's claim control number (ICN/DCN) from the 277CA / 835; sent as REF*F8 on 7/8
  payerClaimControlNumber String?
  /// Secondary/tertiary claim: the claim billed to the previous payer
  primaryClaimId String?
