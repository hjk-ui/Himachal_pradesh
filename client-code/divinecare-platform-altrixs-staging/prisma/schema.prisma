model HomebaseLocation {
  id                String    @id
  organizationId    String
  homebaseId        String
  name              String
  city              String?
  state             String?
  altrixsLocationId String?
  mappedById        String?
  mappedAt          DateTime?
  lastSeenAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now())

  @@unique([organizationId, homebaseId])
}

model HomebaseEmployee {
  id                  String    @id
  organizationId      String
  homebaseId          String
  firstName           String?
  lastName            String?
  email               String?
  jobTitle            String?
  /// active | archived | unknown
  status              String    @default("unknown")
  homebaseLocationIds String[]  @default([])
  linkedUserId        String?
  /// email | confirmed | suggested | rejected | none
  linkStatus          String    @default("none")
  suggestedUserId     String?
  linkedById          String?
  linkedAt            DateTime?
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now())

  @@unique([organizationId, homebaseId])
  @@index([organizationId, linkedUserId])
