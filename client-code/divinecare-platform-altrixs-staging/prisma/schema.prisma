  aliases         String[] @default([])
  isPanel         Boolean  @default(false)
  components      String[] @default([])
  loinc           String?
  cpt             String?
  specimenType    String?
  container       String?
  fastingRequired Boolean  @default(false)
  specialHandling String?
  /// drug_screen | therapeutic_drug_monitoring | chemistry | hematology | endocrine | infectious | cardiac | procedure | genetic | other
  category        String
  /// lab | in_office_procedure
  orderType       String   @default("lab")
  active          Boolean  @default(true)
  /// valant | altrixs
  source          String   @default("altrixs")
  /// Names this test had in the source system (e.g. Valant lab request types)
  sourceNames     String[] @default([])
  importedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("lab_tests")
}

