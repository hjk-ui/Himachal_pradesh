  createdAt      DateTime  @default(now())

  @@index([organizationId, clientId])
  @@index([status])
}

// ─── Payer Enrollment Credentialing Intake ────────────────────────────────
/// Insurance panel (payer credentialing / contract) for the practice: Billing › Insurance Panels
/// (src/lib/billing/payerPanels.ts, migration 20261027_payer_master.sql). Replaces the JSON
/// 'payer-panels' module list (imported once by legacyId). HR's per-provider document checklist
/// stays in ProviderPayerEnrollment.
model PayerPanel {
  id                     String    @id @default(cuid())
  organizationId         String
  /// Payer master entry; null when the payer is not in the master yet (payerName is free text)
  payerRegistryId        String?
  payerName              String
  /// Org staff on this panel (User ids)
  providerUserIds        String[]  @default([])
  /// not_started | application_submitted | in_process | approved | denied | termed
  status                 String    @default("not_started")
  submittedDate          DateTime? @db.Date
  effectiveDate          DateTime? @db.Date
  recredentialingDueDate DateTime? @db.Date
  /// Provider ID / PIN assigned by the payer
  providerPin            String?
  openToNewClients       Boolean   @default(false)
  contactName            String?
  contactPhone           String?
  contactEmail           String?
  notes                  String?
  /// panelId from the old JSON module list (import dedupe)
  legacyId               String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([organizationId, legacyId])
  @@index([organizationId, status])
  @@index([organizationId, payerRegistryId])
}

model ProviderPayerEnrollment {
  id             String    @id @default(cuid())
  providerUserId String
  payerName      String    // Optum MD, CareFirst, Medicare, Aetna, UHC, Cigna
