/// One 835 transaction set (one payment: BPR + TRN), 005010X221A1
model EraRemittance {
  id                  String    @id @default(uuid()) @db.Uuid
  inboundFileId       String?   @map("inbound_file_id") @db.Uuid
  fileName            String    @map("file_name")
  organizationId      String?   @map("organization_id")
  /// TRN02 check / EFT trace number
  traceNumber         String    @map("trace_number") @db.VarChar(50)
  /// TRN03 payer identifier
  payerTraceId        String    @default("") @map("payer_trace_id") @db.VarChar(50)
  payerName           String?   @map("payer_name")
  payerId             String?   @map("payer_id")
  payeeNpi            String?   @map("payee_npi")
  paymentMethod       String?   @map("payment_method") @db.VarChar(5)
  creditDebit         String?   @map("credit_debit") @db.VarChar(1)
  paymentAmount       Decimal   @map("payment_amount") @db.Decimal(12, 2)
  paymentDate         DateTime? @map("payment_date") @db.Date
  providerAdjustments Json?     @map("provider_adjustments")
  plbTotal            Decimal   @default(0) @map("plb_total") @db.Decimal(12, 2)
  claimCount          Int       @map("claim_count")
  balanced            Boolean   @default(true)
  balanceErrors       String[]  @default([]) @map("balance_errors")
  /// posted | partial | review | duplicate
  status              String    @default("review") @db.VarChar(20)
  paymentBatchId      String?   @map("payment_batch_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  claims              EraClaimPayment[]

  @@unique([traceNumber, payerTraceId])
  @@index([organizationId, createdAt])
  @@map("era_remittances")
}

/// One CLP (claim payment) of an 835, with its CAS / SVC detail and posting state
model EraClaimPayment {
  id                      String        @id @default(uuid()) @db.Uuid
  remittanceId            String        @map("remittance_id") @db.Uuid
  remittance              EraRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  seq                     Int
  organizationId          String?       @map("organization_id")
  claimId                 String?       @map("claim_id")
  matchKind               String        @default("none") @map("match_kind") @db.VarChar(20)
  /// CLP01 (our CLM01)
  patientControlNumber    String        @map("patient_control_number") @db.VarChar(50)
  statusCode              String        @map("status_code") @db.VarChar(4)
  chargeAmount            Decimal       @map("charge_amount") @db.Decimal(12, 2)
  paidAmount              Decimal       @map("paid_amount") @db.Decimal(12, 2)
  patientResponsibility   Decimal       @default(0) @map("patient_responsibility") @db.Decimal(12, 2)
  filingIndicator         String?       @map("filing_indicator") @db.VarChar(4)
  /// CLP07 payer claim control number (ICN / DCN)
  payerClaimControlNumber String?       @map("payer_claim_control_number") @db.VarChar(50)
  /// Payer-supplied patient label / member id, shown only in the review queue
  patientLabel            String?       @map("patient_label")
  memberId                String?       @map("member_id")
  serviceDateFrom         DateTime?     @map("service_date_from") @db.Date
  serviceDateTo           DateTime?     @map("service_date_to") @db.Date
  claimAdjustments        Json          @default("[]") @map("claim_adjustments")
  serviceLines            Json          @default("[]") @map("service_lines")
  remarks                 String[]      @default([])
  /// paid | partial | denied | patient_responsibility | reversal | forwarded | negative
  outcome                 String        @db.VarChar(30)
  /// pending | posted | review | dismissed | duplicate
  postingStatus           String        @default("pending") @map("posting_status") @db.VarChar(20)
  reviewReasons           String[]      @default([]) @map("review_reasons")
  suggestions             Json?
  paymentId               String?       @map("payment_id")
  postedAt                DateTime?     @map("posted_at") @db.Timestamptz(6)
  postedBy                String?       @map("posted_by")
  resolutionNote          String?       @map("resolution_note")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  adjustments             EraAdjustment[]

  @@unique([remittanceId, seq])
  @@index([claimId])
  @@index([organizationId, postingStatus])
  @@index([patientControlNumber])
  @@map("era_claim_payments")
}

/// CAS adjustment posted from an 835 (claim or service-line level)
model EraAdjustment {
  id            String          @id @default(uuid()) @db.Uuid
  eraClaimId    String          @map("era_claim_id") @db.Uuid
  eraClaim      EraClaimPayment @relation(fields: [eraClaimId], references: [id], onDelete: Cascade)
  organizationId String         @map("organization_id")
  claimId       String          @map("claim_id")
  /// claim | line
  level         String          @db.VarChar(5)
  lineSeq       Int?            @map("line_seq")
  serviceLineId String?         @map("service_line_id")
  procedureCode String?         @map("procedure_code") @db.VarChar(10)
  groupCode     String          @map("group_code") @db.VarChar(2)
  carc          String          @db.VarChar(5)
  amount        Decimal         @db.Decimal(12, 2)
  quantity      Decimal?        @db.Decimal(10, 2)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([claimId])
  @@index([eraClaimId])
  @@index([organizationId, createdAt])
  @@map("era_adjustments")
}

/// HealthLake FHIR R4 sync outbox: one row per FHIR resource derived from our rows.
/// Holds hashes and status only (never resource content). The scanner compares the
/// current mapped resource hash with syncedHash; the worker PUTs / DELETEs.
model FhirSyncState {
  id             String    @id @default(cuid())
  organizationId String
  resourceType   String
  /// FHIR logical id (stable, derived from our ids)
  resourceId     String
  sourceTable    String
  sourceId       String
  clientId       String?
  /// UPSERT | DELETE
  operation      String    @default("UPSERT")
  /// PENDING | IMPORTING | SYNCED | ERROR | DEAD | DELETED
  status         String    @default("PENDING")
  /// sha256 of the current mapped resource (what should be in HealthLake)
  hash           String
  /// hash last confirmed written to HealthLake
  syncedHash     String?
  versionId      String?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  lastSyncedAt   DateTime?
  importJobId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([resourceType, resourceId])
  @@index([organizationId, status])
  @@index([organizationId, resourceType])
  @@index([status, nextAttemptAt])
}

/// One HealthLake sync run per organization (cron or manual); counts only.
model FhirSyncRun {
  id             String    @id @default(cuid())
  organizationId String
  /// cron | manual | import
  trigger        String
  /// RUNNING | SUCCESS | PARTIAL | FAILED | SKIPPED
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  scanned        Int       @default(0)
  queued         Int       @default(0)
  synced         Int       @default(0)
  deleted        Int       @default(0)
  failed         Int       @default(0)
  excluded       Int       @default(0)
  detailJson     Json?
  error          String?

  @@index([organizationId, startedAt])
}

/// One Valant reference-only report import (aging, insurance aging, prepayments, copays).
/// Counts, period and the report's own totals only. Nothing here posts to the Altrixs ledger.
model ValantReferenceImport {
  id               String    @id @default(cuid())
  organizationId   String
  /// patient_aging | insurance_aging | prepayments | copays
  reportType       String
  asOf             DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  rowCount         Int       @default(0)
  matched          Int       @default(0)
  unmatched        Int       @default(0)
  /// Report totals as printed and our column sums (cents), plus reconcile flags
  totalsJson       Json?
  reconciles       Boolean   @default(false)
  migrationJobId   String?
  importedById     String?
  importedAt       DateTime  @default(now())

  @@index([organizationId, reportType, importedAt])
}

/// Valant "Patient Aging Summary" row for one patient on one as-of date. REFERENCE ONLY.
/// Re-importing the same as-of replaces the snapshot; the newest as-of is current.
/// Unmatched Valant IDs are kept (clientId null) so column totals still equal the report.
model ValantAgingSnapshot {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  valantPatientId  String
  asOf             DateTime
  bucket1Cents     Int
  bucket2Cents     Int
  bucket3Cents     Int
  bucket4Cents     Int
  bucket5Cents     Int
  totalCents       Int
  /// buckets 1-5 add up to the total in the export
  bucketsMatchTotal Boolean  @default(true)
  importId         String
  jobId            String?
  importedAt       DateTime  @default(now())

  @@unique([organizationId, valantPatientId, asOf])
  @@index([organizationId, asOf])
  @@index([clientId, asOf])
}

/// Valant "Insurance Aging Summary" row (payer A/R) on one as-of date. REFERENCE ONLY.
/// Payer names can repeat (different plans); every row is kept, ordered by rowIndex.
model ValantInsuranceAgingSnapshot {
  id               String    @id @default(cuid())
  organizationId   String
  asOf             DateTime
  rowIndex         Int
  payerName        String
  bucket1Cents     Int
  bucket2Cents     Int
  bucket3Cents     Int
  bucket4Cents     Int
  bucket5Cents     Int
  totalCents       Int
  bucketsMatchTotal Boolean  @default(true)
  importId         String
  importedAt       DateTime  @default(now())

  @@unique([organizationId, asOf, rowIndex])
  @@index([organizationId, asOf])
}

/// Per-organization headings for the five Valant aging buckets (shared by patient and insurance
/// aging). Defaults "Bucket 1".."Bucket 5"; unconfirmed until staff confirm them from Valant.
model ValantAgingSettings {
  organizationId   String    @id
  labels           Json
  confirmed        Boolean   @default(false)
  confirmedById    String?
  confirmedAt      DateTime?
  updatedById      String?
  updatedAt        DateTime  @updatedAt
  /// Owner decision 2026-10-17: show every Valant aging balance as "Over 120" (display only; stored buckets unchanged)
  displayAllOver120 Boolean  @default(true)
}

/// Valant "Prepayments" report transaction. REFERENCE ONLY.
/// Matched by Valant ID when the export has one, else by unique exact name, else staff assign it.
/// rowHash is stable across re-exports, so re-imports never duplicate and keep staff assignments.
model ValantPrepaymentTxn {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  valantName       String
  valantPatientId  String?
  /// Credit Card | Check | Prepayment Transfer (as Valant wrote it)
  type             String
  /// received | applied
  kind             String
  date             DateTime
  amountCents      Int
  reference        String?
  /// Valant number the transfer was applied to (blank on receipts)
  appliedTo        String?
  secondaryDate    DateTime?
  periodStart      DateTime
  periodEnd        DateTime
  rowHash          String
  /// valant_id | name_unique | manual | null (unmatched)
  matchMethod      String?
  /// none | duplicate (when unmatched)
  unmatchedReason  String?
  assignedById     String?
  assignedAt       DateTime?
  importId         String
  createdAt        DateTime  @default(now())

  @@unique([organizationId, rowHash])
  @@index([organizationId, clientId])
  @@index([organizationId, matchMethod])
}

/// Patient copay setting per payer / provider type / CPT rule (e.g. from Valant "Patient Copays").
/// '' in providerType / cptRule = applies to all. Re-importing replaces a client's valant rules;
/// rules entered in Altrixs (source altrixs) are never touched by an import.
/// valantLimit* is Valant's limit column, meaning unconfirmed; stored for display only.
model ClientCopayRule {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payerName        String
  providerType     String    @default("")
  cptRule          String    @default("")
  amountCents      Int
  valantLimitRaw   String?
  valantLimitCents Int?
  /// valant | altrixs
  source           String    @default("valant")
  importId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([clientId, source, payerName, providerType, cptRule], map: "ClientCopayRule_client_rule_key")
  @@index([organizationId, clientId])
}

/// Valant "Combined Aging" responsible-party line for one patient on one as-of date. REFERENCE ONLY.
/// party: patient | primary | secondary | other. A patient's total = sum of their lines.
/// Phone and address columns in the export are never stored. Re-import of the same as-of replaces.
model ValantCombinedAgingRow {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  valantPatientId  String
  asOf             DateTime
  /// order of this line within the patient (0, 1, ...)
  rowIndex         Int
  party            String
  payerName        String?
  lastBilledAt     DateTime?
  bucket1Cents     Int
  bucket2Cents     Int
  bucket3Cents     Int
  bucket4Cents     Int
  bucket5Cents     Int
  totalCents       Int
  bucketsMatchTotal Boolean  @default(true)
  importId         String
  importedAt       DateTime  @default(now())

  @@unique([organizationId, asOf, valantPatientId, rowIndex], map: "ValantCombinedAgingRow_org_asof_patient_row_key")
  @@index([organizationId, asOf])
  @@index([clientId, asOf])
}

/// Valant provider code -> staff user, set by a person (Admin > Data import > Valant provider codes).
/// Never matched by name. Read by the primary care PCP check (src/lib/medical/pcpAssignment.ts) and
/// Provider Collections (a mapped code wins over the import's name match). Migration:
/// prisma/migrations/20261020_valant_provider_map.sql.
model ValantProviderMap {
  id             String   @id @default(cuid())
  organizationId String
  /// Code as exported by Valant ("K.Daniel")
  providerCode   String
  /// Trimmed, space-collapsed, lowercased providerCode (lookup key)
  codeKey        String
  userId         String
  mappedById     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, codeKey])
  @@index([organizationId, userId])
}

/// Valant "Transactions" report row (charges, payments, adjustments). REFERENCE ONLY: never posted to
/// the Altrixs ledger. Idempotent on rowHash (content + occurrence among identical rows), so the same
/// row imported again is skipped. Patient names in the export are never stored.
model ValantTransaction {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  valantPatientId  String
  /// Valant billing / claim id (Billing1)
  billingId        String?
  serviceDate      DateTime?
  /// Valant provider code as exported ("K.Daniel")
  providerCode     String?
  /// Staff user when the provider code matches exactly one staff member
  providerUserId   String?
  pos              String?
  diagnosis        String?
  /// Raw Valant transaction code ("99214T", "Ins EFT 1", "InsAdjust")
  code             String
  /// CPT / HCPCS base for charge codes ("99214") and the rest of the code ("T", "-SPRAVATO")
  codeBase         String?
  codeSuffix       String?
  /// charge | fee | insurance_payment | insurance_adjustment | patient_payment | patient_adjustment | transfer | other
  category         String
  amountCents      Int
  /// Text after "Note:"
  note             String?
  reportLabel      String?
  /// Facility as exported on the Transaction Journal ("Outpatient Mental Health Clinic - Bowie")
  facility         String?
  /// Insurance cell from the Transaction Journal (blank, one payer, or a comma-joined list)
  insurance        String?
  /// transactions | journal (null = transactions, rows imported before the journal existed)
  sourceLayout     String?
  rowHash          String
  importId         String
  createdAt        DateTime  @default(now())

  @@unique([organizationId, rowHash])
  @@index([organizationId, clientId, serviceDate])
  @@index([organizationId, valantPatientId])
  @@index([organizationId, category])
  @@index([organizationId, billingId])
  @@index([organizationId, serviceDate])
  @@index([organizationId, facility])
}

/// Patient ledger entry that is not a claim or a payment: Valant opening balance, Valant prepayment
/// credit, or (reserved) a manual adjustment. amountCents > 0 = patient owes, < 0 = credit.
/// At most ONE active (supersededAt null) entry per (organizationId, clientId, kind, source): a partial
/// unique index in prisma/migrations/20261017_patient_ledger_entries.sql enforces it. Re-posting
/// supersedes the active row and inserts its replacement in one transaction; rows are never deleted
/// ("unpost" = supersede with no replacement). Insurance A/R is never posted here (Valant run-out).
model PatientLedgerEntry {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// opening_balance | prepayment_credit | manual_adjustment (reserved)
  kind           String
  amountCents    Int
  /// Date the source figure is as of (Valant aging as-of, or prepayment report period end)
  asOf           DateTime
  /// valant
  source         String
  /// Source import id and as-of / period, e.g. "patient_aging:<importId>:2026-10-16"
  sourceRef      String?
  note           String?
  /// One id per posting run, shared by every row the run inserted
  postingBatchId String?
  postedById     String?
  postedAt       DateTime  @default(now())
  supersededAt   DateTime?
  /// The entry that replaced this one (null when unposted)
  supersededById String?
  supersededByUserId String?

  @@index([organizationId, clientId, supersededAt])
  @@index([organizationId, source, kind, supersededAt])
}

/// Practice fee schedule (Billing → Fee Schedule). Imported from Valant's Fees export; staff can
/// edit any row (source becomes 'altrixs' and re-imports keep the edit unless "overwrite edits").
/// code = Valant code (CPT/HCPCS + variant suffix such as 90837T / 90837S, or an admin code);
/// billedCpt = what goes to the payer (null = self-pay / admin, never on an 837).
/// Lookup: feeFor() in src/lib/billing/feeScheduleDb.ts (falls back to src/lib/constants/cpt.ts).
model FeeScheduleItem {
  id                String    @id @default(cuid())
  organizationId    String
  code              String
  description       String
  feeCents          Int
  billedCpt         String?
  /// CPT/HCPCS base derived from code (null for admin codes such as Cancelled, NSH - Thrpy)
  baseCpt           String?
  telehealth        Boolean   @default(false)
  selfPay           Boolean   @default(false)
  child             Boolean   @default(false)
  itp               Boolean   @default(false)
  /// Picked only when this exact code is chosen (Spravato, Dr G self-pay, unknown suffixes)
  exactOnly         Boolean   @default(false)
  variantLabel      String
  /// billedCpt is a real CPT/HCPCS and the item is not self-pay (derived; self-pay is never billable)
  insuranceBillable Boolean   @default(false)
  active            Boolean   @default(true)
  /// valant | altrixs
  source            String    @default("valant")
  needsReview       Boolean   @default(false)
  reviewNote        String?
  importedAt        DateTime?
  editedById        String?
  editedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, baseCpt, active])
}

// ─── Locations from imports (src/lib/locations) ─────────────────────────────
// Plain id columns (no relations to Organization / Location / Client) so these tables never
// require edits to those models. Created by prisma/migrations/20261018_facility_location_map.sql.

/// Maps a facility name from a source system (Valant Transaction Journal "Facility") to an Altrixs
/// Location, or marks it as a program (Family Practice = primary care, IOP). Rows are created only by
/// an explicit owner action (Admin › Locations "Apply suggested mapping" or a row edit); never seeded.
model FacilityLocationMap {
  id                String    @id @default(cuid())
  organizationId    String
  /// valant
  sourceSystem      String    @default("valant")
  /// Facility exactly as exported ("Outpatient Mental Health Clinic - Bowie")
  facilityName      String
  /// location | program | ignore
  kind              String    @default("location")
  /// Location the facility belongs to (kind location; optional for a program run at one site)
  locationId        String?
  /// primary_care | iop | ... (kind program)
  programKey        String?
  /// true until the owner confirms an uncertain suggestion (e.g. STM = Lexington Park)
  needsConfirmation Boolean   @default(false)
  note              String?
  /// suggested | owner | facility_import
  origin            String    @default("owner")
  /// Valant facility list (Setup › Facilities DataGrid): "Name" column = billing entity
  /// ("MD Behavioral Health", "MD Behavioral Health - PRP"), Local Time Zone, Active
  billingEntityName String?
  timezone          String?
  sourceActive      Boolean?
  /// Last time the Valant facility list import touched this row
  facilityImportedAt DateTime?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([organizationId, sourceSystem, facilityName])
  @@index([organizationId, kind])
}

/// One client home-location change made by an owner-triggered "Recompute client locations" run.
/// Keeps the previous location so a run can be undone (revertedAt set; rows are never deleted).
model ClientLocationChange {
  id                 String    @id @default(cuid())
  organizationId     String
  runId              String
  clientId           String
  previousLocationId String?
  newLocationId      String?
  /// journal | clinician | journal+clinician
  evidence           String
  /// Short machine reason, ids/counts only (no PHI)
  detail             String?
  appliedById        String?
  appliedAt          DateTime  @default(now())
  revertedAt         DateTime?
  revertedById       String?

  @@index([organizationId, runId])
  @@index([organizationId, clientId])
}

// ─── Practice settings (src/lib/practice) ───────────────────────────────────
// Created by prisma/migrations/20261018_practice_settings.sql. Identifier columns are empty until a
// practice admin enters them — never seeded with placeholder NPIs / tax IDs.

/// One row per organization: practice profile, billing / claim defaults, clinical policy, compliance
/// contacts. Typed columns (not a JSON blob) so every setting is reportable and auditable.
model PracticeSettings {
  id                         String       @id @default(cuid())
  organizationId             String       @unique
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Profile
  legalName                  String?
  dbaName                    String?
  /// omhc | group | solo | cmhc | fqhc | other
  practiceType               String?
  specialties                String[]     @default([])
  /// Type 2 (organization) NPI, 10 digits, check digit validated
  organizationNpi            String?      @db.VarChar(10)
  /// EIN, 9 digits stored without the dash; masked in every response
  taxId                      String?      @db.VarChar(9)
  /// NUCC taxonomy codes (first = primary), e.g. 261QM0801X
  taxonomyCodes              String[]     @default([])
  medicaidProviderNumber     String?
  medicarePtan               String?
  /// CMS CLIA certificate (NNDNNNNNNN); overrides env LAB_FACILITY_CLIA when set
  cliaNumber                 String?      @db.VarChar(10)
  omhcLicenseNumber          String?
  omhcLicenseExpiresOn       DateTime?    @db.Date
  prpLicenseNumber           String?
  prpLicenseExpiresOn        DateTime?    @db.Date
  /// CARF | TJC | COA | none
  accreditationBody          String?
  accreditationExpiresOn     DateTime?    @db.Date
  logoUrl                    String?
  brandColor                 String?
  mainPhone                  String?
  mainFax                    String?
  mainEmail                  String?
  website                    String?
  timeZone                   String       @default("America/New_York")
  /// 1 = January
  fiscalYearStartMonth       Int          @default(1)

  // Billing (837P 2010AA comes from billing_providers; 2010AB pay-to below)
  billingContactName         String?
  billingContactPhone        String?
  billingContactEmail        String?
  payToSameAsBilling         Boolean      @default(true)
  payToAddressLine1          String?
  payToAddressLine2          String?
  payToCity                  String?
  payToState                 String?      @db.VarChar(2)
  payToZip                   String?      @db.VarChar(9)
  /// appointment_clinician | billing_provider
  renderingProviderDefault   String       @default("appointment_clinician")
  posOffice                  String       @default("11") @db.VarChar(2)
  posTelehealthHome          String       @default("10") @db.VarChar(2)
  posTelehealthOther         String       @default("02") @db.VarChar(2)
  /// 95 | GT | none — per-payer overrides live on the Waystar payer mapping
  telehealthModifierDefault  String       @default("95")
  statementRemitName         String?
  statementRemitAddressLine1 String?
  statementRemitAddressLine2 String?
  statementRemitCity         String?
  statementRemitState        String?      @db.VarChar(2)
  statementRemitZip          String?      @db.VarChar(9)
  statementMessage           String?
  paymentTermsDays           Int          @default(30)
  lateFeesEnabled            Boolean      @default(false)
  lateFeeCents               Int?
  /// at_check_in | at_check_out | bill_after_visit
  copayCollectionPolicy      String       @default("at_check_in")
  noShowFeeEnabled           Boolean      @default(false)
  noShowFeeCents             Int?
  lateCancelFeeEnabled       Boolean      @default(false)
  lateCancelFeeCents         Int?
  cancellationWindowHours    Int          @default(24)
  /// "Automatic overnight eligibility checks" (scripts/eligibility-nightly.ts). Default OFF:
  /// enable after Waystar production is live. Leadership + billing edit it on the eligibility page.
  eligibilityNightlyEnabled  Boolean      @default(false)
  /// "Allow on test clearinghouse": lets the nightly job send while Waystar usage indicator is T. Default OFF.
  eligibilityNightlyAllowTest Boolean     @default(false)
  eligibilityNightlyUpdatedBy String?
  eligibilityNightlyUpdatedAt DateTime?

  // Clinical policy
  noteSignDeadlineHours      Int          @default(72)
  lateNoteEscalationHours    Int          @default(72)
  lateNoteEscalationRole     String       @default("PRACTICE_DIRECTOR")
  cosignRequiredRoles        String[]     @default(["PRP_SPECIALIST", "CASE_MANAGER", "PEER_SUPPORT"])
  cosignDeadlineHours        Int          @default(72)
  treatmentPlanReviewDays    Int          @default(180)
  prpIrpReviewDays           Int          @default(180)
  /// PRP billing model, confirmed by the practice (PRP_BILLING_MODELS in src/lib/prp/standard.ts):
  /// per_encounter_h2017 | monthly_case_rate_h2018_h2016; null = not confirmed. Migration 20261022_prp_standard.sql
  prpBillingModel            String?
  prpBillingModelConfirmedBy String?
  prpBillingModelConfirmedAt DateTime?
  /// Practice policy: minimum PRP contacts per participant per month for billing; null = not set (no flag)
  prpMonthlyMinContacts      Int?
  prpPolicyUpdatedBy         String?
  prpPolicyUpdatedAt         DateTime?
  phq9IntervalDays           Int          @default(30)
  gad7IntervalDays           Int          @default(30)
  assessAtIntake             Boolean      @default(true)
  aiNoteConsentRequired      Boolean      @default(true)
  safetyPlanRequiredHighRisk Boolean      @default(true)
  /// Leadership: assign AUDIT, CAGE-AID, NIDA-Modified ASSIST and BAM when a client appears on the SUD Referral Radar (migration 20261023_sud_radar_auto_measures.sql)
  sudRadarAutoAssignMeasures Boolean      @default(false)
  /// Measurement-based care (migration 20261023_measures_to_patients.sql). All default OFF:
  /// mbcAutoSend: email / text due measures to patients 3 days and 1 day before a visit
  mbcAutoSend                Boolean      @default(false)
  /// Rule a: clients with an upcoming therapy or med-management visit get PHQ-9 (PHQ-A under 18) and GAD-7 (phq9IntervalDays / gad7IntervalDays)
  mbcVisitRule               Boolean      @default(false)
  /// Rule b: intensive program clients get the program's measures (mbcProgramMeasures)
  mbcProgramRule             Boolean      @default(false)
  /// Rule c: provider-specific extra measures (mbcProviderMeasures)
  mbcProviderRule            Boolean      @default(false)
  /// [{ programId, instrumentIds: string[], everyDays }]
  mbcProgramMeasures         Json         @default("[]")
  /// [{ userId, instrumentIds: string[], everyDays }]
  mbcProviderMeasures        Json         @default("[]")

  // Compliance & privacy
  privacyOfficerName         String?
  privacyOfficerEmail        String?
  privacyOfficerPhone        String?
  securityOfficerName        String?
  securityOfficerEmail       String?
  securityOfficerPhone       String?
  breachContactName          String?
  breachContactEmail         String?
  breachContactPhone         String?
  /// 42 CFR Part 2 federally assisted SUD program; null = not answered yet
  part2Program               Boolean?
  recordRetentionYearsAdult  Int          @default(5)
  /// Minor records kept at least until this age (or adult years after the record, whichever later)
  recordRetentionMinorAge    Int          @default(21)
  /// Staff two-factor sign-in required (default ON). Env MFA_ENFORCE=false overrides for emergencies only.
  mfaRequired                Boolean      @default(true)

  /// Section keys saved at least once (profile, billing, clinical, scheduling, compliance, ...)
  reviewedSections           String[]     @default([])
  /// Setup wizard resume point
  onboardingStep             String?
  onboardingCompletedAt      DateTime?
  updatedBy                  String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

/// Business associate agreement status per vendor (status fields only; the signed document lives elsewhere).
model PracticeBaa {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// aws | waystar | drfirst | stripe | other key
  vendorKey      String
  vendorName     String
  /// not_started | requested | signed | not_required
  status         String       @default("not_started")
  signedOn       DateTime?    @db.Date
  expiresOn      DateTime?    @db.Date
  notes          String?
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, vendorKey])
}

/// 42 CFR Part 2 disclosure of SUD records (2.13(d) / 2.24 accounting of disclosures).
/// Append-only: UPDATE/DELETE blocked by a DB trigger; no update/delete API. Plain id
/// columns (no relations) so rows outlive client/consent edits, like AuditLog.
model Part2Disclosure {
  id                    String   @id @default(cuid())
  organizationId        String
  clientId              String
  /// ConsentForm.id when the consent is on file in Altrixs
  consentFormId         String?
  /// Paper / external consent reference when there is no ConsentForm row
  consentReference      String?
  /// consent | medical_emergency | court_order | audit_evaluation | research | other_exception
  basis                 String   @default("consent")
  disclosedTo           String
  purpose               String
  informationDisclosed  String
  /// mail | fax | electronic | hie | portal | in_person | phone | other
  method                String
  disclosedAt           DateTime
  disclosedById         String
  createdAt             DateTime @default(now())

  @@index([organizationId, clientId, disclosedAt])
  @@index([organizationId, disclosedAt])
}

// ─── Measurement types & recorded measures (src/lib/migration/valantMeasurementTypes.ts) ───
// Plain id columns (no relations to Organization / Client) so these tables never require edits
// to those models. Created by prisma/migrations/20261018_measurement_types.sql.

/// Catalog of measures the practice records (Valant "Measurement Types" import): instrument
/// scores and subscores, vitals. A definition list, no patient data. documentationCode and
/// defaultUnits store '' for none so the unique key holds (Postgres treats NULLs as distinct).
model MeasurementType {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  documentationCode String   @default("")
  /// vital_sign | other (or the raw Valant category, snake_case)
  category          String   @default("other")
  /// integer | real | blood_pressure | bmi | length | mass | smoking_status
  dataType          String
  /// UCUM code: mm[Hg], kg/m2, mg/dL, /min, [in_i], [lb_av]; '' = none
  defaultUnits      String   @default("")
  /// Practice toggle; set from the file on first import only
  active            Boolean  @default(true)
  /// valant | altrixs
  source            String   @default("valant")
  sourceName        String?
  sourceCategory    String?
  sourceDataType    String?
  sourceUnits       String?
  /// Altrixs instrument id (ASSESSMENT_CATALOG) this measure belongs to
  instrumentKey     String?
  /// Instrument group for subscores ("WHODAS 2.0", "PCL-5")
  parentInstrument  String?
  isSubscore        Boolean  @default(false)
  /// MedicalVital column the vital corresponds to (bpSystolic, heartRate, ...)
  vitalField        String?
  importedAt        DateTime?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  results           MeasurementResult[]

  @@unique([organizationId, name, documentationCode, dataType, defaultUnits])
  @@index([organizationId, active])
  @@index([organizationId, parentInstrument])
}

/// One recorded value of a MeasurementType for a client (manual entry now; Valant results
/// import later). BP: valueNumeric = systolic, valueSecondary = diastolic. Smoking status:
/// valueText = SNOMED CT code. sourceRef makes a future results import idempotent.
model MeasurementResult {
  id                String          @id @default(cuid())
  organizationId    String
  clientId          String
  measurementTypeId String
  measurementType   MeasurementType @relation(fields: [measurementTypeId], references: [id], onDelete: Restrict)
  valueNumeric      Float?
  valueSecondary    Float?
  valueText         String?
  /// Units at the time of recording (UCUM code)
  units             String?
  measuredAt        DateTime
  /// manual | valant
  source            String          @default("manual")
  sourceRef         String?
  notes             String?
  recordedById      String?
  createdAt         DateTime        @default(now())

  @@unique([organizationId, source, sourceRef])
  @@index([organizationId, clientId, measuredAt])
  @@index([organizationId, measurementTypeId])
}

/// Valant "Insurance Companies" export, one row per (normalized name, Valant EDI payer ID).
/// REFERENCE for billing: never sent on claims. ediPayerId is Valant's clearinghouse ID ('' = none)
/// and is never copied into waystar_payer_mappings. taxIdsRaw is Valant's internal tax-ID
/// association list (often the practice's own EIN): reference only, never the payer's tax ID.
/// Addresses live in ValantPayerAddress (payers have several claim addresses).
model ValantPayer {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  normalizedName   String
  ediPayerId       String    @default("")
  nameVariants     String[]  @default([])
  /// primary address (first well-formed one); raw kept as printed
  addressLine      String?
  city             String?
  state            String?
  zip              String?
  addressRaw       String?
  /// 10 digits when a valid NANP number, else null with phoneRaw + phoneStatus 'invalid'
  phone            String?
  phoneRaw         String?
  /// valid | invalid | missing
  phoneStatus      String    @default("missing")
  taxIdsRaw        String?
  active           Boolean   @default(true)
  /// hash of the source rows; unchanged file -> no update
  sourceRowHash    String
  sourceRowCount   Int       @default(1)
  /// payers sharing a name or EDI ID with this one (possible duplicates for review)
  duplicateGroup   String?
  /// client insurance payer names staff confirmed as this payer
  confirmedAliases String[]  @default([])
  /// PayerRegistry entry staff confirmed (or created from this payer)
  payerRegistryId  String?
  linkedById       String?
  linkedAt         DateTime?
  importId         String?
  importedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses        ValantPayerAddress[]

  @@unique([organizationId, normalizedName, ediPayerId])
  @@index([organizationId, ediPayerId])
  @@index([organizationId, payerRegistryId])
}

/// One distinct claim address (+ phones) of a ValantPayer, from one or more export rows.
model ValantPayerAddress {
  id               String      @id @default(cuid())
  organizationId   String
  payerId          String
  payer            ValantPayer @relation(fields: [payerId], references: [id], onDelete: Cascade)
  /// hash of normalized street/city/state/ZIP5 ('no-address' for phone-only rows)
  addressKey       String
  addressLine      String?
  city             String?
  state            String?
  zip              String?
  addressRaw       String?
  /// ok | suspect | unparsed | missing
  addressStatus    String      @default("ok")
  addressIssues    String[]    @default([])
  phone            String?
  phonesRaw        String[]    @default([])
  phoneStatus      String      @default("missing")
  phoneIssues      String[]    @default([])
  taxIdsRaw        String[]    @default([])
  sourceLines      Int[]       @default([])
  position         Int         @default(0)

  @@unique([payerId, addressKey])
  @@index([organizationId])
}

// ─── SDOH: AHC HRSN screenings, referrals, resource directory (migration 20261018_sdoh.sql) ───
