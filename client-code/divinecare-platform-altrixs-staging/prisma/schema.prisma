model ConsentForm {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String
  status         ConsentFormStatus @default(PENDING)
  method         String            @default("In-Person")
  sentAt         DateTime          @default(now())
  signedAt       DateTime?
  expiresAt      DateTime?
  signedByName   String?
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Versioned structured forms (null for the simple consents above). Migration 20261019_carelon_attestation.sql
  /// Form template key, e.g. carelon-md-nonoverlap-attestation (src/lib/consents/carelon/template.ts)
  formKey             String?
  /// Template version the form was opened / signed on, e.g. 2025
  formVersion         String?
  /// Workflow status: NOT_STARTED | SENT | CLIENT_SIGNED | COMPLETE | SUBMITTED | SUPERSEDED | VOIDED
  formStatus          String?
  /// Frozen document (exact text + prefilled values at signature), signatures, submission, events
  formData            Json?
  /// Why this attestation was requested (e.g. PRP enrollment); null = standing Medicaid requirement
  neededReason        String?
  clientSignedAt      DateTime?
  providerSignedAt    DateTime?
  providerSignedById  String?
  /// Date staff uploaded it in the payer's portal (Carelon); Altrixs never transmits it
  submittedAt         DateTime?
  submittedById       String?
  supersededAt        DateTime?
  supersededById      String?
  /// Signed PDF in private uploads (signed-forms), with its SHA-256
  pdfFileName         String?
  pdfSha256           String?

  // Consent library (formKey "lib:<template key>"). Migration 20261019_consent_library.sql
  /// ConsentPacket.id when signed as part of a packet
  packetId            String?
  /// Revocation: Altrixs stops relying on the consent from this date (src/lib/consents/library/revocation.ts)
  revokedAt           DateTime?
  revokedById         String?
  /// verbal | written
  revocationMethod    String?
  /// in_person | phone | mail | fax | email | portal | other
  revocationReceivedVia String?
  revocationNote      String?
  /// ROI / Part 2 consent recipient (per-recipient authorizations)
  recipientName       String?

  @@index([organizationId, status, sentAt])
  @@index([clientId, status])
  @@index([expiresAt])
  @@index([organizationId, formKey, formStatus])
  @@index([clientId, formKey])
  @@index([packetId])
}

/// Per-practice lifecycle of a consent template version (the text lives in src/lib/consents/library).
/// Draft → Approved (ADMIN / PRACTICE_DIRECTOR, recorded) → Active → Retired. No row = the version's default.
model ConsentTemplateState {
  id             String    @id @default(cuid())
  organizationId String
  templateKey    String
  version        Int
  /// DRAFT | APPROVED | ACTIVE | RETIRED
  status         String
  approvedAt     DateTime?
  approvedById   String?
  approvedByName String?
  activatedAt    DateTime?
  activatedById  String?
  retiredAt      DateTime?
  retiredById    String?
  note           String?
  /// [{at, action, byId, byName, note}]
  history        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, templateKey, version])
  @@index([organizationId, status])
}

/// Consent library settings: which templates go in the new-client packet (ordered) and the NPP document.
model ConsentLibrarySettings {
  organizationId   String    @id
  /// Ordered template keys in the intake packet (null = DEFAULT_PACKET_ORDER)
  packetKeys       String[]  @default([])
  packetCustomized Boolean   @default(false)
  /// Notice of Privacy Practices: public URL and/or uploaded PDF (signed-forms/ private storage)
  nppUrl           String?
  nppFileName      String?
  nppSha256        String?
  nppEffectiveDate String?
  updatedById      String?
  updatedAt        DateTime  @updatedAt
}

/// A composed consent packet sent to / signed by one client (intake, portal or in office).
model ConsentPacket {
  id                 String    @id @default(cuid())
  organizationId     String
  clientId           String
  intakeInviteId     String?
  /// SENT | SIGNED | VOIDED
  status             String    @default("SENT")
  /// intake | portal | in_office
  method             String
  /// [{key, version, title, signing, optional, reason, prefill?, purposeTag?}] composed when sent
  items              Json
  /// composer notes: skipped templates + reasons, minor rule, Carelon flag
  composition        Json?
  sentAt             DateTime  @default(now())
  signedAt           DateTime?
  /// self | representative
  signerType         String?
  signerName         String?
  signerRelationship String?
  signerAuthority    String?
  signatureTyped     String?
  recordedById       String?
  pdfFileName        String?
  pdfSha256          String?
  createdById        String?
  voidedAt           DateTime?
  voidReason         String?
  // Consents standard (20261021_consents_signing_evidence.sql): delivery tracking + e-signature evidence
  /// Channels the client was notified on: portal | email | sms
  deliveryChannels   String[]  @default([])
  lastSentAt         DateTime?
  sendCount          Int       @default(0)
  /// First time the client opened the packet in the portal
  viewedAt           DateTime?
  /// {signatureMethod, ipAddress, userAgent, portalAccountId, proxy, witness, interpreter, paperDocumentRef, hashes[]}
  evidence           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, clientId, status])
  @@index([organizationId, status, sentAt])
}

/// Check-in soft stop overridden: staff checked a client in without the consent to treatment (or
/// telehealth consent for a virtual visit). The reason lives here, not in audit metadata.
/// Migration 20261022_consents_decisions.sql
model ConsentCheckInOverride {
  id             String   @id @default(cuid())
  organizationId String
  appointmentId  String
  clientId       String
  /// Template keys that were missing at check-in
  templateKeys   String[] @default([])
  reason         String
  overriddenById String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([appointmentId])
  @@index([clientId])
}

/// Automatic consent reminders sent per subject (kind packet = ConsentPacket.id, renewal = the
/// expiring ConsentForm.id): count, last send and the schedule stages already done (no double sends).
model ConsentReminder {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  /// packet | renewal
  kind           String
  subjectId      String
  count          Int       @default(0)
  lastAt         DateTime?
  /// Stages done: d3 | d7 (packet), pre30 | pre7 (renewal)
  stages         String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([kind, subjectId])
  @@index([organizationId, kind])
}

/// Consent automation settings per practice ("Automatic consent reminders", default on).
model ConsentReminderSettings {
  organizationId String   @id
  autoReminders  Boolean  @default(true)
  updatedById    String?
  updatedAt      DateTime @updatedAt
}

model TreatmentPlan {
