// ─── AI Scribe: ambient capture, grounded drafts, retention (migration 20261019_scribe_core.sql) ───
// Audio is never stored: the browser streams it to AWS Transcribe Medical (in person / dictation)
// or Chime sends the meeting audio to Transcribe Medical (telehealth). Only text lands here, in the
// KMS-encrypted RDS database, and transcript segments are deleted transcriptRetentionDays after the
// note is signed (docs/ai-scribe.md). client_id / organization_id carry FKs (ON DELETE CASCADE) in
// the SQL migration; they are plain columns here so the Client / Organization models stay untouched.

/// Practice AI Scribe settings (one row per organization; defaults apply when absent).
model ScribeSettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique @map("organization_id")
  enabled                 Boolean  @default(true)
  transcriptRetentionDays Int      @default(30) @map("transcript_retention_days")
  defaultFormat           String   @default("THERAPY_PROGRESS") @map("default_format") @db.VarChar(40)
  clientSummarySharing    Boolean  @default(false) @map("client_summary_sharing")
  liveCuesDefault         Boolean  @default(true) @map("live_cues_default")
  /// standard (Amazon Transcribe + practice vocabulary, default) | medical (Transcribe Medical)
  transcriptionEngine     String   @default("standard") @map("transcription_engine") @db.VarChar(16)
  /// Delete transcript + drafts as soon as the note created from the capture is signed (default on; 20261023_scribe_session_start.sql)
  deleteTranscriptOnSign  Boolean  @default(true) @map("delete_transcript_on_sign")
  updatedById             String?  @map("updated_by_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("scribe_settings")
}

/// One clinician's drafting preferences (format, length, terminology, smart phrases).
model ScribePreference {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  defaultFormat  String?  @map("default_format") @db.VarChar(40)
  /// concise | standard | detailed
  verbosity      String   @default("standard") @db.VarChar(12)
  /// client | patient
  clientTerm     String   @default("client") @map("client_term") @db.VarChar(12)
  /// they | she | he | none
  pronouns       String   @default("they") @db.VarChar(8)
  phraseKeys     String[] @default([]) @map("phrase_keys")
  liveCues       Boolean? @map("live_cues")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, userId])
  @@map("scribe_preferences")
}

/// One capture session (in person, telehealth or dictation) with its recording-consent attestation.
model ScribeCapture {
  id                        String    @id @default(cuid())
  organizationId            String    @map("organization_id")
  clientId                  String    @map("client_id")
  clinicianId               String    @map("clinician_id")
  appointmentId             String?   @map("appointment_id")
  telehealthSessionId       String?   @map("telehealth_session_id")
  /// in_person | telehealth | dictation
  mode                      String    @db.VarChar(16)
  /// transcribe_medical_streaming | chime_transcribe_medical
  engine                    String    @db.VarChar(40)
  /// ready | capturing | paused | stopped | drafted | note_created | discarded
  status                    String    @default("ready") @db.VarChar(16)
  noteFormat                String?   @map("note_format") @db.VarChar(40)
  /// 42 CFR Part 2 (SUD) session: Part 2 notice on every output; summary sharing needs consent
  part2                     Boolean   @default(false)
  /// AI consent at capture start: signed | missing (declined never starts)
  aiConsentStatus           String    @map("ai_consent_status") @db.VarChar(10)
  /// Recording consent attestation (Md. Cts. and Jud. Proc. 10-402: all parties)
  consentMethod             String?   @map("consent_method") @db.VarChar(10)
  /// [{ role, label?, consented }]; dictation has none (consentClinicianOnly)
  consentParticipants       Json?     @map("consent_participants")
  consentClinicianOnly      Boolean   @default(false) @map("consent_clinician_only")
  consentScriptVersion      String?   @map("consent_script_version") @db.VarChar(20)
  consentAttestedById       String    @map("consent_attested_by_id")
  consentAttestedByName     String?   @map("consent_attested_by_name")
  consentAttestedAt         DateTime  @default(now()) @map("consent_attested_at") @db.Timestamptz(6)
  consentWithdrawnAt        DateTime? @map("consent_withdrawn_at") @db.Timestamptz(6)
  /// Clinician corrections: { "spk_0": "CLINICIAN", "attendee:abc": "CLIENT" }
  speakerMap                Json?     @map("speaker_map")
  liveCues                  Boolean   @default(true) @map("live_cues")
  startedAt                 DateTime? @map("started_at") @db.Timestamptz(6)
  stoppedAt                 DateTime? @map("stopped_at") @db.Timestamptz(6)
  /// Usage metering (ai_scribe add-on): seconds captured, streams opened, drafts generated
  captureSeconds            Int       @default(0) @map("capture_seconds")
  streamCount               Int       @default(0) @map("stream_count")
  draftCount                Int       @default(0) @map("draft_count")
  progressNoteId            String?   @map("progress_note_id")
  noteSignedAt              DateTime? @map("note_signed_at") @db.Timestamptz(6)
  /// Set by the retention job (note signed + retention days, or stopped + retention days when no note)
  transcriptPurgeAfter      DateTime? @map("transcript_purge_after") @db.Timestamptz(6)
  transcriptPurgedAt        DateTime? @map("transcript_purged_at") @db.Timestamptz(6)
  /// Plain-language client summary: draft | approved | shared
  clientSummary             String?   @map("client_summary") @db.Text
  clientSummaryStatus       String?   @map("client_summary_status") @db.VarChar(10)
  clientSummaryApprovedById String?   @map("client_summary_approved_by_id")
  clientSummarySharedAt     DateTime? @map("client_summary_shared_at") @db.Timestamptz(6)
  /// Capture language: en-US | es-US (the note is always drafted in English)
  language                  String    @default("en-US") @db.VarChar(8)
  /// live | upload (audio file, batch Transcribe) | recap (post-session dictated recap)
  source                    String    @default("live") @db.VarChar(12)
  /// Upload only: S3 object while it exists (deleted as soon as the transcript exists)
  audioObjectKey            String?   @map("audio_object_key") @db.VarChar(300)
  batchJobName              String?   @map("batch_job_name") @db.VarChar(200)
  audioDeletedAt            DateTime? @map("audio_deleted_at") @db.Timestamptz(6)
  /// Session clock (20261024_scribe_safety_hardening.sql): current pause start, total paused seconds
  pausedAt                  DateTime? @map("paused_at") @db.Timestamptz(6)
  pausedSeconds             Int       @default(0) @map("paused_seconds")
  /// Recording gaps (20261025_scribe_recording_gaps.sql): [{ startMs, endMs, reason }] on the capture clock, no audio or text
  recordingGaps             Json?     @map("recording_gaps")
  /// Transcript risk scan (src/lib/scribe/riskGate.ts): [{ lineId, at, category, concept, label, severity }], no quotes.
  /// A linked note signs only with a documented C-SSRS / risk level / safety plan update, or the attestation below.
  riskFindings              Json?     @map("risk_findings")
  /// "Risk content was reviewed; no further assessment indicated because …" (audited SCRIBE_RISK_ATTESTATION)
  riskAttestation           String?   @map("risk_attestation") @db.Text
  riskAttestedAt            DateTime? @map("risk_attested_at") @db.Timestamptz(6)
  riskAttestedById          String?   @map("risk_attested_by_id")
  /// Inferred speaker labels (one microphone / third speaker) confirmed by the clinician before drafting
  speakersConfirmedAt       DateTime? @map("speakers_confirmed_at") @db.Timestamptz(6)
  speakersConfirmedById     String?   @map("speakers_confirmed_by_id")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  segments  ScribeSegment[]
  drafts    ScribeDraft[]
  followUps ScribeFollowUp[]

  @@index([organizationId, clientId])
  @@index([organizationId, clinicianId, createdAt])
  @@index([progressNoteId])
  @@index([transcriptPurgeAfter])
  @@map("scribe_captures")
}

/// One finalized transcript turn: raw speaker label (role comes from the session speaker map), session-clock times.
model ScribeSegment {
  id             String        @id @default(cuid())
  sessionId      String        @map("session_id")
  session        ScribeCapture @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organizationId String        @map("organization_id")
  seq            Int
  speakerLabel   String        @map("speaker_label") @db.VarChar(80)
  startMs        Int           @map("start_ms")
  endMs          Int           @map("end_ms")
  text           String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, seq])
  @@index([organizationId])
  @@map("scribe_segments")
}

/// A grounded AI draft: sentences with transcript / chart citations, withheld sentences, linkage, coding, risk.
model ScribeDraft {
  id             String        @id @default(cuid())
  sessionId      String        @map("session_id")
  session        ScribeCapture @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organizationId String        @map("organization_id")
  clientId       String        @map("client_id")
  createdById    String        @map("created_by_id")
  format         String        @db.VarChar(40)
  modelId        String        @map("model_id") @db.VarChar(120)
  /// Provenance: sections, fields, withheld, planLinks, risk, coding, followUps (citations are line ids only)
  content        Json
  sentenceCount  Int           @default(0) @map("sentence_count")
  withheldCount  Int           @default(0) @map("withheld_count")
  flaggedCount   Int           @default(0) @map("flagged_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId, createdAt])
  @@map("scribe_drafts")
}

/// One AI Scribe capture of a group session (20261023_scribe_session_start.sql; src/lib/scribe/group.ts).
/// members: [{ clientId, alias, aiConsent, part2, included }]; speakerMap: { "spk_0": "CLINICIAN" | "member:<clientId>" }.
/// Unmapped speakers and members without AI consent are never used in any draft.
model ScribeGroupCapture {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  groupSessionId        String    @map("group_session_id")
  groupId               String    @map("group_id")
  clinicianId           String    @map("clinician_id")
  engine                String    @db.VarChar(40)
  language              String    @default("en-US") @db.VarChar(8)
  /// ready | capturing | paused | stopped | drafted | discarded
  status                String    @default("ready") @db.VarChar(16)
  part2                 Boolean   @default(false)
  members               Json      @default("[]")
  consentParticipants   Json?     @map("consent_participants")
  consentScriptVersion  String?   @map("consent_script_version") @db.VarChar(20)
  consentAttestedById   String    @map("consent_attested_by_id")
  consentAttestedByName String?   @map("consent_attested_by_name")
  consentAttestedAt     DateTime  @default(now()) @map("consent_attested_at") @db.Timestamptz(6)
  consentWithdrawnAt    DateTime? @map("consent_withdrawn_at") @db.Timestamptz(6)
  speakerMap            Json?     @map("speaker_map")
  draft                 Json?
