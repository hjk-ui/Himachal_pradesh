/// Incident report (CARF 1.H / COMAR 10.21.20). Replaces the org-wide ClinicModuleState 'incidents'
/// list (scripts/migrate-incidents-blob.ts copies it). Line staff see only reports they filed, that
/// name them as involved staff or that are assigned to them; leadership, Office Manager (operations)
/// and a verified Medical Director review all (src/lib/incidents/access.ts).
/// Migration 20261022_roles_followup_incidents.sql
model IncidentReport {
  id                 String    @id @default(cuid())
  organizationId     String
  /// INC-YYYY-NNN, unique per organization (assigned by the server)
  incidentNumber     String
  title              String
  type               String
  chartCategory      String?
  /// critical | serious | minor
  severity           String
  /// reported | investigating | corrective_action | closed | filed_in_error
  status             String    @default("reported")
  /// Staff user who filed the report (null = legacy row whose reporter name matched no single user)
  reporterUserId     String?
  /// Reporter display name as filed
  reportedByName     String?
  /// Staff users named as involved in the incident
  involvedStaffIds   String[]  @default([])
  assignedToUserId   String?
  assignedToName     String?
  /// Optional client record link (Part 2 / sensitive lock applies when set)
  clientId           String?
  clientInitials     String?
  /// Practice date the report was filed, YYYY-MM-DD
  reportedDate       String
  /// Instant the report was entered (null = not recorded on a legacy row)
  reportedAtTime     DateTime?
  /// Instant the incident occurred (null = unknown)
  occurredAt         DateTime?
  /// YYYY-MM-DD
  dueFollowUp        String?
  /// YYYY-MM-DD, set when closed
  closedAt           String?
  location           String?
  description        String
  immediateAction    String?
  investigationNotes String?
  correctiveActions  String[]  @default([])
  rootCause          String?
  carfCategory       String?
  /// Required when status = filed_in_error (incidents are never deleted)
  errorExplanation   String?
  /// Legacy module item id (INC-...) for the idempotent blob copy
  legacySourceId     String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([organizationId, incidentNumber])
  @@unique([organizationId, legacySourceId])
  @@index([organizationId, reportedDate])
  @@index([reporterUserId])
  @@index([assignedToUserId])
  @@index([clientId])
}

