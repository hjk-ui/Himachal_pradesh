/// Payer name / aliases -> Waystar payer ID. organizationId '*' rows apply to every organization.
model WaystarPayerMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @default("*") @map("organization_id")
  payerName          String   @map("payer_name")
  aliases            String[] @default([])
  waystarPayerId     String   @map("waystar_payer_id") @db.VarChar(15)
  /// SBR09 claim filing indicator (MC, MB, BL, CI, HM, ...)
  claimFilingCode    String   @map("claim_filing_code") @db.VarChar(2)
  /// 95 | GT | both | none
  telehealthModifier String   @default("95") @map("telehealth_modifier") @db.VarChar(4)
  requiresPriorAuth  Boolean  @default(false) @map("requires_prior_auth")
  /// Claims for a pre-licensed (supervised) clinician: render_as_supervisor | supervisee_with_2310D | not_allowed
  superviseeClaims   String   @default("supervisee_with_2310D") @map("supervisee_claims") @db.VarChar(24)
  /// Taxonomy (PRV) required on 2000A and 2310B: missing taxonomy is an error instead of a warning
  requireTaxonomy    Boolean  @default(false) @map("require_taxonomy")
  /// Audio-only telehealth modifier: 93 | FQ | none | not_allowed (not_allowed blocks audio-only claims)
  audioOnlyModifier  String   @default("not_allowed") @map("audio_only_modifier") @db.VarChar(12)
  /// Timely filing limit in days from the date of service (null = not configured; verify against the contract)
  filingLimitDays    Int?     @map("filing_limit_days")
  /// false until the ID is confirmed on Waystar's payer list; blocks production (ISA15=P) sends
  verified           Boolean  @default(false)
  notes              String?
  active             Boolean  @default(true)
  updatedBy          String?  @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, payerName])
  @@map("waystar_payer_mappings")
}

