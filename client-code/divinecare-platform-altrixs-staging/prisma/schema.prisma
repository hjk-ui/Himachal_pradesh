  IN_HOUSE
}

/// Per-org orderable lab tests (20261018_lab_catalog). Merged over the built-in catalog in
/// src/lib/labs/catalog.ts by `key`; codes are only stored when verified (see docs/labs.md).
model LabTest {
  id              String   @id @default(cuid())
  organizationId  String
  /// Catalog key (built-in key when the test maps to one, else a slug of the name)
  key             String
