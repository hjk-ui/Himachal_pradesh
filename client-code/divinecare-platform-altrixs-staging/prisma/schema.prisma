/// Every Rcopia API call and SSO launch (GM6 / GM12 / GM13). Payloads contain PHI: stored only
/// AES-256-GCM encrypted (PHI_FIELD_ENCRYPTION_KEY), credentials and the SSO MAC removed first,
/// read only by ADMIN through /api/drfirst/logs, purged after DRFIRST_LOG_RETENTION_DAYS (90).
model DrFirstApiLog {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  /// 'api' | 'sso'
  kind             String
  command          String
  servlet          String?
  practiceUsername String?  @map("practice_username")
  rcopiaUsername   String?  @map("rcopia_username")
  organizationId   String?  @map("organization_id")
  actorUserId      String?  @map("actor_user_id")
  ok               Boolean
  httpStatus       Int?     @map("http_status")
  status           String?
  errorCode        String?  @map("error_code")
  errorText        String?  @map("error_text")
  durationMs       Int?     @map("duration_ms")
  /// 'response' (answered calls) | 'request' (connection failures) | 'sso_url' | null (not stored)
  payloadKind      String?  @map("payload_kind")
  payloadEncrypted String?  @map("payload_encrypted") @db.Text

  @@index([createdAt])
  @@index([kind, command, createdAt])
  @@map("drfirst_api_logs")
}

/// Poll throttle per command + scope (GM8 / DR2: update_* every 5 min; NCDM1: get_notification_count
/// every 15 min) with the last answer for callers that are throttled.
model DrFirstPollState {
  key          String   @id
  lastCalledAt DateTime @map("last_called_at")
  payload      Json?

  @@map("drfirst_poll_state")
}

