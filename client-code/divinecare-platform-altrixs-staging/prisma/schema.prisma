/// Clearinghouse Telemetry Connections
model MedicalClearinghouseStatus {
  id          String   @id @default(cuid())
  name        String   @unique
  status      String   // "connected" | "warning" | "disconnected"
  warningMsg  String?  @default("")
  lastTx      String   @default("")
  claimsMTD   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// CARF-Accredited Mobile Crisis Response Episodes
model CrisisEpisode {
  id                String    @id @default(cuid())
  organizationId    String?
  episodeNumber     String    @unique // e.g. "MC-2026-0147"
  clientId          String?
  clientName        String
  location          String
  callerName        String?
  callerRelationship String?
  priority          Int       @default(2) // 1, 2, 3
  status            String    @default("dispatched") // dispatched, enroute, onscene, resolved, closed
  assignedTeam      String    // e.g. "Crisis Unit 1 — North"
  teamMembers       String    // e.g. "K. Osei, LCSW-C + T. Nguyen, CPRS"
  startedAt         DateTime  @default(now())
  dispatchedAt      String    // "HH:MM"
  arrivedAt         String?   // "HH:MM"
  resolvedAt        String?   // "HH:MM"
  responseMinutes   Int?
  disposition       String?
  interventions     String[]  @default([])
  mseAppearance     String?
  mseMood           String?
  mseThought        String?
  mseOrientation    String?
  lraNarrative      String?   @db.Text
  clientVoice       String?   @db.Text
  docComplete       Boolean   @default(false)
  notificationsSent Boolean   @default(false)
  followUp24hStatus String    @default("pending") // pending, scheduled, completed
  followUp24hDate   DateTime?
  followUp72hStatus String    @default("pending")
  followUp72hDate   DateTime?
  chargeRouted      Boolean   @default(false)
  timeline          Json      @default("[]") // Array of { time, label, note, kind }
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([startedAt])
}

/// CARF-Accredited Crisis Team Paging Telemetry (AWS Pinpoint SMS + Mobile Push + SNS Supervisor Alert)
model CrisisTeamPage {
  id                  String    @id @default(cuid())
  organizationId      String?
  episodeId           String?
  episodeNumber       String?
  pagedBy             String?   @default("on_call_dispatcher")
  trigger             String    // "manual_override" | "triage_dispatch" | "repage_action"
  assignedTeam        String    // e.g. "Crisis Unit 1 — Central"
  smsDelivered        Boolean   @default(true)
  pushDelivered       Boolean   @default(true)
  snsDelivered        Boolean   @default(true)
  respondersAck       Int       @default(2)
  respondersTotal     Int       @default(2)
  supervisorNotified  Boolean   @default(true)
  deliveryStatus      String    @default("acknowledged") // "sent" | "acknowledged" | "failed"
  pagedAt             DateTime  @default(now())
  secureEpisodeLink   String?   // Zero-PHI URL: e.g. "/dashboard/crisis?episode=MC-2026-0147"
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([episodeId])
  @@index([trigger])
  @@index([pagedAt])
}


/// Residential Treatment Program (ASAM 3.1 & 3.5)
model ResidentialResident {
  id                String    @id @default(cuid())
  clientId          String?
  name              String
  program           String    // "3.1" | "3.5"
  room              String    // e.g. "B-201", "A-101"
  admitDate         DateTime  @default(now())
  counselor         String
  phase             String    @default("Admission")
  txPlanStatus      String    @default("current") // current, due, overdue
  orientationDone   Boolean   @default(false)
  asamScores        Json?     // { dim1, dim2, dim3, dim4, dim5, dim6 }
  overrideReason    String?
  paNumber          String?
  paUnitsRemaining  Int       @default(30)
  lastCsrDate       DateTime?
  nextCsrDate       DateTime?
  active            Boolean   @default(true)
