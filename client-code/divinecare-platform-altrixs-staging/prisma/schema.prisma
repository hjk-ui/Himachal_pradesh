generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PRACTICE_DIRECTOR
  DIRECTOR
  OFFICE_MANAGER
  THERAPIST
  PSYCHIATRIST
  NP
  PRP_SPECIALIST
  CASE_MANAGER
  PEER_SUPPORT
  CLINICIAN
  FRONT_DESK
  BILLING
  HR
  PHYSICIAN
  MEDICAL_NP
  MEDICAL_ASSISTANT
  CRISIS_RESPONDER
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum OtpPurpose {
  LOGIN
  RESET_PASSWORD
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_SESSION
  COMPLETED
  CANCELLED
  NO_SHOW
  LATE_CANCEL
}

enum AppointmentNoteStatus {
  NOT_STARTED
  AI_DRAFT
  IN_PROGRESS
  SIGNED
}

enum ProgressNoteWorkflowStatus {
  DRAFT
  SIGNED
  LOCKED
}

enum WaitlistStatus {
  WAITING
  MATCHED
  SCHEDULED
  CLOSED
}

enum WaitlistUrgency {
  ROUTINE
  URGENT
  CRISIS
}

enum IntakeInviteStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum ConsentFormStatus {
  PENDING
  SIGNED
  EXPIRED
  DECLINED
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  NEEDS_REVIEW
  EXPIRED
  CLOSED
}

enum EligibilityCheckStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  ERROR
}

enum PriorAuthStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DENIED
  EXPIRED
}

enum ClaimStatus {
  DRAFT
  READY
  SUBMITTED
  ACCEPTED
  DENIED
  PAID
}

enum ClaimDenialStatus {
  OPEN
  APPEALED
  WON
  LOST
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  INSURANCE
  STUB
}

enum StaffCredentialType {
  LICENSE
  CEU
  MALPRACTICE
  DEA
  CERTIFICATION
  BACKGROUND_CHECK
  SUPERVISION
  /// Maryland CDS (controlled dangerous substances) registration, prescribers. 20261022_hr_standard.sql
  CDS
  BOARD_CERTIFICATION
  /// CPR / BLS card (PRP, crisis, medical roles per practice policy)
  CPR_BLS
}

enum StaffCredentialStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PENDING_RENEWAL
}

enum MessageSender {
  STAFF
  CLIENT
}

enum MessageThreadTopic {
  SCHEDULING
  BILLING
  GENERAL
  CLINICAL
  RX_REFILL
}

enum MessageThreadStatus {
  WAITING
  IN_PROGRESS
  FORWARDED
  RESOLVED
}

enum ThreadMessageSender {
  FRONT_OFFICE
  PATIENT
  CLINICIAN_NOTE
}

enum TelehealthSessionStatus {
  UPCOMING
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TelehealthPlatform {
  ZOOM
  DOXY
  GOOGLE
  TEAMS
  PHONE
  CHIME
}

/// Practice / clinic group (tenant root for multi-location)
model Organization {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  active    Boolean    @default(true)
  /// Next sequence value for clinic MRN generation (atomic increment on assign)
  mrnNextSequence Int  @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
  users     User[]
  clients   Client[]
  waitlistEntries WaitlistEntry[]
  intakeInvites   IntakeInvite[]
  consentForms    ConsentForm[]
  moduleStates    ClinicModuleState[]
  treatmentPlans  TreatmentPlan[]
  eligibilityChecks EligibilityCheck[]
  priorAuths      PriorAuth[]
  claims          Claim[]
  claimDenials    ClaimDenial[]
  payments        Payment[]
  autopayEnrollments AutopayEnrollment[]
  staffCredentials StaffCredential[]
  staffHrProfiles  StaffHrProfile[]
  hrPayrollRuns    HrPayrollRun[]
  hrBenefitPlans   HrBenefitPlan[]
  hrLeaveRequests  HrLeaveRequest[]
  hrPtoBalances    HrPtoBalance[]
  hrJobRequisitions HrJobRequisition[]
  hrComplianceItems HrComplianceItem[]
  hrCeuProgress    HrCeuProgress[]
  hrOrgSnapshot    HrOrgSnapshot?
  hrDirectDeposit  HrDirectDepositSetting?
  hrHeadcountPoints HrHeadcountPoint[]
  hrTurnoverPoints HrTurnoverPoint[]
  hrDeptCompRows   HrDeptCompensation[]
  supervisionLogs  SupervisionLog[]
  supervisionTracks SupervisionTrack[]
  riskAlerts      RiskAlert[]
  appointments    Appointment[]
  messageThreads  MessageThread[]
  telehealthSessions TelehealthSession[]
  telehealthSettings TelehealthSettings?
  communityEvents     CommunityEvent[]
  communityPartners   CommunityPartner[]
  communityVolunteers CommunityVolunteer[]
  communityReferrals  CommunityReferral[]
  prMetrics           PrOrgMetrics?
  prChannels          PrSocialChannel[]
  prBrandAssets       PrBrandAsset[]
  prBrandColors       PrBrandColor[]
  prCoverage          PrMediaCoverage[]
  prReleases          PrPressRelease[]
  prCampaigns         PrCampaign[]
  clinicalAssessments ClinicalAssessmentRecord[]
  clinicalEvaluations ClinicalEvaluationRecord[]
  locusAssessments    LocusAssessmentRecord[]
  mandatoryReports    MandatoryReportRecord[]
  mbcAlertAcks        MbcAlertAck[]
  prPosts             PrSocialPost[]
  migrationJobs       MigrationJob[]
  tmsCourses          TmsCourse[]
  spravatoEnrollments SpravatoEnrollment[]
  prpReferrals        PrpReferral[]
  prpEnrollments      PrpEnrollment[]
  sensitiveRecords    SensitiveRecord[]
  sensitiveAccessLogs SensitiveAccessLog[]
  breakTheGlassGrants BreakTheGlassGrant[]
  schedulingSettings  SchedulingSettings?
  labOrders           LabOrder[]
  patientStatements   PatientStatement[]
  claimScrubResults   ClaimScrubResult[]
  connectMessages     ConnectMessage[]
  connectCalls        ConnectCall[]
  scribeSessions      ScribeSession[]
  healthLakeJobs      HealthLakeJob[]
  textractJobs        TextractJob[]
  clinicalEvents      ClinicalEvent[]
  personalizeCaches   PersonalizeInsightCache[]
  medicalPatients     MedicalPatient[]
  medicalCharges      MedicalCharge[]
  payerRegistries     PayerRegistry[]
  billingRules        BillingRule[]
  projectTasks        ProjectTask[]
  teamAlerts          TeamAlert[]
  practiceSettings    PracticeSettings?
  practiceBaas        PracticeBaa[]
}

/// Physical or virtual site under an organization
model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  phone          String?
  fax            String?
  /// Service-facility NPI (Type 2) when this site has its own; null = bill under the billing provider
  npi            String?      @db.VarChar(10)
  /// Billing confirmed `npi` on NPPES for this site; only then is it sent in 837P 2310C (20261019_rcm_blockers)
  npiVerified    Boolean      @default(false)
  /// Default CMS place-of-service code for in-person visits here (e.g. 11 office)
  posCode        String?      @db.VarChar(2)
  /// Business hours { mon: { enabled, start, end }, ... } (display / scheduling only)
  businessHours  Json?
  timezone       String       @default("America/New_York")
  active         Boolean      @default(true)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  staffMemberships UserLocation[]
  primaryStaff     User[]         @relation("UserPrimaryLocation")
  clients          Client[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// Staff assigned to one or more locations
model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  passwordHash     String?
  /// Clinician callback / Amazon Connect bridge number (E.164)
  phone            String?
  /// Primary / default role (also used as login active role)
  role             Role       @default(CLINICIAN)
  /// Extra roles this user may switch into (always includes `role` after normalize)
  roles            Role[]     @default([])
  status           UserStatus @default(ACTIVE)
  image            String?
  /// Tenant org — null only for SUPER_ADMIN (platform-wide)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// National Provider Identifier (10 digits when set)
  npi              String?
  /// DrFirst Rcopia provider username. SSO launches only ever sign as this value.
  rcopiaUsername   String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  /// Legal name as enrolled with NPPES / payers (837P NM1 rendering / supervising provider). Never parsed from `name`.
  legalFirstName   String?
  legalLastName    String?
  /// Credentials shown after the name, e.g. LCSW-C (display only; not sent in NM1)
  credentials      String?
  /// NUCC provider taxonomy (837P 2310B PRV*PE), e.g. 101YP2500X
  taxonomyCode     String?    @db.VarChar(10)
  /// LICENSED | PRE_LICENSED set in HR (null = derived from credentials / supervision track).
  /// Pre-licensed authors need a supervisor signature on treatment plans and notes.
  licenseLevel     String?
  /// Medical Director designation (prescriber roles only: PSYCHIATRIST / NP / PHYSICIAN / MEDICAL_NP).
  /// Org-wide patient scope + supervisor co-sign + clinical oversight pages; no Part 2 / VIP bypass.
  /// Set by ADMIN / PRACTICE_DIRECTOR only (src/lib/staff/manage.ts); see src/lib/auth/medicalDirector.ts.
  isMedicalDirector    Boolean @default(false)
  /// Optional scope note, e.g. "Primary care" or "Behavioral health"
  medicalDirectorScope String?
  /// Staff sign-in lockout (migration 20261024_staff_mfa_lockout.sql): 5 wrong passwords -> 15 min lock
  failedLoginCount     Int       @default(0)
  loginLockedUntil     DateTime?
  /// Two-factor (TOTP authenticator app) — secrets encrypted with PHI_FIELD_ENCRYPTION_KEY (fieldCrypto v1)
  mfaSecretEnc         String?
  /// Secret shown during enrollment, until the first code confirms it
  mfaPendingSecretEnc  String?
  mfaEnabledAt         DateTime?
  /// Last accepted TOTP time step (a code is never accepted twice)
  mfaLastUsedStep      Int?
  /// One-time recovery codes: "<salt>:<sha256>" each, removed when used
  mfaRecoveryCodes     String[]  @default([])
  /// 5 wrong 2FA codes -> 15 min lock
  mfaFailedCount       Int       @default(0)
  mfaLockedUntil       DateTime?
  /// Huddle sheet evening email opt-out (20261027_huddle_email_notice.sql); null = on (default)
  huddleEmailOptOutAt  DateTime?
  /// sha256 of the nonce in the current sign-in ticket (single use; rotated each step)
  mfaTicketNonceHash   String?
  mfaTrustedDevices    MfaTrustedDevice[]
  /// SHA-256 of raw invite token (only while status = INVITED)
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  invitedById      String?
  invitedBy        User?      @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitesSent      User[]     @relation("UserInvites")
  primaryLocationId String?
  primaryLocation   Location? @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  locations         UserLocation[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clientsAssigned Client[]      @relation("ClientAssignee")
  appointments    Appointment[] @relation("AppointmentClinician")
  progressNotes   ProgressNote[] @relation("ProgressNoteClinician")
  waitlistMatches WaitlistEntry[] @relation("WaitlistClinician")
  intakeInvitesCreated IntakeInvite[] @relation("IntakeInviteCreator")
  intakeInvitesAssigned IntakeInvite[] @relation("IntakeInviteAssignee")
  treatmentPlans   TreatmentPlan[] @relation("TreatmentPlanClinician")
  eligibilityChecks EligibilityCheck[] @relation("EligibilityCheckedBy")
  priorAuthsCreated PriorAuth[] @relation("PriorAuthCreatedBy")
  staffCredentials StaffCredential[]
  staffHrProfile   StaffHrProfile?
  hrLeaveRequests  HrLeaveRequest[]
  hrPtoBalance     HrPtoBalance?
  hrCeuProgress    HrCeuProgress?
  supervisionAsSupervisor SupervisionLog[] @relation("SupervisionSupervisor")
  supervisionAsSupervisee SupervisionLog[] @relation("SupervisionSupervisee")
  supervisionTracksAsSupervisor SupervisionTrack[] @relation("SupervisionTrackSupervisor")
  supervisionTracksAsSupervisee SupervisionTrack[] @relation("SupervisionTrackSupervisee")
  riskAlertsClinician RiskAlert[] @relation("RiskAlertClinician")
  riskAlertsReviewed  RiskAlert[] @relation("RiskAlertReviewedBy")
  prescribedMedications ClientMedication[] @relation("ClientMedicationPrescriber")
  recordedVitals       MedicalVital[]     @relation("MedicalVitalRecorder")
  conductedVisits      MedicalVisit[]     @relation("MedicalVisitProvider")
  targetedTeamAlerts   TeamAlert[]        @relation("TeamAlertTarget")
  authoredTeamAlerts   TeamAlert[]        @relation("TeamAlertAuthor")
  resolvedTeamAlerts   TeamAlert[]        @relation("TeamAlertResolver")

  @@index([status])
  @@index([inviteTokenHash])
  @@index([primaryLocationId])
  @@index([organizationId])
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  /// Wrong guesses against this code; the code is void after 5
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@index([email, createdAt])
}

/// "Remember this device for 30 days" after a 2FA challenge (signed httpOnly cookie altrixs_mfa_device).
/// Revoked by an admin 2FA reset or a password change/reset. Migration 20261024_staff_mfa_lockout.sql
model MfaTrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Browser label from the user agent (e.g. "Chrome on Windows"), display only
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

/// Clinical client (patient) record used by the staff portal
model Client {
  id            String       @id @default(cuid())
  name          String
  email         String?      @unique
  phone         String?
  image         String?
  /// @deprecated prefer status — kept in sync for older queries
  active        Boolean      @default(true)
  status        ClientStatus @default(ACTIVE)
  riskLevel     RiskLevel    @default(LOW)
  checkInStreak Int          @default(0)

  /// Tenant — set on create; used for org-scoped MRN uniqueness
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Medical Record Number — unique per organization (e.g. ALT-CLIN-2026-000142)
  mrn            String?

  /// EHR migration provenance
  sourcePlatform String?
  sourceId       String?
  importedAt     DateTime?
  /// Valant client export assigned-facility value exactly as exported (facility Id, or the facility's
  /// Name = billing entity). Resolved against the facility list at read time; never derived from the
  /// city. Migration 20261019_client_valant_facility.sql
  valantFacility String?

  /// Created through primary-care intake (Silver Spring / Bowie). One of the primary-care
  /// patient signals (src/lib/medical/medicalProgram.ts); never inferred from location.
  primaryCare    Boolean   @default(false)

  /// Demographics (intake)
  dateOfBirth           DateTime?
  gender                String?
  addressLine1          String?
  addressLine2          String?
  /// No street address on file: 'homeless' | 'unknown'. DrFirst send_patient then sends Address Line 1
  /// "HOMELESS" / "UNKNOWN" with the clinic's city / state / ZIP (DrFirst PDUM2). 20261020_drfirst_certification.sql
  addressStatus         String?
  city                  String?
  state                 String?
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?

  /// Insurance (intake)
  insurancePayer        String?
  insuranceMemberId     String?
  insuranceGroupNumber  String?
  /// Primary insurance detail (Valant Ins1 export)
  insuranceType          String?   // Medicaid, Medicare, Commercial, Blue Shield, Tricare...
  insuranceCoverageType  String?   // Group, Nongroup, Supplement
  insurancePayerPhone    String?
  insuranceEffectiveFrom DateTime?
  insuranceEffectiveTo   DateTime?
  copayAmount            Decimal?  @db.Decimal(10, 2)
  phoneSecondary         String?

  /// Multi-disciplinary treatment team (warm handoff slots) — JSON TreatmentTeam shape
  treatmentTeam         Json?
  /// Last CRISP / HIE SMART launch timestamp
  hieLastQueryAt        DateTime?

  /// Diagnosis (intake) — primary ICD-10 / DSM
  primaryDiagnosis      String?
  primaryDiagnosisCode  String?
  secondaryDiagnoses    String?

  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?     @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedSince DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checkIns     CheckIn[]
  appointments Appointment[]
  progressNotes ProgressNote[]
  alerts       RiskAlert[]
  messages     Message[]
  messageThreads MessageThread[]
  telehealthSessions TelehealthSession[]
  waitlistConversions WaitlistEntry[] @relation("WaitlistConvertedClient")
  intakeInvites       IntakeInvite[]
  consentForms        ConsentForm[]
  treatmentPlans      TreatmentPlan[]
  eligibilityChecks   EligibilityCheck[]
  priorAuths          PriorAuth[]
  claims              Claim[]
  payments            Payment[]
  autopayEnrollment   AutopayEnrollment?
  /// Valant reference-only imports (never posted to the ledger)
  valantAgingSnapshots ValantAgingSnapshot[]
  valantCombinedAgingRows ValantCombinedAgingRow[]
  valantTransactions  ValantTransaction[]
  valantPrepaymentTxns ValantPrepaymentTxn[]
  /// Patient ledger entries (Valant opening balances, prepayment credits); see PatientLedgerEntry
  patientLedgerEntries PatientLedgerEntry[]
  copayRules          ClientCopayRule[]
  patientAccount      PatientAccount?
  clinicalAssessments ClinicalAssessmentRecord[]
  clinicalEvaluations ClinicalEvaluationRecord[]
  locusAssessments    LocusAssessmentRecord[]
  mandatoryReports    MandatoryReportRecord[]
  mbcAlertAcks        MbcAlertAck[]
  deviceTokens        DeviceToken[]
  medicationSchedules MedicationSchedule[]
  medicationIntakeLogs MedicationIntakeLog[]
  notificationLogs    NotificationLog[]
  tmsCourses          TmsCourse[]
  spravatoEnrollments SpravatoEnrollment[]
  prpReferrals        PrpReferral[]
  prpEnrollments      PrpEnrollment[]
  sensitiveRecord     SensitiveRecord?
  sensitiveAccessLogs SensitiveAccessLog[]
  breakTheGlassGrants BreakTheGlassGrant[]
  labOrders           LabOrder[]
  patientStatements   PatientStatement[]
  connectMessages     ConnectMessage[]
  connectCalls        ConnectCall[]
  scribeSessions      ScribeSession[]
  medications         ClientMedication[]
  medicalProblems     MedicalProblem[]
  medicalVitals       MedicalVital[]
  medicalVisits       MedicalVisit[]
  medicalCharges      MedicalCharge[]
  teamAlerts          TeamAlert[]
  treatmentTeamMembers ClientTreatmentTeamMember[]
  medicalAllergies    MedicalAllergy[]
  sudScreenings       SudScreening[]
  cardOnFile          CardOnFile?
  statements          EStatement[]
  radarSignals        SudRadarSignal[]
  legalFirstName      String?
  middleInitial       String?
  legalLastName       String?
  /// Preferred name (Valant name format: "Preferred [First] M. Last, Suffix (ID)")
  preferredName       String?
  /// Title the client uses (Mr. | Ms. | Mrs. | Mx. | Dr.); null = full name only. Set from the note's
  /// Identifying Information "Update chart demographics" (audited). 20261025_identifying_info.sql
  namePrefix          String?
  /// Name suffix (Jr., Sr., III …)
  nameSuffix          String?
  rcopiaPatientId     String?

  /// ── Standard demographics (20261019_client_demographics_standard.sql) ──────────────────────
  /// Code sets and checks: src/lib/clients/demographics.ts. All nullable: never defaulted or guessed.
  /// Full legal middle name (middleInitial stays the one-letter form used in DrFirst / X12 NM105)
  legalMiddleName              String?
  /// The legal first / last name could not be split deterministically (import / backfill): staff confirm
  needsNameReview              Boolean   @default(false)
  nameReviewReason             String?
  /// HL7 AdministrativeGender as X12 DMG03 / Rcopia Sex: F | M | U (sex on the insurance card / legal ID)
  administrativeSex            String?
  /// US Core birth sex: F | M | ASKU (declined) | UNK
  sexAtBirth                   String?
  /// USCDI gender identity: SNOMED CT code, or ASKU | UNK | OTH
  genderIdentity               String?
  /// USCDI sexual orientation: SNOMED CT code, or ASKU | UNK | OTH
  sexualOrientation            String?
  /// Pronouns: LOINC answer (LL5144-2) code, or ASKU | OTH
  pronouns                     String?
  /// OMB race categories as CDC race codes (multi-select), or ['ASKU'] declined / ['UNK']
  race                         String[]  @default([])
  /// OMB ethnicity: 2135-2 Hispanic or Latino | 2186-5 Not Hispanic or Latino | ASKU | UNK
  ethnicity                    String?
  /// Preferred language: ISO 639-1 code (639-3 when there is no 2-letter code, e.g. ase = ASL)
  preferredLanguage            String?
  interpreterNeeded            Boolean?
  /// HL7 v3 MaritalStatus: A D I L M P S T U W, or UNK
  maritalStatus                String?
  county                       String?
  /// mobile | home | work, for Client.phone and Client.phoneSecondary
  phoneType                    String?
  phoneSecondaryType           String?
  /// HL7 v3 RoleCode (SPS, PRN, CHILD, SIB, FRND, GUARD, ...)
  emergencyContactRelationship String?
  /// Legal guardian / personal representative (minors, court-appointed guardianship)
  guardianName                 String?
  guardianRelationship         String?
  guardianPhone                String?
  /// Consent library intake (20261019_consent_library.sql): guardian email + authority, "has a guardian"
  guardianEmail                String?
  guardianAuthority            String?
  hasGuardian                  Boolean?
  /// SSN is OPTIONAL (review note 4). Full number only AES-256-GCM encrypted (PHI_FIELD_ENCRYPTION_KEY);
  /// the UI shows ***-**-last4; reveal is role-limited and audited (src/lib/clients/ssn.ts)
  ssnEncrypted                 String?
  ssnLast4                     String?
  /// Intake "What service are you interested in?" (src/lib/consents/library/composer.ts SERVICES_INTERESTED)
  servicesInterested           String[] @default([])
  /// Guarantor (responsible party for the patient balance); all null = the patient is the guarantor
  guarantorFirstName           String?
  guarantorLastName            String?
  guarantorRelationship        String?
  guarantorDateOfBirth         DateTime? @db.Date
  guarantorPhone               String?
  guarantorAddressLine1        String?
  guarantorAddressLine2        String?
  guarantorCity                String?
  guarantorState               String?
  guarantorPostalCode          String?
  /// Maryland Medical Assistance (Medicaid) recipient number, 11 digits
  medicaidId                   String?
  deceasedAt                   DateTime?

  officeNotes                ClientOfficeNote[]
  prpWorkflows               PrpWorkflow[]
  documentIntakes            DocumentIntake[]
  paymentPlans               PaymentPlan[]
  rcopiaPrescriptions        RcopiaPrescription[]
  rcopiaRxfillEvents         RcopiaRxfillEvent[]
  rcopiaRxchangeRequests     RcopiaRxchangeRequest[]
  rcopiaRefillNotifications  RcopiaRefillNotification[]
  marylandPdmpAudits         MarylandPdmpAudit[]
  rcopiaMedRecAttestations   RcopiaMedRecAttestation[]
  ehrPrescriptions           EhrPrescription[]
  ehrRefillRequests          EhrRefillRequest[]
  /// TCPA: SMS only with express consent (20261019_scheduling_fixes.sql). Source: intake | portal |
  /// staff_verbal | online_booking | sms_unstop. Never SMS while smsConsent is false or smsOptOutAt is set.
  smsConsent          Boolean   @default(false)
  smsConsentAt        DateTime?
  smsConsentSource    String?
  /// Set by an inbound STOP (or staff); cleared by UNSTOP / START
  smsOptOutAt         DateTime?
  /// One-click email unsubscribe (appointment reminder emails)
  emailOptOutAt       DateTime?
  /// Online booking could not match name + DOB exactly (or the contact is already on another
  /// chart): front desk must verify identity / merge by hand. Never auto-merged.
  identityVerifyRequired Boolean @default(false)
  /// possible_duplicate_email | possible_duplicate_phone | possible_duplicate_name_dob | new_online_booking
  identityVerifyReason   String?
  /// Email typed at online booking when it is already on another chart (Client.email is unique)
  unverifiedEmail        String?
  /// Portal proxy rules (20261021_portal_proxy_access.sql): the minor consented to their own mental
  /// health treatment (Md. Health-General §20-104, 16+). A limited proxy then does not see mental
  /// health records (treatment plans, medications) unless an item is marked shared with the guardian.
  portalMinorSelfConsentMh      Boolean                    @default(false)
  portalMinorSelfConsentSetAt   DateTime?
  portalMinorSelfConsentSetById String?
  portalAccess                  PortalAccess[]
  portalItemVisibility          PortalItemVisibility[]

  @@unique([organizationId, mrn])
  @@unique([organizationId, sourcePlatform, sourceId])
  @@index([organizationId])
  @@index([mrn])
  @@index([active])
  @@index([status])
  @@index([assignedToId])
  @@index([riskLevel])
  @@index([locationId])
  @@index([sourcePlatform, sourceId])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
}

enum PatientAccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Patient portal USER (login identity) for the web portal and the mobile app — never a staff User /
/// dashboard session. One email = one portal user. clientId is the client's OWN chart when the login
/// belongs to the client ('self'); it is null for a guardian / representative-only login.
/// Which charts the login may open is PortalAccess (self link + proxy links). 20261021_portal_proxy_access.sql
model PatientAccount {
  id               String               @id @default(cuid())
  clientId           String?              @unique
  client             Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email            String               @unique
  /// Name of the person who signs in (guardian logins have no chart of their own); shown on messages
  /// and signatures made as a representative
  displayName        String?
  passwordHash     String?
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  status           PatientAccountStatus @default(INVITED)
  /// MFA-ready: set when a second factor is enrolled (enrollment flow not built yet)
  mfaMethod          String?
  mfaEnrolledAt      DateTime?
  /// Last chart this login viewed (default person after sign-in)
  lastActiveClientId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  portalAccess PortalAccess[]

  @@index([inviteTokenHash])
  @@index([status])
}

/// Which client charts a portal user may open, and as whom (Epic MyChart proxy model).
/// relationship: self | parent | legal_guardian | authorized_representative
/// accessLevel:  full | limited (limited hides minor-consented mental health records; confidential and
/// 42 CFR Part 2 items are hidden from every proxy). Rules: src/patient/domain/proxy-policy.ts.
/// A proxy link is usable only once verified (staff recorded the authority check), and ends at
/// revokedAt / expiresAt / the client's 18th birthday for links granted while the client was a minor.
model PortalAccess {
  id                 String         @id @default(cuid())
  portalUserId       String
  portalUser         PatientAccount @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId     String?
  relationship       String
  accessLevel        String         @default("full")
  /// Why this level (required for adults with a representative, and for overrides of the age default)
  accessLevelReason  String?
  /// Granted while the client was under 18: ends automatically at 18 (parent / guardian of a minor)
  minorAtGrant       Boolean        @default(false)
  grantedById        String?
  grantedAt          DateTime       @default(now())
  /// Verification of authority (staff): photo ID checked + relationship + legal document when needed
  verifiedAt         DateTime?
  verifiedById       String?
  /// photo_id_in_person | photo_id_video | birth_certificate | custody_order | guardianship_order |
  /// power_of_attorney | health_care_agent | self_identity
  verificationMethod String?
  /// Reference to the scanned document (document intake id / file name); never the document itself
  legalDocumentRef   String?
  verificationNote   String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedById        String?
  revokeReason       String?
  /// revoked | aged_out | expired
  endedReason        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([portalUserId, clientId])
  @@index([clientId])
  @@index([organizationId])
  @@index([revokedAt])
  @@map("portal_access")
}

/// Clinician / staff decision on one portal item for proxies: confidential (hidden from every proxy)
/// or shared_with_guardian (shown to proxies even when the category default hides it).
/// itemType: treatment_plan | consent_packet | carelon_attestation | consent_form | resource |
/// appointment | message_thread
model PortalItemVisibility {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itemType       String
  itemId         String
  visibility     String
  reason         String?
  setById        String?
  setAt          DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([itemType, itemId])
  @@index([clientId, itemType])
  @@map("portal_item_visibility")
}

/// Patient app audit — no PHI / message text
model PatientAuditLog {
  id         String   @id @default(cuid())
  clientId   String
  accountId  String?
  action     String
  entityType String?
  entityId   String?
  /// Proxy access: the PortalAccess link used and the relationship (self rows leave both null)
  portalAccessId String?
  relationship   String?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([action])
}

model CheckIn {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mood      Int
  stress    Int
  sleep     Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Appointment {
  id           String                @id @default(cuid())
  clientId     String
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Denormalized for board display / seed snapshots
  clientName   String?
  clinicianId  String?
  clinician    User?                 @relation("AppointmentClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  clinicianName String?
  organizationId String?
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type         String
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus     @default(SCHEDULED)
  noteStatus   AppointmentNoteStatus @default(NOT_STARTED)
  isVirtual    Boolean               @default(false)
  notes        String?
  patientBooked Boolean              @default(false)
  /// Public self-schedule confirmation e.g. AC-123456
  confirmationCode String?           @unique
  insurancePayer String?
  memberId     String?
  /// zoom | meet | phone | doxy when booked as telehealth
  telehealthPlatform String?
  joinUrl      String?
  rescheduleRequestedAt DateTime?
  rescheduleNote String?
  /// Recurring series this visit belongs to (20261019_scheduling_fixes.sql)
  seriesId     String?
  series       AppointmentSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Telehealth by phone only (no video): notes / claims default their audio-only flag from this
  audioOnly    Boolean               @default(false)
  /// Patient confirmed (reply C to a reminder, or staff)
  confirmedAt  DateTime?
  /// Intentional overbook: staff reason when booked over another visit for the same clinician
  overbookReason String?
  /// Telehealth: where the patient said they are (home | other) and the state; drives POS 10/02
  patientLocationType  String?
  patientLocationState String?
  /// Practice location (SQL-only table practice_locations; FK in SQL, not modeled as a relation).
  /// 20261015_practice_locations.sql: VARCHAR(50) DEFAULT 'bowie' REFERENCES practice_locations(id)
  locationId   String?               @default("bowie") @map("location_id") @db.VarChar(50)
  /// AppointmentLabel id (FK "Appointment_labelId_fkey" ON DELETE SET NULL in SQL, not modeled
  /// as a relation). 20261018_appointment_labels.sql
  labelId      String?
  /// Group occurrence this per-member visit belongs to (clinical_group_sessions; FK in SQL,
  /// not modeled as a relation). 20261019_group_sessions.sql
  groupSessionId String?
  /// Who put the visit on the schedule (20261022_appointment_booked_by.sql). Plain ids, no FK.
  createdById    String?
  createdByName  String?
  /// staff | online | portal | group | import
  createdVia     String?
  /// Last staff change (reschedule, reassign, status, details); null until first change
  lastChangedById   String?
  lastChangedByName String?
  lastChangedAt     DateTime?
  /// Imported history (20261025_valant_appointment_history.sql): 'valant_history' = Valant visit
  /// imported by scripts/import-valant-appointment-history.ts (no reminders, notes, charges or claims;
  /// excluded from missing-note queues and AutoPay). Null = booked in Altrixs.
  source       String?
  /// Stable import key (unique per organization) so re-running an import skips rows already imported
  externalKey  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  claims       Claim[]
  progressNotes ProgressNote[]       @relation("ProgressNoteAppointment")

  @@index([startsAt])
  @@index([clientId])
  @@index([clinicianId])
  @@index([clinicianId, startsAt])
  @@index([clinicianId, clientId])
  @@index([status])
  @@index([organizationId, startsAt])
  @@index([noteStatus])
  @@index([confirmationCode])
  @@index([clientId, startsAt])
  @@index([seriesId, startsAt])
  @@index([labelId])
  @@index([groupSessionId])
  @@unique([organizationId, externalKey])
}

/// Recurring appointment series (20261019_scheduling_fixes.sql). Occurrences are ordinary
/// Appointment rows with seriesId; times are practice wall clock (DST-safe), capped at 26
/// occurrences / 6 months.
model AppointmentSeries {
  id              String        @id @default(cuid())
  organizationId  String
  clientId        String
  clinicianId     String
  type            String
  /// weekly | biweekly | monthly
  frequency       String
  /// Weeks (weekly/biweekly) or months (monthly) between occurrences
  interval        Int           @default(1)
  /// 0=Sun..6=Sat (weekly / biweekly)
  byWeekday       Int[]         @default([])
  startDate       DateTime      @db.Date
  endDate         DateTime?     @db.Date
  count           Int?
  /// HH:mm practice wall clock
  startTime       String
  durationMinutes Int
  isVirtual       Boolean       @default(false)
  audioOnly       Boolean       @default(false)
  labelId         String?
  location        String?
  /// active | ended | cancelled
  status          String        @default("active")
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]

  @@index([organizationId, clientId])
  @@index([organizationId, clinicianId])
}

model ProgressNote {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clinicianId String?
  clinician   User?    @relation("ProgressNoteClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  body        String
  /// Note metadata (older notes keep it in a hidden comment at the top of body; read both)
  noteType        String?
  dateOfService   DateTime?
  durationMinutes Int?
  cptCode         String?
  placeOfService  String?
  telehealth      Boolean  @default(false)
  /// Telehealth by audio only (no video)
  audioOnly       Boolean  @default(false)
  /// Psychiatric E/M note: psychotherapy add-on (90833 / 90836 / 90838) billed as a second line
  addOnCptCode    String?
  /// Psychotherapy minutes documented separately from the E/M (required for the add-on)
  psychotherapyMinutes Int?
  part2           Boolean  @default(false)
  aiDrafted       Boolean  @default(false)
  /// Appointment the note was started from (claims cross-check clinician + date). 20261019_rcm_blockers
  appointmentId   String?
  appointment     Appointment? @relation("ProgressNoteAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  /// Unsigned note dismissed (never hard-deleted): out of every documentation queue, read-only
  /// for leadership / audit, undo by the author within 30 days. 20261023_note_dismiss.sql
  dismissedAt     DateTime?
  dismissedById   String?
  dismissedByName String?
  /// "Created in error", "Duplicate note", "Visit didn't happen", "Other: …" (+ details), min 5 chars
  dismissReason   String?
  /// AI Scribe audit evidence stamped at signing, before any transcript purge (src/lib/notes/aiEvidence.ts):
  /// { captureId, draftId, modelId, promptVersion, counts, sections: [{ heading, editRatio }], riskGate }. 20261024_scribe_safety_hardening.sql
  aiProvenance    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow    ProgressNoteWorkflow?
  claims      Claim[]
  addenda     ProgressNoteAddendum[]

  @@index([appointmentId])
  @@index([clientId, createdAt])
  @@index([clientId, dateOfService])
  @@index([createdAt])
  @@index([clinicianId])
  @@index([clinicianId, createdAt])
  @@index([dateOfService])
}

// ─── Progress note standard (src/lib/notes/standard.ts) ─────────────────────
// prisma/migrations/20261021_notes_standard.sql. Plain id columns (no relations) so the
// ProgressNote model is unchanged; rows are scoped through the note's client like the note.

/// Billing / compliance service details the claim needs that are not note text: session clock
/// times, telehealth modality and patient location, and the chart diagnoses this visit addressed
/// (ordered: first = primary pointer). Draft-only edits; frozen with the note once signed.
model ProgressNoteServiceDetail {
  noteId               String   @id
  /// HH:MM practice wall clock
  startTime            String?  @db.VarChar(5)
  endTime              String?  @db.VarChar(5)
  /// audio_video | audio_only (telehealth notes only)
  telehealthModality   String?
  /// home | other (drives POS 10 / 02)
  patientLocationType  String?
  patientLocationState String?  @db.VarChar(2)
  /// Clinician confirmed the client's telehealth consent is on file / given today
  telehealthConsent    Boolean?
  /// ICD-10-CM codes from the active chart diagnoses, in pointer order
  diagnosisCodes       String[] @default([])
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// PRP progress note contact fields (src/lib/prp/progressNote.ts; 20261027_prp_note_detail.sql).
/// Plain noteId (FK in SQL, no relation) so ProgressNote is unchanged. Draft-only edits.
model ProgressNotePrpDetail {
  noteId                      String    @id
  /// onsite | offsite
  location                    String?
  communityLocation           String?
  /// Always includes 'patient' (family, guardian, collateral, other_staff, other)
  participants                String[]  @default(["patient"])
  participantsOther           String?
  /// [{ key, label }] IRP objectives addressed (label snapshot)
  objectives                  Json      @default("[]")
  objectiveOther              String?
  interventions               String[]  @default([])
  progress                    String?
  collaboration               String[]  @default([])
  collaborationNote           String?
  /// signed | not_obtained
  patientSignatureStatus      String?
  patientSignatureName        String?
  patientSignedAt             DateTime?
  /// telehealth | declined | unable_symptoms | other
  patientSignatureReason      String?
  patientSignatureReasonOther String?
  updatedById                 String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@map("progress_note_prp_details")
}

/// Stamped when a note is signed: the practice's due rule at that moment and whether the
/// signature was a late entry ("Late entry — documented on X for service on Y").
model ProgressNoteTimeliness {
  noteId         String   @id
  organizationId String
  dueAt          DateTime
  signedAt       DateTime
  deadlineHours  Int
  lateEntry      Boolean  @default(false)
  label          String?
  /// Late entries: the clinician's reason, required at signing (min 10 characters)
  lateReason     String?
  createdAt      DateTime @default(now())

  @@index([organizationId, lateEntry])
}

/// HIPAA psychotherapy notes (45 CFR 164.501): the author's private process notes, kept apart
/// from the clinical record. Never printed, exported, released, copied forward or sent to AI;
/// only the author can read or edit them.
model ProgressNotePsychotherapyNote {
  noteId         String   @id
  organizationId String
  clientId       String
  authorId       String
  text           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([authorId])
}

/// Patient-requested amendment of the record (45 CFR 164.526): act within 60 days (one 30-day
/// extension), accept (amendment linked as an addendum) or deny in writing with the reason.
model NoteAmendmentRequest {
  id                     String    @id @default(cuid())
  organizationId         String
  clientId               String
  noteId                 String?
  /// Who asked: the client or their personal representative (name / relationship)
  requestedBy            String
  requestedOn            DateTime  @db.Date
  requestText            String
  /// PENDING | ACCEPTED | DENIED
  status                 String    @default("PENDING")
  dueOn                  DateTime  @db.Date
  extendedOn             DateTime? @db.Date
  extensionReason        String?
  decisionReason         String?
  decidedById            String?
  decidedByName          String?
  decidedAt              DateTime?
  addendumId             String?
  /// Client's statement of disagreement after a denial (164.526(d)(1)(iii))
  disagreementStatement  String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([clientId])
  @@index([noteId])
}

/// Documentation policy per organization (the sign deadline itself is
/// PracticeSettings.noteSignDeadlineHours). Defaults apply when there is no row.
model NotePolicySettings {
  organizationId         String   @id
  /// Drafts untouched this many days are flagged "stale" in the worklist
  staleDraftDays         Int      @default(14)
  /// Warn when a note is at least this % similar to the client's previous note (cloned note)
  cloneWarnPercent       Int      @default(85)
  /// Billable notes need at least one coded chart diagnosis linked before signing
  requireDiagnosisToSign Boolean  @default(true)
  /// Days between diagnosis-list reviews before the chart / note / plan shows "review due" (20261025_diagnosis_list.sql)
  diagnosisReviewDays    Int      @default(90)
  /// Practice date (YYYY-MM-DD) from which missing note-format elements block signing; warnings before. Null = 2026-11-16 (20261025_note_format_enforcement.sql)
  formatElementsEnforceFrom String?
  updatedById            String?
  updatedAt              DateTime @updatedAt
}

// ─── Client diagnosis list (src/lib/diagnoses) ──────────────────────────────
// prisma/migrations/20261025_diagnosis_list.sql. Plain id columns (no relations) so Client is
// unchanged. Client.primaryDiagnosis / primaryDiagnosisCode / secondaryDiagnoses are derived from
// the ACTIVE / PROVISIONAL rows (rank order) on every write.

/// One diagnosis on a client's list. Never deleted: resolved, ruled out or entered in error instead.
/// Exactly one primary per client (partial unique index in the migration).
model ClientDiagnosis {
  id                     String    @id @default(cuid())
  organizationId         String
  clientId               String
  /// ICD-10-CM display form ("F33.1"); null only for uncoded text carried over from the client record
  code                   String?
  /// ICD-10-CM long description (or the original text when uncoded)
  description            String
  /// DSM-5-TR diagnosis name when the clinician's wording differs from ICD-10-CM
  dsmName                String?
  /// 1 = primary; order of the list (claims pointer default)
  rank                   Int       @default(1)
  isPrimary              Boolean   @default(false)
  /// ACTIVE | PROVISIONAL | RULED_OUT | RESOLVED | ENTERED_IN_ERROR
  status                 String    @default("ACTIVE")
  onsetDate              DateTime? @db.Date
  resolvedDate           DateTime? @db.Date
  /// Why it was resolved / ruled out / marked entered in error
  statusReason           String?
  diagnosingProviderId   String?
  diagnosingProviderName String?
  /// CLINICIAN | INTAKE | VALANT_IMPORT | DRFIRST | LEGACY_CHART | AI_ACCEPTED
  source                 String    @default("CLINICIAN")
  /// e.g. the suggestion id, Rcopia problem id, Valant job id
  sourceRef              String?
  /// ICD-10-CM fiscal year the code was validated against
  codeSetYear            Int?
  comment                String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([clientId, status])
  @@index([organizationId, status])
  @@index([clientId, code])
}

/// History of a client's diagnosis list: ADDED | UPDATED | STATUS | RANK | REVIEWED | IMPORTED.
/// REVIEWED rows (diagnosisId null) record "Reviewed — no change" and reviews with changes.
model ClientDiagnosisEvent {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  diagnosisId    String?
  action         String
  /// manual | intake | treatment_plan_review | note | ai_suggestion | drfirst | client_profile | valant_import | backfill
  context        String?
  before         Json?
  after          Json?
  reason         String?
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([clientId, action])
  @@index([diagnosisId])
}

/// AI scribe / coding suggestions for the list: PENDING until a clinician accepts (adds) or dismisses.
model ClientDiagnosisSuggestion {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  code           String
  description    String
  /// ai_scribe | coding_agent | comprehend
  origin         String
  originRef      String?
  rationale      String?
  /// PENDING | ACCEPTED | DISMISSED
  status         String    @default("PENDING")
  createdById    String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([clientId, status])
}

model ProgressNoteWorkflow {
  noteId              String                     @id
