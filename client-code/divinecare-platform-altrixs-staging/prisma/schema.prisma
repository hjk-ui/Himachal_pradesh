/// Insurance policy on a client for 837 subscriber / COB loops. Rank P may hold
/// only the subscriber (payer + member ID stay on Client); S and T hold the full policy.
model ClientInsuranceCoverage {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id")
  clientId                 String    @map("client_id")
  /// P primary, S secondary, T tertiary
  rank                     String    @db.VarChar(1)
  payerName                String?   @map("payer_name")
  memberId                 String?   @map("member_id")
  groupNumber              String?   @map("group_number")
  claimFilingCode          String?   @map("claim_filing_code") @db.VarChar(2)
  /// X12 individual relationship code of the patient to the subscriber: 18 self, 01 spouse, 19 child, 20 employee, 21 unknown, 39 organ donor, 40 cadaver donor, 53 life partner, G8 other
  subscriberRelationship   String    @default("18") @map("subscriber_relationship") @db.VarChar(2)
  subscriberFirstName      String?   @map("subscriber_first_name")
  subscriberLastName       String?   @map("subscriber_last_name")
  subscriberMiddleInitial  String?   @map("subscriber_middle_initial") @db.VarChar(1)
  subscriberDob            DateTime? @map("subscriber_dob") @db.Date
  /// M | F | U
  subscriberGender         String?   @map("subscriber_gender") @db.VarChar(1)
  active                   Boolean   @default(true)
  updatedBy                String?   @map("updated_by")
