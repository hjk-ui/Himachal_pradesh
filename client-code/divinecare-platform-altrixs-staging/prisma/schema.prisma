// ─── Group therapy / SUD group counseling (migration 20261019_group_sessions.sql) ───
/// One group. kind psychotherapy | sud (separate areas; permanent once the group has notes).
/// SUD groups are 42 CFR Part 2 (part2 = true, enforced by a CHECK). src/lib/groups/*
model ClinicalGroup {
  id                     String    @id @default(cuid())
  organizationId         String
  /// psychotherapy | sud
  kind                   String
  /// psychotherapy: therapy | psychoeducation | skills | prp | other; sud: sud_counseling | sud_iop | psychoeducation | other
  groupType              String
  name                   String
  description            String?
  program                String?
  facilitatorId          String?
  coFacilitatorId        String?
  locationId             String?   @db.VarChar(50)
  room                   String?
  telehealth             Boolean   @default(false)
  capacity               Int       @default(10)
  defaultDurationMinutes Int       @default(60)
  /// CPT / HCPCS on each attendee's claim line (90853, H0005 ...); null = no claim line
  billingCode            String?
  /// per_session (a claim line per attendee) | attendance_only (no per-session line: PRP, IOP per diem)
  billingMode            String    @default("per_session")
  /// Minutes a member must attend for the line to bill; null = not set by billing
  minBillableMinutes     Int?
  /// Payer group-size cap recorded by billing; null = none recorded
  maxBillableGroupSize   Int?
  /// open | closed
  enrollment             String    @default("open")
  /// active | paused | archived
  status                 String    @default("active")
  part2                  Boolean   @default(false)
  /// Recurring schedule (src/lib/scheduling/recurrence.ts rule): weekly | biweekly | monthly
  recurFrequency         String?
  recurInterval          Int?
  recurWeekdays          Int[]     @default([])
  /// HH:mm practice wall clock
  recurStartTime         String?
  recurStartDate         DateTime? @db.Date
  recurEndDate           DateTime? @db.Date
  /// Id from the legacy ClinicModuleState blob (one-time copy; idempotency key)
  legacySourceId         String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  members  ClinicalGroupMember[]
  sessions ClinicalGroupSession[]

  @@unique([organizationId, legacySourceId])
  @@index([organizationId, kind, status])
  @@index([facilitatorId])
  @@map("clinical_groups")
}

/// Group roster row (one per client per group; re-joining reactivates the row).
model ClinicalGroupMember {
  id             String        @id @default(cuid())
  organizationId String
  groupId        String
  group          ClinicalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId       String
  /// active | completed | discharged | withdrawn | inactive
  status         String        @default("active")
  joinedOn       DateTime      @db.Date
  leftOn         DateTime?     @db.Date
  leftReason     String?
  addedById      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([groupId, clientId])
  @@index([organizationId, clientId])
  @@map("clinical_group_members")
}

/// One group occurrence. sharedNote = the group content section (topic, interventions, dynamics);
/// it never names members. groupSize = members who attended, recorded for payer caps.
model ClinicalGroupSession {
  id                String        @id @default(cuid())
  organizationId    String
  groupId           String
  group             ClinicalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  endsAt            DateTime
  durationMinutes   Int
  telehealth        Boolean       @default(false)
  locationId        String?       @db.VarChar(50)
  room              String?
  /// scheduled | in_progress | completed | cancelled
  status            String        @default("scheduled")
  cancelReason      String?
  facilitatorId     String?
  coFacilitatorId   String?
  topic             String?
  sharedNote        Json?
  sharedUpdatedAt   DateTime?
  sharedUpdatedById String?
  groupSize         Int?
  part2             Boolean       @default(false)
  fromRecurrence    Boolean       @default(false)
  legacySourceId    String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  attendance ClinicalGroupAttendance[]

  @@unique([groupId, startsAt])
  @@index([organizationId, startsAt])
  @@index([facilitatorId, startsAt])
  @@map("clinical_group_sessions")
}

/// One member at one session. individualNote = that member's own note fields; progressNoteId =
/// the ProgressNote in THAT client's chart (signed per the normal note workflow, co-sign rules).
model ClinicalGroupAttendance {
  id                  String               @id @default(cuid())
  organizationId      String
  sessionId           String
  session             ClinicalGroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groupId             String
  clientId            String
  memberId            String?
  /// unmarked | present | late | left_early | absent | excused
  status              String               @default("unmarked")
  minutesAttended     Int?
  /// Telehealth: where the member was (home | other), drives POS 10 / 02
  patientLocationType String?
  individualNote      Json?
  progressNoteId      String?              @unique
  appointmentId       String?
  markedById          String?
  markedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([sessionId, clientId])
  @@index([organizationId, clientId])
  @@index([groupId])
  @@map("clinical_group_attendance")
}

// ─── Group telehealth (migration 20261027_group_telehealth.sql, src/lib/groups/video*.ts) ───
