  @@unique([captureId, seq])
  @@index([organizationId])
  @@map("scribe_group_segments")
}

/// Follow-up the clinician accepted from a draft (listed in My To-Do until done).
model ScribeFollowUp {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  sessionId      String?        @map("session_id")
  session        ScribeCapture? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  clientId       String         @map("client_id")
  ownerId        String         @map("owner_id")
  /// next_visit | lab | referral | letter | coordination | measure | other
  kind           String         @db.VarChar(16)
  title          String         @db.VarChar(200)
  detail         String?        @db.VarChar(500)
  href           String?        @db.VarChar(300)
  /// OPEN | DONE | DISMISSED
  status         String         @default("OPEN") @db.VarChar(10)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)

