model AutoPayCharge {
  id            String     @id @default(cuid())
  cardOnFileId  String
  amount        Float
  status        String     // "succeeded" | "failed" | "pending"
  failureReason String?
  chargedAt     DateTime   @default(now())

  card          CardOnFile @relation(fields: [cardOnFileId], references: [id], onDelete: Cascade)

  @@index([cardOnFileId, status])
}

// ─── eStatements & Tracked Payment Links ──────────────────────────────────
model EStatement {
