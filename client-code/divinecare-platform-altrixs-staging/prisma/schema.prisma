  intervalCount  Int
  startDate      DateTime
  endDate        DateTime?
  nextDueAt      DateTime
  lastOrderedAt  DateTime?
  lastOrderId    String?
  /// Order set it came from (e.g. lithium), when any
  orderSetKey    String?
