  effectiveDate  DateTime?
  portalNotes    String?
  checklist      Json      // Array of { documentName: string, completed: boolean }
  updatedAt      DateTime  @updatedAt

  @@unique([providerUserId, payerName])
}

// ─── SUD Radar Signals (AI Scanner) ──────────────────────────────────────────
model SudRadarSignal {
  id                String   @id @default(cuid())
  organizationId    String?
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  detectionSource   String   // "diagnosis" | "note-keyword"
  detectedCondition String   // e.g. "Alcohol Use Disorder, Severe (F10.20)"
  quotedEvidence    String   @db.Text
  confidencePercent Int      // e.g. 98, 84
  recommendation    String   @db.Text
  actionLabel       String   // e.g. "Start ASAM Admission", "Administer AUDIT"
  actionHref        String   // e.g. "/dashboard/residential", "/dashboard/sdoh"
  scannedAt         DateTime @default(now())
  /// Scan dedupe key within (client, detectionSource); null on hand-saved legacy signals
  fingerprint       String?
  /// alcohol | opioids | cannabis | sedatives | cocaine | stimulants | hallucinogens | nicotine | inhalants | other
  substanceClasses  String[] @default([])
  /// Charted ICD-10 codes (diagnosis path only — never inferred)
  codes             String[] @default([])
  /// [{ quote, sourceType, sourceId, sourceLabel, date, href, term?, confidence?, key?, aiVerdict? }]
  evidence          Json     @default("[]")
  /// Keys of every evidence item seen (evidence keeps only the strongest few)
  evidenceKeys      String[] @default([])
  /// high | medium | low
  confidence        String?
  /// residential-referral | sbirt | chart-documentation | tobacco-cessation
  routedAction      String?
  /// urgent | high | routine | low
  priority          String?
  /// Active SUD dx without an SUD screening in the last 12 months
  needsScreening    Boolean  @default(false)
  /// new | reviewed | referred | dismissed | resolved
  status            String   @default("new")
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?
  /// SUD_REFERRAL_PROMPT RiskAlert created from this signal
  referralAlertId   String?
  lastSeenAt        DateTime?
  resolvedAt        DateTime?

  @@unique([clientId, detectionSource, fingerprint])
  @@index([clientId])
  @@index([detectionSource])
  @@index([organizationId, status])
  @@index([organizationId, status, scannedAt])
}

