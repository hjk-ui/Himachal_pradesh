/// Service Eligibility Scanner snapshot: one row per active client, rewritten by the nightly scan
/// (scripts/service-eligibility-scan.ts) and by the page's Re-scan for the viewer's scope. Names,
/// MRN, clinician and location are read live from Client; read filters apply org / caseload scope
/// and the 42 CFR Part 2 lock for the viewer. Migration 20261019_scanner_service_eligibility.sql.
model ServiceEligibilitySnapshot {
  organizationId String   @map("organization_id")
  clientId       String   @map("client_id")
  scannedAt      DateTime @default(now()) @map("scanned_at") @db.Timestamptz(6)
  runId          String?  @map("run_id")
  statuses       Json     @default("{}")
  anyIndicated   Boolean  @default(false) @map("any_indicated")
  priorityScore  Int      @default(0) @map("priority_score")
  summary        Json     @default("{}")
  results        Json?

