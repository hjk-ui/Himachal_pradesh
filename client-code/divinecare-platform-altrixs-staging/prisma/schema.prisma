model DocumentIntake {
  id                  String    @id @default(uuid())
  source              String    // Fax, Upload, Scan, Email
  documentType        String    // Insurance Card, Lab Report, Referral, Court Order, Prior Auth Letter, Unclassified
  confidenceScore     Float
  suggestedClientId   String?
  suggestedClient     Client?   @relation(fields: [suggestedClientId], references: [id], onDelete: SetNull)
  suggestedFilingPath String
  s3RawKey            String
  extractedFields     Json      @default("[]")
  status              String    @default("ready") // processing, ready, filed, rejected, split
  filedByUserId       String?
  filedAt             DateTime?
  createdAt           DateTime  @default(now())
  /// Owning organization (unmatched documents have no client to scope through)
  organizationId      String?
  fileName            String?
  mimeType            String?
  fileSize            Int?
  uploadedById        String?
  /// Textract async job id while OCR is running
  ocrJobId            String?
  pageCount           Int?
  extractedText       String?
  /// matched | needs_review | unmatched (a suggestion only; staff confirm every filing)
  matchStatus         String?
  matchReason         String?
  matchCandidates     Json?
  processingError     String?
  /// OCR text of each page (index 0 = page 1; blank pages are ""), used to split by patient
  pageTexts           Json?
  /// Set on a document created by splitting a multi-patient upload; the parent has status 'split'
  parentId            String?
  parent              DocumentIntake?  @relation("DocumentIntakeSplit", fields: [parentId], references: [id], onDelete: SetNull)
  children            DocumentIntake[] @relation("DocumentIntakeSplit")
  /// 1-based pages of the parent file that belong to this document (split children only)
  pageNumbers         Int[]     @default([])
  /// Bulk import (Valant documents ZIP): path inside the archive, content hash, batch
  sourcePath          String?
  sha256              String?
  importBatchId       String?
  /// Valant document id from the export file name "CODE_YYYYMMDD_Title(DocId).pdf" (dedupe per client)
  valantDocumentId    String?
  /// Imported records are read-only: no edit / re-file / delete; leadership may void with a reason
  readOnly            Boolean   @default(false)
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?
  /// Chart history digest text cache (src/lib/ai/chartDigest/extract.ts). 20261026_chart_history_digest.sql
  /// pdf_text | textract | existing | none; textExtractedAt = when extractedText / pageTexts were cached
  textMethod          String?
  textExtractedAt     DateTime?
  /// Textract job started for a scanned PDF by the digest pipeline (separate from intake ocrJobId)
  textOcrJobId        String?

  @@index([status])
  @@index([suggestedClientId])
  @@index([organizationId, status])
  @@index([parentId])
  @@index([organizationId, sha256])
  @@index([importBatchId])
  @@index([organizationId, valantDocumentId])
}

/// Valant documents ZIP import (one folder per client). Dry run first, then apply. The report holds
/// counts and masked folder labels only (no names, no file contents). See src/lib/migration/valantDocuments.ts
model ValantDocImportBatch {
  id             String    @id @default(uuid())
  organizationId String
  /// uploading | uploaded | dry_running | dry_run_done | applying | done | failed
  status         String    @default("uploading")
  /// s3 | local
  sourceKind     String
  sourceBucket   String?
  sourceKey      String
  fileName       String?
  fileSize       BigInt?
  /// S3 multipart upload id while the browser is uploading
  uploadId       String?
  /// Parsing / matching options (client folder depth, name-only matching, OCR-later flag)
  options        Json      @default("{}")
  ocrForSearch   Boolean   @default(false)
  /// dry_run | apply: the phase the counts and cursor belong to
  phase          String?
  /// Archive entries already handled in the current phase (central-directory order); resume skips them
  cursor         Int       @default(0)
  counts         Json      @default("{}")
  report         Json      @default("{}")
  error          String?
  createdById    String
  appliedById    String?
  heartbeatAt    DateTime?
  dryRunAt       DateTime?
  appliedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, createdAt])
}

