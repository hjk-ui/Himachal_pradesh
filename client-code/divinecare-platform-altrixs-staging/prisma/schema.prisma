// ─── HR standard (src/lib/hr/standard.ts, prisma/migrations/20261022_hr_standard.sql) ───────────
// Plain id columns (no relations) so Organization / User are unchanged. Every row is scoped by
// organizationId in src/lib/hr/*. HR data is staff data: no client PHI is stored here (caseload
// handoff stores a count only). Regulatory numbers live in HrSettings as "practice policy, confirm".

/// Dated compliance items that are not licenses: TB test, flu / hep B, background check, CJIS
/// fingerprints, I-9, CAQH re-attestation, Maryland Medicaid (ePREP) enrollment.
model StaffComplianceRecord {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  /// TB_TEST | FLU_VACCINE | HEP_B | BACKGROUND_CHECK | CJIS_FINGERPRINT | I9 | CAQH_ATTESTATION | MEDICAID_ENROLLMENT | OTHER
  kind           String
  label          String?
  completedOn    DateTime? @db.Date
  /// Explicit expiry / next due; null = computed from policy (CAQH 120 days, TB interval) or none
  expiresOn      DateTime? @db.Date
  /// complete | pending | declined | exempt | not_applicable
  status         String    @default("complete")
  /// e.g. negative / clear / verified (never test images or I-9 document copies)
  result         String?
  /// Non-sensitive reference: ePREP number, background vendor order id
  identifier     String?
  verifiedById   String?
  verifiedByName String?
  notes          String?
  documentId     String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, kind])
  @@index([organizationId, userId])
  @@map("staff_compliance_records")
}

/// Exclusion screening (OIG LEIE, SAM.gov, Maryland Medicaid sanctions): one row per check.
/// Append-only in the API (no update / delete). Due monthly per HrSettings.exclusionCheckIntervalDays.
model HrExclusionCheck {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// OIG_LEIE | SAM_GOV | MD_MEDICAID
  source         String
  checkedOn      DateTime @db.Date
  /// clear | possible_match | match
  result         String
  reference      String?
  notes          String?
  checkedById    String
  checkedByName  String?
  createdAt      DateTime @default(now())

  @@index([organizationId, userId, source, checkedOn])
  @@map("hr_exclusion_checks")
}

/// Employee documents (offer letter, signed forms, certificates). Files live under
/// UPLOADS_DIR/hr-documents and are only served by the audited /api/hr/documents/[id] route.
model HrDocument {
  id                String    @id @default(cuid())
