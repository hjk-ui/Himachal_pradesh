  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName            String
  clinicianId           String?
  clinicianName         String?
  type                  String                  @default("Individual Therapy")
  scheduledAt           DateTime?
  time                  String?
  sessionDate           DateTime
  startTime             String
  durationMin           Int                     @default(50)
  durationMinutes       Int                     @default(50)
  status                TelehealthSessionStatus @default(UPCOMING)
  platform              TelehealthPlatform      @default(CHIME)
  roomId                String?
  joinUrl               String?
  hostUrl               String?
  chimeMeetingId        String?
  chimeExternalMeetingId String?
  chimeMediaRegion      String?                 @default("us-east-1")
  pipelineId            String?                 // S3 Media capture pipeline
  clinicianAttendeeId   String?
  clinicianJoinToken    String?                 @db.Text
  patientAttendeeId     String?
  patientJoinToken      String?                 @db.Text
  chimeData             Json?
  joinToken             String?                 @unique
  patientCheckedIn      Boolean                 @default(false)
  patientCheckedInAt    DateTime?
  enableRecording       Boolean                 @default(false)
  recordingUrl          String?
  transcriptionJobName  String?
  transcriptionStatus   String?                 @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
