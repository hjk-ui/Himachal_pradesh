// ─── Patient card payments / autopay (20261021_patient_autopay.sql) ─────────
/// Per-practice patient payment settings. Master switch `enabled` defaults OFF. Stripe keys are
/// env only (PATIENT_PAYMENTS_STRIPE_*), never stored. src/lib/patientPayments
model PatientPaymentSettings {
  organizationId            String   @id
  /// Master switch: no card capture and no charges while false
  enabled                   Boolean  @default(false)
  chargeCopays              Boolean  @default(true)
  chargeAfterEra            Boolean  @default(true)
  chargeSelfPay             Boolean  @default(true)
  /// Also needs the practice no-show / late-cancel fee policy (PracticeSettings) and the Medicaid guard
  chargeMissedVisitFees     Boolean  @default(false)
  /// Above either cap the charge is held for billing review instead of charged
  maxPerChargeCents         Int?
  maxPerMonthCents          Int?
  /// Card statement descriptor suffix (A-Z, 0-9, space; neutral, no service words)
  statementDescriptorSuffix String?  @db.VarChar(10)
  /// Sender line on receipts and account notices (null = "Your care team")
  receiptSenderName         String?  @db.VarChar(60)
  /// Stripe Connect connected account (acct_...) when the platform key is used; null = the practice's own keys
  stripeAccountId           String?
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/// Stripe customer for a patient account (no name / email / PHI sent to Stripe; metadata = Altrixs account id)
model PatientStripeCustomer {
  id               String   @id @default(cuid())
  organizationId   String
  clientId         String
  stripeCustomerId String   @unique
  livemode         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([organizationId, clientId, livemode])
}

/// One automatic card charge decision (visit copay, post-ERA coinsurance/deductible, self-pay visit,
/// missed-visit fee). Ledger Payment is created only from the payment_intent.succeeded webhook.
model PatientCharge {
  id                    String                @id @default(cuid())
  organizationId        String
  clientId              String
  /// copay | coinsurance | self_pay | missed_visit
  kind                  String
  /// pending | processing | succeeded | failed | needs_action | held | skipped | canceled | refunded | partially_refunded
  status                String
  amountCents           Int
  /// visit:<appointmentId>:<kind> or era:<eraClaimId>:coinsurance; one row per key
  idempotencyKey        String
  appointmentId         String?
  claimId               String?
  eraClaimId            String?
  /// YYYY-MM in practice time (monthly cap)
  chargeMonth           String                @db.VarChar(7)
  /// Skip / hold reason code (src/lib/patientPayments/rules.ts)
  reason                String?
  cardOnFileId          String?
  cardBrand             String?
  cardLast4             String?               @db.VarChar(4)
  stripePaymentIntentId String?               @unique
  livemode              Boolean               @default(false)
  attempts              Int                   @default(0)
  lastAttemptAt         DateTime?
  /// Stripe decline / error code (card_declined, authentication_required, ...); never PHI
  failureCode           String?
  failureMessage        String?
  /// Ledger Payment row posted on payment_intent.succeeded
  paymentId             String?
  refundedCents         Int                   @default(0)
  receiptNumber         String?               @unique
  receiptEmailedAt      DateTime?
  patientNotifiedAt     DateTime?
  succeededAt           DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  refunds               PatientChargeRefund[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, chargeMonth])
  @@index([clientId, createdAt])
  @@index([appointmentId])
  @@index([claimId])
}

/// Refund (or void) of a patient charge by billing staff, through Stripe; ledger row on success
model PatientChargeRefund {
  id             String        @id @default(cuid())
  organizationId String
  chargeId       String
  charge         PatientCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountCents    Int
  /// refund | void
  kind           String        @default("refund")
  /// pending | succeeded | failed | canceled
  status         String
  stripeRefundId String?       @unique
  reason         String?
  paymentId      String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([chargeId])
  @@index([organizationId, createdAt])
}

// ─── Intensive programs: IOP / PHP (migration 20261022_intensive_programs.sql, src/lib/intensive/*) ───
/// One intensive program at one location (MH IOP, SUD IOP (ASAM 2.1) or PHP). Every null policy
/// field means "use the default for the program type" (src/lib/intensive/policy.ts), shown as
/// "practice policy, confirm" until leadership confirms the program policy (policyConfirmedAt).
model IntensiveProgram {
  id                    String    @id @default(cuid())
  organizationId        String
  locationId            String?
  name                  String
  /// MH_IOP | SUD_IOP | PHP
  programType           String
  /// adult | adolescent
  ageGroup              String    @default("adult")
  /// PHP stays off until the practice confirms it holds PHP licensure (phpLicensureConfirmed)
  active                Boolean   @default(true)
  phpLicensureConfirmed Boolean   @default(false)
  /// { days: number[] (0 = Sunday), blocks: [{ label, start "HH:mm", minutes, sessionType }] }
  scheduleTemplate      Json?
  minWeeklyHours        Float?
  initialPlanDays       Int?
  planReviewDays        Int?
  authRenewalLeadDays   Int?
  followUpWindowDays    Int?
  missedDayOutreachHours Int?
  /// per_diem | per_service
  billingMode           String    @default("per_diem")
  perDiemCode           String?
  /// { group, individual, family, psychiatry } codes for per-service drafts
  serviceCodes          Json?
  /// [{ code, unit: per_diem | per_session | per_15_min | per_hour, minMinutes, rounding }]
  unitRules             Json?
  /// ClinicalGroup ids whose sessions count toward this program's attendance (group-sessions module)
  linkedGroupIds        String[]  @default([])
  /// SUD IOP: 42 CFR Part 2 program records
  part2                 Boolean   @default(false)
  policyConfirmedAt     DateTime?
  policyConfirmedById   String?
  policyConfirmedByName String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId, active])
  @@map("intensive_programs")
}

/// One episode of care in an intensive program: referral -> screening -> admission -> discharge.
model IntensiveEnrollment {
  id                     String    @id @default(cuid())
  organizationId         String
  programId              String
  clientId               String
  /// referred | screening | admitted | discharged | declined
  status                 String    @default("referred")
  referralDate           DateTime  @db.Date
  referralSource         String?
  referralReason         String?
  /// { criteria: { [key]: boolean }, locusRecordId, locusLevel, asamScores, levelNote, screenedAt, screenedById }
  screening              Json?
  priorAuthId            String?
  psychEvalDate          DateTime? @db.Date
  psychEvalNoteId        String?
  admissionDate          DateTime? @db.Date
  primaryClinicianId     String?
  prescriberId           String?
  caseManagerId          String?
  treatmentPlanId        String?
  dischargeDate          DateTime? @db.Date
  dischargeReason        String?
  stepDownLevel          String?
  aftercarePlan          String?
  dischargeSummaryNoteId String?
  followUpAppointmentId  String?
  followUpDate           DateTime? @db.Date
  followUpProvider       String?
  transitionNotes        String?
  part2                  Boolean   @default(false)
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([organizationId, programId, status])
  @@index([organizationId, clientId])
  @@map("intensive_enrollments")
}

/// One client's attendance at one program session block on one day.
model IntensiveAttendance {
  id                String   @id @default(cuid())
  organizationId    String
  programId         String
  enrollmentId      String
  clientId          String
  /// Calendar date of service (00:00 UTC)
  serviceDate       DateTime @db.Date
  /// Schedule block label (e.g. "Group 1") or "extra"
  blockKey          String
  /// group | individual | family | psychiatry
  sessionType       String
  /// present | late | left_early | absent | excused
  status            String
  minutes           Int?
  scheduledMinutes  Int?
  progressNoteId    String?
  groupSessionId    String?
  note              String?
  recordedById      String?
  recordedByName    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([enrollmentId, serviceDate, blockKey])
  @@index([organizationId, programId, serviceDate])
  @@index([organizationId, clientId, serviceDate])
  @@map("intensive_attendance")
}

/// Missed program day: outreach task for the care team (attempts logged until resolved).
model IntensiveFollowUp {
  id             String    @id @default(cuid())
  organizationId String
  programId      String
  enrollmentId   String
  clientId       String
  serviceDate    DateTime  @db.Date
  assignedToId   String?
  dueAt          DateTime
  /// open | done
  status         String    @default("open")
  /// [{ at, byId, byName, method, outcome, note }]
  attempts       Json      @default("[]")
  outcome        String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([enrollmentId, serviceDate])
  @@index([organizationId, status, dueAt])
  @@index([assignedToId, status])
  @@map("intensive_follow_ups")
}

/// Weekly interdisciplinary team review (PHP: psychiatrist / NP review required each week).
model IntensiveWeeklyReview {
  id                   String    @id @default(cuid())
  organizationId       String
  enrollmentId         String
  clientId             String
  /// Monday of the review week
  weekStart            DateTime  @db.Date
  summary              String
  hoursAttended        Float?
  planChanges          String?
  levelOfCareDecision  String?
  reviewedById         String
  reviewedByName       String?
  reviewedByRole       String?
  prescriberReviewedById   String?
  prescriberReviewedByName String?
  prescriberReviewedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([enrollmentId, weekStart])
  @@index([organizationId, weekStart])
  @@map("intensive_weekly_reviews")
}

/// Charge DRAFT from attendance (per diem or per service). Never submitted from here: billing
/// reviews drafts and builds claims with the existing claim tools. No fee is stored.
model IntensiveChargeDraft {
  id             String   @id @default(cuid())
  organizationId String
  programId      String
  enrollmentId   String
  clientId       String
  serviceDate    DateTime @db.Date
  code           String
  units          Int
  minutes        Int
  /// per_diem | <attendance id> (per service)
  sourceKey      String
  /// draft | held | void
  status         String   @default("draft")
  holdReasons    String[] @default([])
  priorAuthId    String?
  part2          Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([enrollmentId, serviceDate, code, sourceKey])
  @@index([organizationId, serviceDate])
  @@index([organizationId, status])
  @@map("intensive_charge_drafts")
}

// ════════════════════════════════════════════════════════════════════════════════════════════
// Growth & Marketing suite (/dashboard/marketing). Migration 20261022_marketing_suite.sql.
// HIPAA marketing rule: clients receive marketing only with a signed marketing authorization;
// leads who share health information are PHI and stay in Altrixs (never sent to ad / analytics
// tools). Treatment reminders are NOT marketing and stay in the clinical SMS system.
// ════════════════════════════════════════════════════════════════════════════════════════════

/// Org marketing settings: brand voice, senders, business / quiet hours, CAN-SPAM address,
/// marketing-authorization consent template keys, AI feature flags, integration notes.
model MarketingSettings {
  id                         String   @id @default(cuid())
  organizationId             String   @unique
  timeZone                   String   @default("America/New_York")
  /// { mon: { open: "09:00", close: "17:00" } | null, ... }
  businessHours              Json?
  /// TCPA quiet hours (recipient local time): no marketing texts from quietHoursStart to quietHoursEnd
  quietHoursStart            String   @default("20:00")
  quietHoursEnd              String   @default("09:00")
  /// CAN-SPAM: valid physical postal address in every marketing email
  physicalAddress            String?
  /// Consent-library template key for the HIPAA marketing authorization (45 CFR 164.508(a)(3))
  marketingAuthTemplateKey   String   @default("marketing-authorization")
  /// Consent-library template key for testimonial / likeness authorization
  testimonialAuthTemplateKey String   @default("testimonial-authorization")
  /// [{ kind: "email" | "sms", label, address, verified }]
  senderIdentities           Json?
  brandVoice                 String?
  autoReplyEnabled           Boolean  @default(false)
  autoReplyText              String?
  missedCallTextBack         Boolean  @default(false)
  missedCallText             String?
  speedToLeadMinutes         Int      @default(15)
  /// Small-cell suppression threshold for client-linked counts in breakdowns (CMS standard 11)
  smallCellThreshold         Int      @default(11)
  /// { reviewReply: true, suggestedReply: true, ... } (missing key = on)
  aiFeatures                 Json?
  /// { googleBusiness: { note }, meta: {...}, website: {...}, phone: {...} }
  integrations               Json?
  publicFormsEnabled         Boolean  @default(true)
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("marketing_settings")
}

/// Prospective client (lead). Health details a lead shares are PHI: minimum necessary only.
model MarketingLead {
  id                  String    @id @default(cuid())
  organizationId      String
  firstName           String
  lastName            String
  dateOfBirth         DateTime? @db.Date
  phone               String?
  email               String?
  /// website_form | phone | referral_partner | community_event | walk_in | insurance_directory | listing | social | other
  source              String
  sourceDetail        String?
  partnerId           String?
  eventId             String?
  formId              String?
  /// new | contacted | screening | insurance_verified | scheduled | converted | not_a_fit | lost
  stage               String    @default("new")
  /// Furthest open stage reached (funnel math)
  furthestStage       String    @default("new")
  stageChangedAt      DateTime  @default(now())
  assignedToId        String?
  serviceInterest     String?
  locationId          String?
  locationName        String?
  insurance           String?
  /// phone | sms | email
  preferredContact    String?
  /// Lead asked to be contacted about their inquiry
  contactConsent      Boolean   @default(false)
  smsConsent          Boolean   @default(false)
  smsConsentAt        DateTime?
  smsConsentSource    String?
  smsOptOutAt         DateTime?
  emailConsent        Boolean   @default(false)
  emailOptOutAt       DateTime?
  /// Minimum necessary: scheduling / contact notes only, no clinical history
  notes               String?
  /// Dedupe flag only; the matching client is never exposed here
  possibleClientMatch Boolean   @default(false)
  firstResponseAt     DateTime?
  lastContactAt       DateTime?
  lastInboundAt       DateTime?
  intakeScheduledAt   DateTime?
  intakeNoShowAt      DateTime?
  convertedClientId   String?
  convertedAt         DateTime?
  intakeAppointmentId String?
  lostReason          String?
  /// Non-PHI attribution tag (e.g. campaign name); never sent to third parties
  campaignTag         String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId, stage])
  @@index([organizationId, createdAt])
  @@index([organizationId, phone])
  @@map("marketing_leads")
}

model MarketingLeadActivity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  /// note | stage | message | task | call | system | convert | assign
  kind           String
  summary        String
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("marketing_lead_activities")
}

model MarketingTask {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String?
  title          String
  dueAt          DateTime?
  assignedToId   String?
  /// open | done
  status         String    @default("open")
  /// manual | automation
  source         String    @default("manual")
  createdById    String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([leadId])
  @@map("marketing_tasks")
}

/// Marketing audience contact (newsletter, event attendee, partner contact, community member,
/// or a client WITH a signed marketing authorization). Non-clinical attributes only.
model MarketingContact {
  id                              String    @id @default(cuid())
  organizationId                  String
  name                            String
  email                           String?
  phone                           String?
  /// newsletter | event_attendee | partner_contact | community | client_authorized
  kind                            String
  partnerId                       String?
  /// Set only for kind client_authorized
  clientId                        String?
  emailConsent                    Boolean   @default(false)
  emailConsentAt                  DateTime?
  emailOptOutAt                   DateTime?
  smsConsent                      Boolean   @default(false)
  smsConsentAt                    DateTime?
  smsOptOutAt                     DateTime?
  marketingAuthorizationAt        DateTime?
  marketingAuthorizationExpiresAt DateTime?
  marketingAuthorizationRevokedAt DateTime?
  /// ConsentForm id of the signed authorization
  marketingAuthorizationRef       String?
  tags                            String[]  @default([])
  source                          String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@index([organizationId, kind])
  @@index([organizationId, phone])
  @@map("marketing_contacts")
}

/// Public web intake form (hosted at /p/<org>/intake/<slug>, embeddable). Submissions create leads.
model MarketingForm {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  slug                String
  active              Boolean  @default(true)
  /// [{ key, label, type, required, options? }]
  fields              Json
  serviceOptions      String[] @default([])
  locationOptions     String[] @default([])
  confirmationMessage String
  submissionCount     Int      @default(0)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([organizationId, slug])
  @@map("marketing_forms")
}

/// One marketing / lead message (SMS or email). Status never claims a send that did not happen.
model MarketingMessage {
  id                String    @id @default(cuid())
  organizationId    String
  leadId            String?
  contactId         String?
  campaignId        String?
  runId             String?
  /// sms | email
  channel           String
  /// outbound | inbound
  direction         String    @default("outbound")
  subject           String?
  body              String
  /// draft | queued | sent | failed | blocked | received
  status            String
  reason            String?
  templateId        String?
  variant           String?
  sentById          String?
  providerMessageId String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, campaignId])
  @@map("marketing_messages")
}

model MarketingTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// sms | email
  channel        String
  subject        String?
  body           String
  category       String   @default("follow_up")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

