/// Concurrent in-call clinical documentation (SOAP & MSE)
model TelehealthInCallNote {
  id              String            @id @default(cuid())
  sessionId       String            @unique
  session         TelehealthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjective      String?           @db.Text
  objective       String?           @db.Text
  assessment      String?           @db.Text
  plan            String?           @db.Text
  mseAppearance   String?
  mseMood         String?
  mseThought      String?
  cssrsRiskScore  String?           // Suicide screen: "Low", "Moderate", "High"
  isSavedToEhr    Boolean           @default(false)
  savedAt         DateTime?
  /// Draft ProgressNote created by "Save to EHR" (signed from Notes). Once set, autosaves never
  /// touch that note. Migration 20261019_incall_draft_note.sql
  progressNoteId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// In-call somatic vitals & medication management tracking (NP / PMHNP)
model TelehealthVitals {
  id              String            @id @default(cuid())
  sessionId       String            @unique
  session         TelehealthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bloodPressure   String?           // e.g. "120/80"
  pulse           Int?              // bpm
  weightLbs       Float?
  sideEffects     String?
  aimsScore       Int?              @default(0)
  qtcWarning      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Automatic post-session charge draft & CPT coding with telehealth modifiers
model TelehealthBillingDraft {
  id              String            @id @default(cuid())
  sessionId       String            @unique
  session         TelehealthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cptCode         String            // "90837", "99214", "90791"
  addonCptCode    String?           // "+90833"
  /// "10" (patient home) or "02" (other than home), from the patient's check-in location
  /// (src/lib/telehealth/pos.ts). Null = location not captured: billing must ask, never guess.
  posCode         String?
  modifiers       String[]          // ["95"], ["GT"]
  durationMinutes Int
  isApproved      Boolean           @default(false)
  chargeRoutedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Real-time HIPAA-compliant in-call messaging
model TelehealthChatMessage {
  id          String            @id @default(cuid())
  sessionId   String
  session     TelehealthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderRole  String            // "CLINICIAN", "PATIENT", "ADMIN"
  senderName  String
  message     String            @db.Text
  sentAt      DateTime          @default(now())

  @@index([sessionId, sentAt])
}

/// HIPAA audit log for telehealth lifecycle events
model TelehealthAuditLog {
  id          String            @id @default(cuid())
  sessionId   String
  session     TelehealthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType   String            // "PATIENT_JOINED_LOBBY", "RESEND_SMS", "ROOM_TRANSFERRED", "SOAP_SAVED"
  performedBy String            // User ID or "PATIENT"
  details     String?
  timestamp   DateTime          @default(now())

  @@index([sessionId, timestamp])
}


model TelehealthSettings {
  id                   String             @id @default(cuid())
