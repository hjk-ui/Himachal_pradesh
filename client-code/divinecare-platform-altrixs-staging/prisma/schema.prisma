  @@index([clientId, scheduledFor])
}

/// Push notification dispatch log to guarantee deduplication across scheduler runs
model NotificationLog {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         String   // medication_reminder | appointment_reminder | telehealth_call | chat_message | check_in_reminder
  dedupeKey    String   @unique
  title        String
  body         String
  payload      Json?
  sentAt       DateTime @default(now())
  successCount Int      @default(0)
  failureCount Int      @default(0)
  /// Appointment reminders (20261019_scheduling_fixes.sql): per-appointment log
  appointmentId String?
  /// push | sms | email
  channel      String?
  /// sent | failed | skipped
  status       String?
  /// skipped / failed reason (no_sms_consent, sms_opted_out, no_phone, setting_off, ...)
