// ─── AutoPay & Gateway Tokenization ───────────────────────────────────────
model CardOnFile {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String          @unique
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gatewayToken   String          // Tokenized by Stripe / Gateway (PCI SAQ-A)
  cardBrand      String          // Visa, Mastercard, Amex, Discover
  last4          String
  expiry         String          // MM/YY
  billingZip     String
  autopayEnabled Boolean         @default(true)
  gatewayCustomerId String?
  gatewayPaymentMethodId String?
  chargeTiming   String?         @default("immediate")
  /// Saved with Stripe live keys (true) or test keys (false); a test card is never charged with live keys. 20261021_patient_autopay
  livemode       Boolean         @default(false)
  /// portal | in_office (Stripe Elements SetupIntent; the card number never reaches Altrixs)
  capturedVia    String?
  capturedById   String?
  setupIntentId  String?
  validatedAt    DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  charges        AutoPayCharge[]

  @@index([organizationId, autopayEnabled])
