  stoppedAt             DateTime? @map("stopped_at") @db.Timestamptz(6)
  captureSeconds        Int       @default(0) @map("capture_seconds")
  streamCount           Int       @default(0) @map("stream_count")
  draftCount            Int       @default(0) @map("draft_count")
  appliedAt             DateTime? @map("applied_at") @db.Timestamptz(6)
  transcriptPurgeAfter  DateTime? @map("transcript_purge_after") @db.Timestamptz(6)
  transcriptPurgedAt    DateTime? @map("transcript_purged_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  segments ScribeGroupSegment[]

  @@index([organizationId, groupSessionId])
  @@index([transcriptPurgedAt])
  @@map("scribe_group_captures")
}

/// One finalized transcript turn of a group capture.
model ScribeGroupSegment {
  id             String             @id @default(cuid())
  captureId      String             @map("capture_id")
  capture        ScribeGroupCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
