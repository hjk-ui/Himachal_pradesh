  storedName        String
  mimeType          String?
  sizeBytes         Int?
  expiresOn         DateTime? @db.Date
  visibleToEmployee Boolean   @default(true)
  /// HR / leadership only (discipline, investigations)
  restricted        Boolean   @default(false)
  /// hr | self_service
  source            String    @default("hr")
  /// active | pending_review | archived
  status            String    @default("active")
  uploadedById      String
  uploadedByName    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, userId])
  @@map("hr_documents")
}

