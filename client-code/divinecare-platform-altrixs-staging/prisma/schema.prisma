  blockSchedulingWhenLicenseExpired Boolean  @default(false)
  dueSoonDays                      Int       @default(60)
  urgentDays                       Int       @default(30)
  /// CAQH ProView re-attestation cycle
  caqhAttestationDays              Int       @default(120)
  /// Exclusion screening interval (monthly)
  exclusionCheckIntervalDays       Int       @default(30)
  /// Maryland Healthy Working Families Act: 1 hour per N hours worked (practice policy, confirm)
  sickAccrualHoursWorked           Float?    @default(30)
  sickAnnualAccrualCap             Float?
  sickBalanceCap                   Float?
  sickAnnualUsageCap               Float?
  /// PTO accrual per pay period by workerType / FTE: { hoursPerPeriod, periodsPerYear, balanceCap }
  ptoPolicy                        Json?
  /// CEU hours per license type per renewal cycle: { "LCSW-C": { hours, cycleMonths } }
  ceuRequirements                  Json?
  /// { fluRoles: [], hepBRoles: [], tbRoles: [], tbIntervalMonths }
  immunizationPolicy               Json?
  cprRequiredRoles                 String[]  @default([])
  /// I-9 document images are not stored unless the practice policy says so
  i9StoreDocumentImages            Boolean   @default(false)
  aiDocumentExtract                Boolean   @default(false)
  aiWritingDrafts                  Boolean   @default(false)
  aiReviewAssistant                Boolean   @default(false)
  aiPolicyQa                       Boolean   @default(false)
  aiDigest                         Boolean   @default(false)
  policyConfirmedAt                DateTime?
  policyConfirmedById              String?
  updatedById                      String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@map("hr_settings")
}

