// ─── Measures to patients (MBC) ─────────────────────────────────────────────
// prisma/migrations/20261023_measures_to_patients.sql. Plain id columns (no relations) so Client /
// Organization stay unchanged; every query is scoped by organizationId + the caller's client scope.

/// An outcome measure assigned to a client: the MBC schedule (/dashboard/mbc/outcomes).
/// Replaces the ClinicModuleState 'outcome-schedules' blob (copied by scripts/migrate-outcome-schedules-blob.ts).
model MeasureAssignment {
  id                 String    @id @default(cuid())
  organizationId     String
  clientId           String
  /// Assessment catalog id (src/features/ehr/assessments/catalog.ts), e.g. phq-9
  instrumentId       String
  /// once | interval | before_visit
  schedule           String    @default("interval")
  /// interval: days between administrations
  everyDays          Int?
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  /// manual | program | provider_rule | visit_rule | sud_radar | legacy
  source             String    @default("manual")
  /// Program id / provider user id / rule key the assignment came from
  sourceRef          String?
  /// active | paused | ended
  status             String    @default("active")
  /// "<clientId>:<instrumentId>" while active, NULL otherwise: one open assignment per client and measure
  activeKey          String?
  assignedById       String?
  lastSentAt         DateTime?
  lastCompletedAt    DateTime?
  /// Legacy blob scheduleId (one-time copy; idempotent)
  legacySourceId     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([organizationId, activeKey])
  @@unique([organizationId, legacySourceId])
  @@index([organizationId, clientId])
  @@index([organizationId, status])
  @@map("measure_assignments")
}

/// One send of one or more measures to a patient (a link /m/<token>, or given in session).
model MeasureRequest {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String
  /// Catalog ids, in the order the patient answers them
  instrumentIds    String[]
  assignmentIds    String[]  @default([])
  /// sha256 of the link token (the raw token is only in the message)
  tokenHash        String    @unique
  /// email | sms | portal | in_session
  channel          String
  /// Per channel: [{ channel, ok, reason }] (no message text)
  deliveryResults  Json?
  /// pending | sent | not_sent | opened | started | completed | expired | locked | cancelled
  status           String    @default("pending")
  notSentReason    String?
  /// manual | visit_3d | visit_1d
  trigger          String    @default("manual")
  /// "<appointmentId>:<trigger>" for automatic sends: never two sends for one visit and stage
  dedupeKey        String?   @unique
  appointmentId    String?
  /// Clinician the results go to (appointment clinician, else assigned clinician)
  clinicianId      String?
  sentById         String?
  sentAt           DateTime?
  openedAt         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  lockedAt         DateTime?
  dobAttempts      Int       @default(0)
  /// sha256 of the post-verification session secret (httpOnly cookie) and its expiry
  sessionHash      String?
  sessionExpiresAt DateTime?
  /// Saved partial answers { [instrumentId]: { [itemId]: score } }; cleared on completion
  partialAnswers   Json?
  /// ClinicalAssessmentRecord ids created on completion
  resultRecordIds  String[]  @default([])
  safetyFlagged    Boolean   @default(false)
  /// 42 CFR Part 2 client and an SUD instrument in this request
  part2            Boolean   @default(false)
  /// Clinician reviewed the completed results (inbox "Measures completed" / "Worsening" clears)
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, clinicianId, completedAt])
  @@index([appointmentId])
  @@map("measure_requests")
}

