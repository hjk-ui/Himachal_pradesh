{
  "info": {
    "name": "Altrixs Patient Mobile App",
    "description": "Supported patient APIs, v3. See Flutter-Patient-App-API-KB.md. Defaults to localhost. Requests include real mutations; use a development clinic and run individually. Telehealth uses top-level session responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{patientToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "patientEmail",
      "value": "patient@example.test"
    },
    {
      "key": "patientPassword",
      "value": "Example123"
    },
    {
      "key": "newPassword",
      "value": "NewExample123"
    },
    {
      "key": "patientToken",
      "value": ""
    },
    {
      "key": "inviteToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "joinToken",
      "value": ""
    },
    {
      "key": "doctorId",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "formId",
      "value": ""
    },
    {
      "key": "fromDate",
      "value": ""
    },
    {
      "key": "appointmentDate",
      "value": ""
    },
    {
      "key": "startTime",
      "value": "10:00"
    },
    {
      "key": "endTime",
      "value": "10:50"
    }
  ],
  "item": [
    {
      "name": "Auth and onboarding",
      "item": [
        {
          "name": "Login (save token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.token)) pm.collectionVariables.set(\"patientToken\", data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Preview invite",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/invite/preview?token={{inviteToken}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Accept invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/invite/accept",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/forgot-password",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reset password (then log in with new password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/reset-password",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Profile and home",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/me"
          }
        },
        {
          "name": "Update contact profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+14105550100\",\n  \"city\": \"Baltimore\",\n  \"emergencyContactName\": \"Example Contact\",\n  \"emergencyContactPhone\": \"+14105550101\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/dashboard"
          }
        },
        {
          "name": "Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/progress"
          }
        }
      ]
    },
    {
      "name": "Doctors and appointments",
      "item": [
        {
          "name": "Doctors (save first doctorId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/doctors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.doctors?.[0]?.id)) pm.collectionVariables.set(\"doctorId\", data.doctors?.[0]?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability (set fromDate)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/doctors/{{doctorId}}/availability?from={{fromDate}}&days=14"
          }
        },
        {
          "name": "Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/appointments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.appointments?.[0]?.id)) pm.collectionVariables.set(\"appointmentId\", data.appointments?.[0]?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Appointment detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "Request appointment (set future date and slot)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicianId\": \"{{doctorId}}\",\n  \"type\": \"Individual Therapy\",\n  \"date\": \"{{appointmentDate}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\",\n  \"isVirtual\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.appointment?.id)) pm.collectionVariables.set(\"appointmentId\", data.appointment?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Request reschedule (set new date and slot)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/appointments/{{appointmentId}}/reschedule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{appointmentDate}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\",\n  \"note\": \"Please move my appointment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancel appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/appointments/{{appointmentId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Care-team chat",
      "item": [
        {
          "name": "Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.conversations?.[0]?.id)) pm.collectionVariables.set(\"conversationId\", data.conversations?.[0]?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Start conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/conversations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"clinical\",\n  \"message\": \"I have a question for my doctor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.conversation?.id)) pm.collectionVariables.set(\"conversationId\", data.conversation?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Messages (save first unread care-team messageId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/conversations/{{conversationId}}/messages?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.messages?.find(m => m.senderRole === 'clinician' && !m.read)?.id)) pm.collectionVariables.set(\"messageId\", data.messages?.find(m => m.senderRole === 'clinician' && !m.read)?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send reply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/conversations/{{conversationId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Thank you\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Mark care-team message read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/messages/{{messageId}}/read",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Check-ins",
      "item": [
        {
          "name": "Check-in history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/check-ins?page=1&limit=20"
          }
        },
        {
          "name": "Create check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/check-ins",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": 7,\n  \"stress\": 4,\n  \"sleep\": 8,\n  \"journal\": \"Feeling better today\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Forms (metadata only)",
      "item": [
        {
          "name": "My consent records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/forms?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && (data.forms?.[0]?.id)) pm.collectionVariables.set(\"formId\", data.forms?.[0]?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consent record detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/patient/forms/{{formId}}"
          }
        }
      ]
    },
    {
      "name": "Telehealth (join-token auth)",
      "item": [
        {
          "name": "Join session info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/telehealth/join/{{joinToken}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Join waiting room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/telehealth/join/{{joinToken}}",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"here\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Signal poll",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/telehealth/signal?token={{joinToken}}&after=0",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Signal send (client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/telehealth/signal",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{joinToken}}\",\n  \"from\": \"client\",\n  \"type\": \"offer\",\n  \"data\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
