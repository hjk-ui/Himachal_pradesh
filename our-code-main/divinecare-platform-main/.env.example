# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/altrixs?schema=public&sslmode=verify-full

# Optional: existing AWS RDS via SSH tunnel (merge compare / merge write). Never commit real passwords.
# RDS_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/altrixs_local?sslmode=require

# NextAuth — ONE URL only (local OR production, never comma-separated)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Production EC2:
# AUTH_URL=https://altrixs.com

# Amazon SES SMTP (us-east-1). Not Resend / Gmail App Password.
# Sandbox: From + To must be verified identities until production access is approved.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@altrixs.com
# One-off test: npm run mail:test  (also set SMTP_TEST_TO to a verified address)
# SMTP_TEST_TO=you@verified.example.com

# Patient Flutter app CORS (optional; default *). Comma-separated origins for web builds.
# PATIENT_CORS_ORIGIN=https://app.altrixs.com

# Amazon SNS SMS (client appointment notices). IAM: sns:Publish.
# Separate from SES SMTP_USER / SMTP_PASS. Destination numbers must be E.164
# (+1… for US). 10-digit clinic phones are normalized to +1.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional temporary creds:
# AWS_SESSION_TOKEN=
# Optional US origination (10DLC / toll-free) in E.164:
# SNS_SMS_ORIGINATION_NUMBER=+1XXXXXXXXXX

# Amazon Connect (Communications hub SMS/calls). Without these → demoMode:true, still persist in DB.
# CONNECT_INSTANCE_ID=
# CONNECT_QUEUE_ID=
# CONNECT_CONTACT_FLOW_ID=
# CONNECT_SOURCE_PHONE_NUMBER=

# AWS HealthLake FHIR R4. Without DATASTORE_ID → demoMode on /dashboard/ehr/healthlake.
# AWS_HEALTHLAKE_DATASTORE_ID=
# AWS_HEALTHLAKE_DATA_ACCESS_ROLE_ARN=
# AWS_HEALTHLAKE_ROLE_ARN=
# AWS_KMS_KEY_ID=
# AWS_HEALTHLAKE_EXPORT_BUCKET=

# Amazon Comprehend Medical (AI Scribe / notes). Demo when AWS_ACCESS_KEY_ID unset.
# Never fakes live success without credentials.

# Amazon Textract (document / medical-form). Demo fixtures when AWS keys unset.

# Amazon Personalize (caseload insights). Without campaign → demoMode from real caseload signals.
# AWS_PERSONALIZE_CAMPAIGN_ARN=
# AWS_PERSONALIZE_RANKING_ARN=

# Amazon Bedrock (AI Scribe Draft / Aria / Coding / risk). Without model id → fail-closed 503 (no fake GPT-4).
# BEDROCK_CLAUDE_SONNET_MODEL_ID=
# BEDROCK_CLAUDE_HAIKU_MODEL_ID=
# BEDROCK_MODEL_ID=
# Dual guardrails (Oct 23) — never use deprecated BEDROCK_GUARDRAIL_ID / BEDROCK_GUARDRAIL_VERSION.
# Missing ID → no guardrail attached (safe local). Missing VERSION → DRAFT.
# BEDROCK_GUARDRAIL_CLINICAL_ID=
# BEDROCK_GUARDRAIL_CLINICAL_VERSION=1
# BEDROCK_GUARDRAIL_GENERAL_ID=
# BEDROCK_GUARDRAIL_GENERAL_VERSION=1
# Cron: DrFirst practice sync every 5 minutes (*/5) — see docs/DRFIRST-INTEGRATION.md

# EventBridge clinical alerts (PHQ-9 / C-SSRS). Without bus → demoMode, still persist ClinicalEvent rows.
# AWS_EVENTBRIDGE_BUS_NAME=

# Stripe — website owner's account (Dashboard → Developers → API keys).
# Use sk_test_ / pk_test_ in staging; switch to sk_live_ / pk_live_ only at go-live.
STRIPE_SECRET_KEY=
# Patient Autopay: refuse sk_live_ unless true (staging keeps this unset/false)
# PATIENT_PAYMENTS_LIVE_APPROVED=false
# SMS inbound STOP/START webhook (optional shared secret)
# SMS_INBOUND_WEBHOOK_SECRET=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from Dashboard → Developers → Webhooks
# Endpoint URL: https://YOUR_DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Optional fallback if a Customer Portal session cannot be created yet
# STRIPE_BILLING_PORTAL_URL=
# Recurring Price IDs from Dashboard → Products.
# Public catalog (monthly): Solo $89, Practice $219, Enterprise $449.
# If these IDs still point at old $49 / $99 / $149 prices, create new Stripe Prices
# and paste the new IDs — display copy already uses the PDF amounts.
STRIPE_SOLO_MONTHLY_PRICE_ID=
STRIPE_SOLO_ANNUAL_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
# Legacy aliases (same as Professional — not shown on the public sheet):
# STRIPE_GROWTH_MONTHLY_PRICE_ID=
# STRIPE_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PRACTICE_MONTHLY_PRICE_ID=
STRIPE_PRACTICE_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
# STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=

# Platform SUPER_ADMIN bootstrap (npm run db:create-platform-admin)
# PLATFORM_ADMIN_NAME=Platform Admin
# PLATFORM_ADMIN_EMAIL=you@altrixs.com
# PLATFORM_ADMIN_PASSWORD=

# Availity Healthcare HIPAA Transactions — server-only OAuth 2.0 client credentials (production)
# Token request: POST https://api.availity.com/v1/token
# Docs: https://developer.availity.com/blog/2025/3/25/availity-api-guide
# Client ID/secret: Developer Portal → My Apps → Approved Access → Client info
#
# Dual clearinghouse architecture (Slice 3):
#   WAYSTAR_ENABLED  = !!WAYSTAR_CLIENT_ID   → 837P submit, 277 status, 835 ERA
#   AVAILITY_ENABLED = !!AVAILITY_CLIENT_ID  → 270/271 eligibility (always); claims only if Waystar unset
#   DEMO_MODE        = !WAYSTAR_ENABLED && !AVAILITY_ENABLED
#   CLAIM_CH         = waystar | availity | demo
# Prefer Waystar for claims when WAYSTAR_CLIENT_ID is set. Availity eligibility is unchanged.
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
AVAILITY_TOKEN_URL=https://api.availity.com/v1/token
AVAILITY_API_BASE_URL=https://api.availity.com
# Use the exact scopes from your portal Client info. Production Coverages typically:
AVAILITY_SCOPE=healthcare-hipaa-transactions
# Billing provider identity (claims fallback when Waystar is not configured)
AVAILITY_NPI=
AVAILITY_ORG_NAME=
AVAILITY_TAX_ID=
# Professional claims (837P) — only used when WAYSTAR_CLIENT_ID is unset
AVAILITY_CLAIMS_URL=
# Claim status (277) — must include {id} placeholder
AVAILITY_CLAIM_STATUS_URL=
# Optional sandbox only — when set, Coverages calls send X-Api-Mock-* headers. Leave unset for live payers.
# AVAILITY_COVERAGES_MOCK_SCENARIO_ID=Coverages-Complete-i

# Local/dev ONLY — never enable in production. When true, POST /api/prp/eligibility returns
# active+prpCovered so enroll + PriorAuth can be proven while Availity is 502. Default: unset/off.
# PRP_ELIGIBILITY_TEST_PASS=true

# Waystar clearinghouse — preferred claims path (837P / 277 / 835) when CLIENT_ID is set
# OAuth2 client_credentials → WAYSTAR_TOKEN_URL; token cached in-process, refresh 60s before expiry
WAYSTAR_CLIENT_ID=
WAYSTAR_CLIENT_SECRET=
WAYSTAR_TOKEN_URL=
# Optional OAuth scope
# WAYSTAR_SCOPE=
WAYSTAR_CLAIMS_URL=
# Claim status (277) — must include {id} placeholder
WAYSTAR_CLAIM_STATUS_URL=
WAYSTAR_SENDER_ID=
WAYSTAR_NPI=
WAYSTAR_ORG_NAME=
WAYSTAR_TAX_ID=
# 835 ERA webhook — REQUIRED. Rejects unauthenticated posts.
# Authorization: Bearer <secret>  OR  X-Altrixs-Webhook-Signature: sha256=<hmac>
ERA_WEBHOOK_SECRET=
# WAYSTAR_WEBHOOK_SECRET=   # alias accepted
# Force demo claims even when credentials exist (local / CI):
# CLINICAL_CLEARINGHOUSE_MODE=demo

# Cron jobs — REQUIRED. GET/POST /api/cron/notifications needs Authorization: Bearer <secret>
# Schedule every 5 min (AWS EventBridge / similar) or dose reminders will not fire.
CRON_SECRET=

# Firebase Cloud Messaging (patient push). Without these, sends are mock-only.
# Prefer full JSON, or the three discrete vars:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# DrFirst SSO signing — only required when DRFIRST_ENABLED=true (live e-prescribe).
# Until then leave blank; in-app patient medications still work via Postgres.
# DRFIRST_SECRET=

# Zoom Server-to-Server OAuth (telehealth host meetings). Required to assign Zoom rooms.
# Marketplace app type: Server-to-Server OAuth. Scopes: meeting:write:admin meeting:write:meeting
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_EMAIL=host@clinic.com

# Google Meet via Calendar API conferenceData (telehealth). Do not invent meet.google.com URLs.
# Option A — OAuth user (Calendar + Meet). Scope: https://www.googleapis.com/auth/calendar.events
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Option B — service account JSON (share the calendar with the SA email, or domain-wide delegation)
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
# GOOGLE_CALENDAR_IMPERSONATE=host@clinic.com

# ─── DrFirst Rcopia External API (v2.54 - Staging & Production) ───
# Register-on-launch: true | non_imported | unset(off). Staging default: non_imported
# so Valant imports never hit DrFirst test.
# DRFIRST_REGISTER_ON_LAUNCH=non_imported
DRFIRST_ENABLED=false
DRFIRST_ENV=mock
DRFIRST_API_VERSION=2.54
DRFIRST_ENGINE_URL=https://engine201.staging.drfirst.com/servlet/rcopia.servlet.EngineServlet
DRFIRST_UPDATE_URL=https://update201.staging.drfirst.com/servlet/rcopia.servlet.EngineServlet
DRFIRST_VENDOR_USERNAME=
DRFIRST_VENDOR_PASSWORD=
DRFIRST_PRACTICE_USERNAME=
DRFIRST_PRACTICE_NAME=
DRFIRST_PRACTICE_REGION=
DRFIRST_PORTAL_SYSTEM_NAME=
DRFIRST_PASSWORD_MODE=plain
DRFIRST_PRACTICE_ELEMENT=PracticeUserName
# Customization portal is a browser login. It is not the SSO launch URL.
DRFIRST_CUSTOMIZATION_PORTAL_URL=https://web.staging.drfirst.com/admin-login
DRFIRST_CUSTOMIZATION_USERNAME=
DRFIRST_CUSTOMIZATION_PASSWORD=
# ─── DrFirst Traditional SSO ───
# Must stay on the Orca external-login path. The settings parser rejects any other SSO URL.
DRFIRST_SSO_URL=https://orca.staging.drfirst.com/orca/auth/extLogin/v10
# JSON maps a local User id, email, or NPI to the DrFirst provider ExternalID.
# Example: {"prescriber@example.com":"provider1_practice"}
DRFIRST_PRESCRIBER_MAP_JSON=
# Optional for DrFirst-created staging patients: maps local Client id, MRN, or email
# to the supplied DrFirst patient ExternalID. Unmapped patients are uploaded first.
DRFIRST_PATIENT_MAP_JSON=
# 32 random bytes encoded as 64 hex characters or base64. Never reuse AUTH_SECRET.
DRFIRST_AUDIT_ENCRYPTION_KEY=
DRFIRST_AUDIT_RETENTION_DAYS=90
# Legacy transport stays off. Do not enable it in deployed environments.
DRFIRST_LEGACY_TRANSPORT_ENABLED=false
DRFIRST_PRACTICE_ID=
DRFIRST_PRACTICE_SECRET=
DRFIRST_SECRET=
DRFIRST_API_BASE_URL=
DRFIRST_PARTNER_ID=
DRFIRST_USERNAME=
DRFIRST_PASSWORD=
DRFIRST_CLIENT_ID=
DRFIRST_CLIENT_SECRET=

# DrFirst First Data Bank / Rcopia Engine API. Keep disabled until DrFirst
# supplies the assigned region and account identifiers. All values are server-only.
DRFIRST_FDB_ENABLED=false
DRFIRST_FDB_URL=https://engine201.staging.drfirst.com/servlet/rcopia.servlet.EngineServlet
DRFIRST_FDB_VENDOR_NAME=
DRFIRST_FDB_VENDOR_PASSWORD=
DRFIRST_FDB_APPLICATION=Altrixs
DRFIRST_FDB_APPLICATION_VERSION=1.0.0
DRFIRST_FDB_PRACTICE_NAME=
DRFIRST_FDB_STATION=
DRFIRST_FDB_PRACTICE_USERNAME=
DRFIRST_FDB_SYSTEM_NAME=
DRFIRST_FDB_API_VERSION=2.54
# Development mock failures: none | patient | prescriber | unavailable
DRFIRST_MOCK_FAILURE=none

# SMART on FHIR thin host + CRISP Embedded Query Portal
# Leave SMART_SIGNING_SECRET blank for DEMO MODE (no live CRISP embedding).
SMART_SIGNING_SECRET=
# Comma-separated OAuth client_ids allowed in LIVE mode
SMART_ALLOWED_CLIENTS=crisp-eqp,crisp-sandbox
# CRISP Embedded Query Portal base URL
CRISP_EQP_URL=https://portal.crisphealth.org/eqp
# Public API origin (no trailing slash). FHIR_ISS = ${API_BASE_URL}/fhir
# Falls back to NEXT_PUBLIC_APP_URL / AUTH_URL when unset.
API_BASE_URL=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Staff MFA / security (Oct 24) ---
# 32-byte key (64 hex chars or base64) - encrypts MFA TOTP secrets at rest. Required to enroll MFA.
PHI_FIELD_ENCRYPTION_KEY=
# MFA_ENFORCE=false
# CSP_REPORT_ONLY=true

# Homebase (HR hours/roster) - READ ONLY. Altrixs never writes to Homebase. Leave unset = "Not connected".
# HOMEBASE_ORGANIZATION_ID is the Altrixs clinic organization id allowed to use this connection.
# Cron: npx tsx scripts/homebase-sync.ts (see header for schedule)
# HOMEBASE_API_KEY=
# HOMEBASE_ORGANIZATION_ID=
# HOMEBASE_API_BASE=https://app.joinhomebase.com/api/public
# HOMEBASE_TIMEOUT_MS=15000

# --- Oct 26: public SEO + BAA + integration logs ---
# ALTRIXS_ENV=production|staging
# NEXT_PUBLIC_SITE_URL=https://altrixs.com
# NEXT_PUBLIC_PRICING_APPROVED=false
# INTEGRATION_LOG_METADATA_RETENTION_DAYS=365
# DRFIRST_LOG_RETENTION_DAYS=90
# AUTH_URL / NEXTAUTH_URL / NEXT_PUBLIC_APP_URL used for DrFirst logout_url base
