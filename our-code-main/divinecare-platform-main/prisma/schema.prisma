  pagedAt             DateTime  @default(now())
  secureEpisodeLink   String?   // Zero-PHI URL: e.g. "/dashboard/crisis?episode=MC-2026-0147"
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@index([episodeId])
  @@index([trigger])
  @@index([pagedAt])
}


/// Residential Treatment Program (ASAM 3.1 & 3.5)
model ResidentialResident {
  id                String    @id @default(cuid())
  clientId          String?
  name              String
  program           String    // "3.1" | "3.5"
  room              String    // e.g. "B-201", "A-101"
  admitDate         DateTime  @default(now())
  counselor         String
  phase             String    @default("Admission")
  txPlanStatus      String    @default("current") // current, due, overdue
  orientationDone   Boolean   @default(false)
  asamScores        Json?     // { dim1, dim2, dim3, dim4, dim5, dim6 }
  overrideReason    String?
  paNumber          String?
  paUnitsRemaining  Int       @default(30)
  lastCsrDate       DateTime?
  nextCsrDate       DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  shiftNotes        ResidentialShiftNote[]

  @@index([program])
  @@index([room])
  @@index([active])
}

/// Residential Shift Documentation (Day, Evening, Overnight)
model ResidentialShiftNote {
  id          String              @id @default(cuid())
  residentId  String
  resident    ResidentialResident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  shift       String              // "Day" | "Evening" | "Overnight"
  author      String
  shiftDate   DateTime            @default(now())
  milieu      String
  adherence   String
  sleep       String?
  notes       String              @db.Text
  createdAt   DateTime            @default(now())

  @@index([residentId])
  @@index([shiftDate])
}

/// Assisted Outpatient Treatment (Maryland Health-General § 10-6A-05)
model AotParticipant {
  id                    String    @id @default(cuid())
  clientId              String?
  name                  String
  age                   Int
  status                String    @default("screening") // referral, screening, petition, hearing, active, renewal, stepdown
  county                String
  referralSource        String
  diagnosis             String
  petitionDate          DateTime?
  hearingDate           DateTime?
  orderStart            DateTime?
  orderEnd              DateTime?
  eligibilityData       Json?
  psychiatristAffidavit Json?
  deadlines             Json      @default("[]")
  teamCadence           Json      @default("[]")
  escalationEvents      Json      @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([county])
}

/// Specialized Residential & Crisis Billing Worklist
model SpecializedBillingCharge {
  id                String    @id @default(cuid())
  category          String    // "residential_per_diem" | "mobile_crisis"
  referenceId       String    // residentId or episodeNumber
  clientName        String
  serviceDate       DateTime
  code              String    // "H0018", "H0019", "H2011", "90839"
  units             Int       @default(1)
  rate              Float
  totalAmount       Float
  pos               String    @default("55")
  payer             String
  status            String    @default("ready") // in_progress, held, ready, routed, approved
  blockReason       String?   // "csr_overdue", "pa_missing", "pa_exhausted"
  organizationId    String?
  claimId           String?
  createdAt         DateTime  @default(now())

  @@index([category])
  @@index([status])
  @@index([organizationId, status])
}

// ─── SUD Screeners & Prescriber Referral Alerts (42 CFR Part 2) ───────────
enum SudToolType {
  AUDIT
  CAGE_AID
  NIDA
  BAM
}

enum SudRiskLevel {
  NEGATIVE
  POSITIVE
  HIGH_RISK
}

model SudScreening {
  id               String       @id @default(cuid())
  organizationId   String
  clientId         String
  prescriberId     String?      // NP or Psychiatrist
  administeredById String       // Clinician who gave the screener
  tool             SudToolType
  answers          Json         // Raw responses array / object
  totalScore       String       // e.g. "19 / 40", "2 / 4", "Drug use endorsed"
  riskLevel        SudRiskLevel
  triggerRationale String       @db.Text
  alertRouted      Boolean      @default(false)
  alertRoutedAt    DateTime?
  signed           Boolean      @default(false)
  signedAt         DateTime?
  signedById       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  alerts           RiskAlert[]

  @@index([organizationId, clientId])
  @@index([prescriberId])
}

// ─── Amazon Connect Operational Calls (No PHI / Patient Linkage) ──────────
enum OperationalCallTarget {
  AGENT
  QUEUE
  EXTERNAL
}

model OperationalCallLog {
  id               String                @id @default(cuid())
  organizationId   String?
  callerUserId     String
  callType         OperationalCallTarget @default(EXTERNAL)
  calleeName       String
  destinationPhone String
  purpose          String?
  contactId        String?
  durationSeconds  Int                   @default(0)
  status           String                @default("INITIATED") // INITIATED, CONNECTED, ENDED
  createdAt        DateTime              @default(now())

  @@index([organizationId, callerUserId])
  @@index([createdAt])
}

// ─── Claim Service Lines (Multiple CPT per Claim) ─────────────────────────
model ClaimServiceLine {
  id          String   @id @default(cuid())
  claimId     String
  cptCode     String
  modifier    String?
  units       Int      @default(1)
  unitCharge  Float
  totalCharge Float

  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// ─── Payment Batches & Bank Reconciliation ────────────────────────────────
model PaymentBatch {
  id             String             @id @default(cuid())
  organizationId String
  batchNumber    String             @unique // "BATCH-100341"
  payerSource    String             // Payer or Self-Pay
  checkEftNumber String
  paymentDate    DateTime
  totalAmount    Float
  reconciled     Boolean            @default(false)
  postedById     String
  createdAt      DateTime           @default(now())

  lines          PaymentBatchLine[]

  @@index([organizationId, reconciled])
}

model PaymentBatchLine {
  id             String       @id @default(cuid())
  batchId        String
  clientId       String
  claimId        String?
  dos            DateTime
  paidAmount     Float
  adjustment     Float        @default(0) // CO-45 contractual adjustment
  patientBalance Float        @default(0)

  batch          PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([clientId])
}

// ─── AutoPay & Gateway Tokenization ───────────────────────────────────────
model CardOnFile {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String          @unique
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gatewayToken   String          // Tokenized by Stripe / Gateway (PCI SAQ-A)
  cardBrand      String          // Visa, Mastercard, Amex, Discover
  last4          String
  expiry         String          // MM/YY
  billingZip     String
  autopayEnabled Boolean         @default(true)
  gatewayCustomerId String?
  gatewayPaymentMethodId String?
  chargeTiming   String?         @default("immediate")
  validatedAt    DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  charges        AutoPayCharge[]

  @@index([organizationId, autopayEnabled])
}

model AutoPayCharge {
  id            String     @id @default(cuid())
  cardOnFileId  String
  amount        Float
  status        String     // "succeeded" | "failed" | "pending"
  failureReason String?
  chargedAt     DateTime   @default(now())

  card          CardOnFile @relation(fields: [cardOnFileId], references: [id], onDelete: Cascade)

  @@index([cardOnFileId, status])
}

// ─── eStatements & Tracked Payment Links ──────────────────────────────────
model EStatement {
  id             String    @id @default(cuid()) // Unique statement code e.g. "STM-99214"
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodFrom     DateTime
  periodTo       DateTime
  totalBilled    Float
  balanceDue     Float
  deliveryMethod String    @default("email")
  emailSentTo    String
  phoneSentTo    String?
  trackedPayLink String    // "altrixs.com/pay/{id}"
  status         String    @default("sent") // "sent" | "viewed" | "paid" | "overdue"
  paidAt         DateTime?
  paymentPlans   PaymentPlan[]
  createdAt      DateTime  @default(now())

  @@index([organizationId, clientId])
  @@index([status])
}

// ─── Payer Enrollment Credentialing Intake ────────────────────────────────
model ProviderPayerEnrollment {
  id             String    @id @default(cuid())
  providerUserId String
  payerName      String    // Optum MD, CareFirst, Medicare, Aetna, UHC, Cigna
  status         String    // "active" | "in_process" | "submitted" | "not_started"
  effectiveDate  DateTime?
  portalNotes    String?
  checklist      Json      // Array of { documentName: string, completed: boolean }
  updatedAt      DateTime  @updatedAt

  @@unique([providerUserId, payerName])
}

// ─── SUD Radar Signals (AI Scanner) ──────────────────────────────────────────
model SudRadarSignal {
  id                String   @id @default(cuid())
  organizationId    String?
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  detectionSource   String   // "diagnosis" | "note-keyword"
  detectedCondition String   // e.g. "Alcohol Use Disorder, Severe (F10.20)"
  quotedEvidence    String   @db.Text
  confidencePercent Int      // e.g. 98, 84
  recommendation    String   @db.Text
  actionLabel       String   // e.g. "Start ASAM Admission", "Administer AUDIT"
  actionHref        String   // e.g. "/dashboard/residential", "/dashboard/sdoh"
  scannedAt         DateTime @default(now())

  @@index([clientId])
  @@index([detectionSource])
}

