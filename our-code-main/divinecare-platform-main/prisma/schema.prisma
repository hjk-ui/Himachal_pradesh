  PROVISIONAL
  RULED_OUT
  RESOLVED
  ENTERED_IN_ERROR
}

/// Oct 24 diagnosis list. Rows are never deleted (DELETE → 405). Code is immutable after add.
/// DB also enforces (partial unique index in migration): at most one isPrimary among ACTIVE|PROVISIONAL per client.
model ClientDiagnosis {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code           String
  description    String
  dsm5Name       String?
  status         ClientDiagnosisStatus @default(ACTIVE)
  isPrimary      Boolean               @default(false)
  rank           Int                   @default(0)
  onsetDate      DateTime?
  resolvedDate   DateTime?
  needsCoding    Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdById    String?

  @@index([organizationId, clientId, status])
  @@index([clientId, rank])
}

