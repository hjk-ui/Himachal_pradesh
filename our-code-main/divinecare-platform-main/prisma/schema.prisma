generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PRACTICE_DIRECTOR
  DIRECTOR
  OFFICE_MANAGER
  THERAPIST
  PSYCHIATRIST
  NP
  PRP_SPECIALIST
  CASE_MANAGER
  PEER_SUPPORT
  CLINICIAN
  FRONT_DESK
  BILLING
  HR
  PHYSICIAN
  MEDICAL_NP
  MEDICAL_ASSISTANT
  CRISIS_RESPONDER
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum OtpPurpose {
  LOGIN
  RESET_PASSWORD
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_SESSION
  COMPLETED
  CANCELLED
  NO_SHOW
  LATE_CANCEL
}

enum AppointmentNoteStatus {
  NOT_STARTED
  AI_DRAFT
  IN_PROGRESS
  SIGNED
}

enum ProgressNoteWorkflowStatus {
  DRAFT
  SIGNED
  LOCKED
}

enum WaitlistStatus {
  WAITING
  MATCHED
  SCHEDULED
  CLOSED
}

enum WaitlistUrgency {
  ROUTINE
  URGENT
  CRISIS
}

enum IntakeInviteStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum ConsentFormStatus {
  PENDING
  SIGNED
  EXPIRED
  DECLINED
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  NEEDS_REVIEW
  EXPIRED
  CLOSED
}

enum EligibilityCheckStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  ERROR
}

enum PriorAuthStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DENIED
  EXPIRED
}

enum ClaimStatus {
  DRAFT
  READY
  SUBMITTED
  ACCEPTED
  DENIED
  PAID
}

enum ClaimDenialStatus {
  OPEN
  APPEALED
  WON
  LOST
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHECK
  INSURANCE
  STUB
}

enum StaffCredentialType {
  LICENSE
  CEU
  MALPRACTICE
  DEA
  CERTIFICATION
  BACKGROUND_CHECK
  SUPERVISION
}

enum StaffCredentialStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PENDING_RENEWAL
}

enum MessageSender {
  STAFF
  CLIENT
}

enum MessageThreadTopic {
  SCHEDULING
  BILLING
  GENERAL
  CLINICAL
  RX_REFILL
}

enum MessageThreadStatus {
  WAITING
  IN_PROGRESS
  FORWARDED
  RESOLVED
}

enum ThreadMessageSender {
  FRONT_OFFICE
  PATIENT
  CLINICIAN_NOTE
}

enum TelehealthSessionStatus {
  UPCOMING
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TelehealthPlatform {
  ZOOM
  DOXY
  GOOGLE
  TEAMS
  PHONE
  CHIME
}

/// Practice / clinic group (tenant root for multi-location)
model Organization {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  active    Boolean    @default(true)
  /// Next sequence value for clinic MRN generation (atomic increment on assign)
  mrnNextSequence Int  @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
  users     User[]
  clients   Client[]
  waitlistEntries WaitlistEntry[]
  intakeInvites   IntakeInvite[]
  consentForms    ConsentForm[]
  moduleStates    ClinicModuleState[]
  clientDiagnoses ClientDiagnosis[]
  clientDiagnosisEvents ClientDiagnosisEvent[]
  homebaseSyncRuns HomebaseSyncRun[]
  homebaseEmployeeLinks HomebaseEmployeeLink[]
  treatmentPlans  TreatmentPlan[]
  eligibilityChecks EligibilityCheck[]
  priorAuths      PriorAuth[]
  claims          Claim[]
  claimDenials    ClaimDenial[]
  payments        Payment[]
  autopayEnrollments AutopayEnrollment[]
  staffCredentials StaffCredential[]
  staffHrProfiles  StaffHrProfile[]
  hrPayrollRuns    HrPayrollRun[]
  hrBenefitPlans   HrBenefitPlan[]
  hrLeaveRequests  HrLeaveRequest[]
  hrPtoBalances    HrPtoBalance[]
  hrJobRequisitions HrJobRequisition[]
  hrComplianceItems HrComplianceItem[]
  hrCeuProgress    HrCeuProgress[]
  hrOrgSnapshot    HrOrgSnapshot?
  hrDirectDeposit  HrDirectDepositSetting?
  hrHeadcountPoints HrHeadcountPoint[]
  hrTurnoverPoints HrTurnoverPoint[]
  hrDeptCompRows   HrDeptCompensation[]
  supervisionLogs  SupervisionLog[]
  supervisionTracks SupervisionTrack[]
  riskAlerts      RiskAlert[]
  appointments    Appointment[]
  messageThreads  MessageThread[]
  telehealthSessions TelehealthSession[]
  telehealthSettings TelehealthSettings?
  communityEvents     CommunityEvent[]
  communityPartners   CommunityPartner[]
  communityVolunteers CommunityVolunteer[]
  communityReferrals  CommunityReferral[]
  prMetrics           PrOrgMetrics?
  prChannels          PrSocialChannel[]
  prBrandAssets       PrBrandAsset[]
  prBrandColors       PrBrandColor[]
  prCoverage          PrMediaCoverage[]
  prReleases          PrPressRelease[]
  prCampaigns         PrCampaign[]
  clinicalAssessments ClinicalAssessmentRecord[]
  clinicalEvaluations ClinicalEvaluationRecord[]
  locusAssessments    LocusAssessmentRecord[]
  mandatoryReports    MandatoryReportRecord[]
  mbcAlertAcks        MbcAlertAck[]
  prPosts             PrSocialPost[]
  migrationJobs       MigrationJob[]
  tmsCourses          TmsCourse[]
  spravatoEnrollments SpravatoEnrollment[]
  prpReferrals        PrpReferral[]
  prpEnrollments      PrpEnrollment[]
  sensitiveRecords    SensitiveRecord[]
  sensitiveAccessLogs SensitiveAccessLog[]
  breakTheGlassGrants BreakTheGlassGrant[]
  schedulingSettings  SchedulingSettings?
  labOrders           LabOrder[]
  patientStatements   PatientStatement[]
  claimScrubResults   ClaimScrubResult[]
  connectMessages     ConnectMessage[]
  connectCalls        ConnectCall[]
  scribeSessions      ScribeSession[]
  healthLakeJobs      HealthLakeJob[]
  textractJobs        TextractJob[]
  clinicalEvents      ClinicalEvent[]
  personalizeCaches   PersonalizeInsightCache[]
  medicalPatients     MedicalPatient[]
  medicalCharges      MedicalCharge[]
  payerRegistries     PayerRegistry[]
  patientLedgerEntries PatientLedgerEntry[]
  clientCopayRules    ClientCopayRule[]
  valantInsuranceAging ValantInsuranceAgingSnapshot[]
  valantAgingSnapshots ValantAgingSnapshot[]
  valantCombinedAging ValantCombinedAgingRow[]
  valantAgingSettings ValantAgingSettings?
  valantTransactions  ValantTransaction[]
  valantProviderMaps  ValantProviderMap[]
  valantPayers        ValantPayer[]
  intensiveChargeDrafts IntensiveChargeDraft[]
  visitChecklistItems VisitChecklistItem[]
  clientChartDigests  ClientChartDigest[]
  medicalRoomings     MedicalRooming[]
  medicalCareGaps     MedicalCareGap[]
  medicalReferrals    MedicalReferral[]
  medicalMaTasks      MedicalMaTask[]
  closeLoopNotifies   CloseLoopNotification[]
  autopaySweepAttempts AutopaySweepAttempt[]
  measureAssignments   MeasureAssignment[]
  measureRequests      MeasureRequest[]
  billingRules        BillingRule[]
  projectTasks        ProjectTask[]
  teamAlerts          TeamAlert[]
  baaAcceptances      BaaAcceptance[]
  integrationCallLogs IntegrationCallLog[]
}

/// Physical or virtual site under an organization
model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  phone          String?
  timezone       String       @default("America/New_York")
  active         Boolean      @default(true)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  staffMemberships UserLocation[]
  primaryStaff     User[]         @relation("UserPrimaryLocation")
  clients          Client[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// Staff assigned to one or more locations
model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  passwordHash     String?
  /// Clinician callback / Amazon Connect bridge number (E.164)
  phone            String?
  /// Primary / default role (also used as login active role)
  role             Role       @default(CLINICIAN)
  /// Extra roles this user may switch into (always includes `role` after normalize)
  roles            Role[]     @default([])
  status           UserStatus @default(ACTIVE)
  image            String?
  /// Tenant org — null only for SUPER_ADMIN (platform-wide)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// National Provider Identifier (10 digits when set)
  npi              String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  /// SHA-256 of raw invite token (only while status = INVITED)
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  invitedById      String?
  invitedBy        User?      @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitesSent      User[]     @relation("UserInvites")
  primaryLocationId String?
  primaryLocation   Location? @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  locations         UserLocation[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  /// Staff MFA (Oct 24) — TOTP secret is AES-256-GCM encrypted (PHI_FIELD_ENCRYPTION_KEY)
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String?
  /// SHA-256 hashes of single-use recovery codes
  mfaRecoveryHashes String[]  @default([])
  mfaFailedAttempts Int       @default(0)
  mfaLockedUntil    DateTime?
  mfaTrustedDevices MfaTrustedDevice[]

  clientsAssigned Client[]      @relation("ClientAssignee")
  appointments    Appointment[] @relation("AppointmentClinician")
  progressNotes   ProgressNote[] @relation("ProgressNoteClinician")
  waitlistMatches WaitlistEntry[] @relation("WaitlistClinician")
  intakeInvitesCreated IntakeInvite[] @relation("IntakeInviteCreator")
  intakeInvitesAssigned IntakeInvite[] @relation("IntakeInviteAssignee")
  treatmentPlans   TreatmentPlan[] @relation("TreatmentPlanClinician")
  eligibilityChecks EligibilityCheck[] @relation("EligibilityCheckedBy")
  priorAuthsCreated PriorAuth[] @relation("PriorAuthCreatedBy")
  staffCredentials StaffCredential[]
  staffHrProfile   StaffHrProfile?
  hrLeaveRequests  HrLeaveRequest[]
  hrPtoBalance     HrPtoBalance?
  hrCeuProgress    HrCeuProgress?
  supervisionAsSupervisor SupervisionLog[] @relation("SupervisionSupervisor")
  supervisionAsSupervisee SupervisionLog[] @relation("SupervisionSupervisee")
  supervisionTracksAsSupervisor SupervisionTrack[] @relation("SupervisionTrackSupervisor")
  supervisionTracksAsSupervisee SupervisionTrack[] @relation("SupervisionTrackSupervisee")
  riskAlertsClinician RiskAlert[] @relation("RiskAlertClinician")
  riskAlertsReviewed  RiskAlert[] @relation("RiskAlertReviewedBy")
  prescribedMedications ClientMedication[] @relation("ClientMedicationPrescriber")
  recordedVitals       MedicalVital[]     @relation("MedicalVitalRecorder")
  conductedVisits      MedicalVisit[]     @relation("MedicalVisitProvider")
  targetedTeamAlerts   TeamAlert[]        @relation("TeamAlertTarget")
  authoredTeamAlerts   TeamAlert[]        @relation("TeamAlertAuthor")
  resolvedTeamAlerts   TeamAlert[]        @relation("TeamAlertResolver")

  @@index([status])
  @@index([inviteTokenHash])
  @@index([primaryLocationId])
  @@index([organizationId])
}

/// "Remember this device for 30 days" — only the SHA-256 of the cookie token is stored
model MfaTrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
}

/// Clinical client (patient) record used by the staff portal
model Client {
  id            String       @id @default(cuid())
  name          String
  email         String?      @unique
  phone         String?
  image         String?
  /// @deprecated prefer status — kept in sync for older queries
  active        Boolean      @default(true)
  status        ClientStatus @default(ACTIVE)
  riskLevel     RiskLevel    @default(LOW)
  checkInStreak Int          @default(0)

  /// Tenant — set on create; used for org-scoped MRN uniqueness
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Medical Record Number — unique per organization (e.g. ALT-CLIN-2026-000142)
  mrn            String?

  /// EHR migration provenance
  sourcePlatform String?
  sourceId       String?
  importedAt     DateTime?

  /// Demographics (intake)
  dateOfBirth           DateTime?
  gender                String?
  /// Name prefix / title (Mr, Ms, Mx, Dr…) — feeds the Identifying Information "Title" field
  namePrefix            String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?

  /// Patient SMS TCPA gate (Oct 21 staging)
  smsConsent       Boolean   @default(false)
  smsConsentAt     DateTime?
  smsConsentSource String?
  smsOptOutAt      DateTime?

  /// Insurance (intake)
  insurancePayer        String?
  insuranceMemberId     String?
  insuranceGroupNumber  String?

  /// Multi-disciplinary treatment team (warm handoff slots) — JSON TreatmentTeam shape
  treatmentTeam         Json?
  /// Last CRISP / HIE SMART launch timestamp
  hieLastQueryAt        DateTime?

  /// Diagnosis (intake) — primary ICD-10 / DSM
  primaryDiagnosis      String?
  primaryDiagnosisCode  String?
  secondaryDiagnoses    String?

  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?     @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedSince DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checkIns     CheckIn[]
  appointments Appointment[]
  progressNotes ProgressNote[]
  alerts       RiskAlert[]
  messages     Message[]
  messageThreads MessageThread[]
  telehealthSessions TelehealthSession[]
  waitlistConversions WaitlistEntry[] @relation("WaitlistConvertedClient")
  intakeInvites       IntakeInvite[]
  consentForms        ConsentForm[]
  diagnoses           ClientDiagnosis[]
  diagnosisEvents     ClientDiagnosisEvent[]
  treatmentPlans      TreatmentPlan[]
  eligibilityChecks   EligibilityCheck[]
  priorAuths          PriorAuth[]
  claims              Claim[]
  payments            Payment[]
  autopayEnrollment   AutopayEnrollment?
  patientAccount      PatientAccount?
  clinicalAssessments ClinicalAssessmentRecord[]
  clinicalEvaluations ClinicalEvaluationRecord[]
  locusAssessments    LocusAssessmentRecord[]
  mandatoryReports    MandatoryReportRecord[]
  mbcAlertAcks        MbcAlertAck[]
  deviceTokens        DeviceToken[]
  medicationSchedules MedicationSchedule[]
  medicationIntakeLogs MedicationIntakeLog[]
  notificationLogs    NotificationLog[]
  patientNotifications PatientNotification[]
  tmsCourses          TmsCourse[]
  spravatoEnrollments SpravatoEnrollment[]
  prpReferrals        PrpReferral[]
  prpEnrollments      PrpEnrollment[]
  sensitiveRecord     SensitiveRecord?
  sensitiveAccessLogs SensitiveAccessLog[]
  breakTheGlassGrants BreakTheGlassGrant[]
  labOrders           LabOrder[]
  patientStatements   PatientStatement[]
  connectMessages     ConnectMessage[]
  connectCalls        ConnectCall[]
  scribeSessions      ScribeSession[]
  medications         ClientMedication[]
  medicalProblems     MedicalProblem[]
  medicalVitals       MedicalVital[]
  medicalVisits       MedicalVisit[]
  medicalCharges      MedicalCharge[]
  teamAlerts          TeamAlert[]
  treatmentTeamMembers ClientTreatmentTeamMember[]
  medicalAllergies    MedicalAllergy[]
  sudScreenings       SudScreening[]
  cardOnFile          CardOnFile?
  statements          EStatement[]
  radarSignals        SudRadarSignal[]
  legalFirstName      String?
  middleInitial       String?
  legalLastName       String?
  rcopiaPatientId     String?
  officeNotes                ClientOfficeNote[]
  prpWorkflows               PrpWorkflow[]
  documentIntakes            DocumentIntake[]
  paymentPlans               PaymentPlan[]
  rcopiaPrescriptions        RcopiaPrescription[]
  rcopiaRxfillEvents         RcopiaRxfillEvent[]
  rcopiaRxchangeRequests     RcopiaRxchangeRequest[]
  rcopiaRefillNotifications  RcopiaRefillNotification[]
  marylandPdmpAudits         MarylandPdmpAudit[]
  rcopiaMedRecAttestations   RcopiaMedRecAttestation[]
  ehrPrescriptions           EhrPrescription[]
  ehrRefillRequests          EhrRefillRequest[]
  patientLedgerEntries       PatientLedgerEntry[]
  copayRules                 ClientCopayRule[]
  intensiveChargeDrafts      IntensiveChargeDraft[]
  visitChecklistItems        VisitChecklistItem[]
  chartDigests               ClientChartDigest[]
  medicalRoomings            MedicalRooming[]
  medicalCareGaps            MedicalCareGap[]
  medicalReferrals           MedicalReferral[]
  medicalMaTasks             MedicalMaTask[]
  closeLoopNotifies          CloseLoopNotification[]
  measureAssignments         MeasureAssignment[]
  measureRequests            MeasureRequest[]
  valantAgingSnapshots       ValantAgingSnapshot[]
  valantCombinedAging        ValantCombinedAgingRow[]
  valantTransactions         ValantTransaction[]


  @@unique([organizationId, mrn])
  @@unique([organizationId, sourcePlatform, sourceId])
  @@index([organizationId])
  @@index([mrn])
  @@index([active])
  @@index([status])
  @@index([assignedToId])
  @@index([riskLevel])
  @@index([locationId])
  @@index([sourcePlatform, sourceId])
}

enum PatientAccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Patient (client) login for the mobile app — never a staff User / dashboard session
model PatientAccount {
  id               String               @id @default(cuid())
  clientId         String               @unique
  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email            String               @unique
  passwordHash     String?
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  status           PatientAccountStatus @default(INVITED)
  /// Guardian / proxy relationship when account is not the patient themself
  relationship     String?
  /// Computed access tier: full | limited | aged_out
  accessTier       String?
  /// True when this account is a guardian/proxy (not the patient)
  isProxy          Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([inviteTokenHash])
  @@index([status])
}

/// Patient app audit — no PHI / message text
model PatientAuditLog {
  id         String   @id @default(cuid())
  clientId   String
  accountId  String?
  action     String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([action])
}

model CheckIn {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mood      Int
  stress    Int
  sleep     Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Appointment {
  id           String                @id @default(cuid())
  clientId     String
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Denormalized for board display / seed snapshots
  clientName   String?
  clinicianId  String?
  clinician    User?                 @relation("AppointmentClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  clinicianName String?
  organizationId String?
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type         String
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus     @default(SCHEDULED)
  noteStatus   AppointmentNoteStatus @default(NOT_STARTED)
  isVirtual    Boolean               @default(false)
  notes        String?
  patientBooked Boolean              @default(false)
  /// staff | group | online | portal | import
  createdVia   String?
  createdById  String?
  createdByName String?
  lastChangedById String?
  lastChangedByName String?
  lastChangedAt DateTime?
  /// Public self-schedule confirmation e.g. AC-123456
  confirmationCode String?           @unique
  insurancePayer String?
  memberId     String?
  /// zoom | meet | phone | doxy when booked as telehealth
  telehealthPlatform String?
  joinUrl      String?
  rescheduleRequestedAt DateTime?
  rescheduleNote String?
  /// valant_history = imported past visit (never a live schedule slot; excluded from tasks / missing-note)
  source       String?
  /// Stable import key, unique per organization (re-runs of the Valant history import skip duplicates)
  externalKey  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  claims       Claim[]
  visitChecklistItems VisitChecklistItem[]
  medicalRooming      MedicalRooming?

  @@index([startsAt])
  @@index([clientId])
  @@index([clinicianId])
  @@index([clinicianId, startsAt])
  @@index([status])
  @@index([organizationId, startsAt])
  @@index([noteStatus])
  @@index([confirmationCode])
  @@index([organizationId, source])
  @@unique([organizationId, externalKey])
}

model ProgressNote {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clinicianId String?
  clinician   User?    @relation("ProgressNoteClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  body        String
  /// Soft-dismiss (unsigned only) — never hard-delete
  dismissedAt      DateTime?
  dismissedById    String?
  dismissedByName  String?
  dismissReason    String?
  /// Oct 24 scribe safety — AI provenance (model, prompt hash, edits) when drafted by AI scribe
  aiProvenance     Json?
  /// Transcript risk gate (TRANSCRIPT_RISK): clinician attestation that flagged content was reviewed
  transcriptRiskFlagged Boolean  @default(false)
  riskAttestation       String?
  riskAttestedAt        DateTime?
  riskAttestedById      String?
  /// Oct 25 scribe field feedback: capture gaps [{ startedAt, endedAt, reason }]; null = no gaps recorded
  recordingGaps         Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow    ProgressNoteWorkflow?
  claims      Claim[]

  @@index([clientId, createdAt])
  @@index([clinicianId])
  @@index([dismissedAt])
}

model ProgressNoteWorkflow {
  noteId              String                     @id
  note                ProgressNote               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  status              ProgressNoteWorkflowStatus @default(DRAFT)
  signedAt            DateTime?
  lockedAt            DateTime?
  clientId            String
  clientName          String
  clientImage         String?
  clinicianId         String?
  clinicianName       String?
  clinicianImage      String?
  body                String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([status, lockedAt])
  @@index([clientId, lockedAt])
  @@index([clinicianId, lockedAt])
}

model RiskAlert {
  id             String    @id @default(cuid())
  /// Denormalized display name (screenshot / seed); client.name is source of truth when linked
  clientName     String?
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clinicianId    String?
  clinician      User?     @relation("RiskAlertClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// crisis_keywords | low_mood | high_stress
  type           String
  severity       RiskLevel
  description    String?
  mood           Int?
  stress         Int?
  /// check_in | journal | assessment
  source         String    @default("check_in")
  sourceId       String?
  reviewed       Boolean   @default(false)
  reviewedById   String?
  reviewedBy     User?     @relation("RiskAlertReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote     String?
  reviewedAt     DateTime?
  screeningId    String?
  screening      SudScreening? @relation(fields: [screeningId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([reviewed, createdAt])
  @@index([severity, reviewed])
  @@index([clientId])
  @@index([organizationId])
}

model Message {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sender    MessageSender
  content   String
