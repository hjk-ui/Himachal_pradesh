  action         String
  code           String?
  fromStatus     String?
  toStatus       String?
  detail         Json?
  actorId        String?
  actorName      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, clientId, createdAt])
  @@index([diagnosisId])
}

