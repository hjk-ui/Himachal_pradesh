/// Oct 25 chart history digest — AI-generated from chart documents; citations only, never invented facts.
/// One row per (organization, client, kind). The UI always shows the disclaimer.
model ClientChartDigest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// bh | medical
  kind           String       @default("bh")
  content        Json
  /// ready | failed
  status         String       @default("ready")
  generatedAt    DateTime     @default(now())
  generatedById  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, clientId, kind])
  @@index([organizationId, clientId])
}

/// Primary-care MA rooming (draft → ready → in_room) — one row per appointment
model MedicalRooming {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId        String       @unique
  appointment          Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status               String       @default("draft") // draft | ready | in_room
  identityConfirmed    Boolean      @default(false)
  chiefComplaint       String       @default("")
  vitals               Json
  allergyReviewed      Boolean      @default(false)
  medicationReviewed   Boolean      @default(false)
  patientReportedMeds  String       @default("")
  pharmacyReview       String? // unchanged | changed
  screenings           Json
  careGapActions       Json
  pocOrderIds          Json
  readyAt              DateTime?
  inRoomAt             DateTime?
  updatedById          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

/// Preventive / chronic care gap row (catalog-driven; dates never invented)
model MedicalCareGap {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gapId            String
  label            String
  category         String
  status           String       @default("due") // due | overdue | met | not_applicable
  lastDoneAt       DateTime?
  providerAction   String?
  maAction         String?
  note             String       @default("")
  updatedAt        DateTime     @updatedAt
  createdAt        DateTime     @default(now())

  @@unique([organizationId, clientId, gapId])
  @@index([organizationId, clientId])
}

/// External / internal BH referral with status chain
model MedicalReferral {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId               String
  client                 Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName             String
  specialty              String
  reason                 String
  status                 String       @default("sent") // sent | scheduled | seen | report_received | cancelled
  internalBhWarmHandoff  Boolean      @default(false)
  expectedReportDays     Int          @default(30)
  expectedReportBy       DateTime?
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

/// Provider → MA task queue
model MedicalMaTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName     String
  title          String
  note           String       @default("")
  status         String       @default("open") // open | in_progress | done | cancelled
  assignedToRole String       @default("MEDICAL_ASSISTANT")
  appointmentId  String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, clientId])
}

/// In-basket close-the-loop patient notification
model CloseLoopNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  method         String // Phone | Portal message | Letter | In person
  notifiedAt     DateTime
  /// YYYY-MM-DD — idempotency key part (one notify per item/method/day)
  notifiedDay    String
  actorUserId    String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, itemId, method, notifiedDay])
  @@index([organizationId, itemId])
}

/// Idempotent patient autopay sweep attempts (enrollmentId + periodKey)
model AutopaySweepAttempt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollmentId   String
  clientId       String
  periodKey      String
  amountCents    Int
  status         String // draft | attempted | succeeded | failed | skipped
  mode           String
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([enrollmentId, periodKey])
  @@index([organizationId, periodKey])
}

/// Measures to patients (Oct 24) — standing orders for self-report instruments
model MeasureAssignment {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Assessment catalog id (e.g. phq-9)
  instrumentKey      String
  /// once | every_visit | weekly | biweekly | monthly — set explicitly by staff, never defaulted
  frequency          String
  /// active | paused | completed
  status             String       @default("active")
  nextDueAt          DateTime?
  /// True when the instrument has no licensed digital item content yet
  itemContentPending Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  requests           MeasureRequest[]

  @@index([organizationId, clientId])
  @@index([organizationId, status, nextDueAt])
}

/// One patient-facing questionnaire link. The raw token is never stored — sha256 hash only.
model MeasureRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     MeasureAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  instrumentKey  String
  /// email | sms | portal | in_session
  channel        String
  tokenHash      String       @unique
  /// pending | in_progress | completed | expired | locked
  status         String       @default("pending")
  dobAttempts    Int          @default(0)
  answers        Json?
  completedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, status])
  @@index([assignmentId])
}

/// Append-only BAA clickwrap acceptance (Oct 26)
model BaaAcceptance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        String
  textSha256     String
  signerName     String
  signerTitle    String
  signerEmail    String
  acceptedById   String?
  acceptedAt     DateTime     @default(now())
  via            String       @default("registration")
  ip             String?
  userAgent      String?

  @@index([organizationId, acceptedAt])
  @@index([organizationId, version])
}

/// Org-scoped vendor/job call metadata (Oct 26) � never throws from writers
model IntegrationCallLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    String
  operation      String
  status         String
  httpStatus     Int?
  durationMs     Int?
  userId         String?
  clientId       String?
  mrnMasked      String?
  error          String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, integration, createdAt])
  @@index([organizationId, status, createdAt])
}
